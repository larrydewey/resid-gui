// soak_counter.resid — the whole loop under a long stream of input, for
// its memory.
//
// The counter runs as a real program (`gui_run_on` over the Wayland
// backend, in a spawned region) against a compositor on the main thread
// that answers what a compositor must (globals, configure, buffers, frame
// callbacks, releases) and otherwise sends input: batches of pointer
// moves, each ending in a click on the button, so every batch is at least
// one turn of the loop and one frame. Then it asks the window to close.
//
// It prints the process's resident set at checkpoints and its peak, so
// two runs of different lengths show whether memory grows with turns:
//
//   residc bench/soak_counter.resid -o soak && ./soak 20000 && ./soak 200000
//
// (no display server, D-Bus or screen reader needed; set
// AT_SPI_BUS_ADDRESS and DBUS_SESSION_BUS_ADDRESS empty so the loop does
// not join a real accessibility bus).

import "../src/app.resid";
import "../src/gfx/color.resid";
import "../src/gfx/font.resid";
import "../src/ui/state.resid";
import "../src/ui/semantics.resid";
import "../src/wayland/wire.resid";
import "../src/wayland/wayland.resid";
import "../src/gui.resid";

Int counter_init() { return 0; }

Int counter_update(Int m, Event e) {
    return match (e) { AppMsg(msg) => match (msg) { Clicked => m + 1, _ => m }, _ => m };
}

Widget counter_view(Int m) { return Column([Text(f"count: {m}"), Button("+1", Clicked)]); }

App(Int) = { .init = counter_init, .update = counter_update, .view = counter_view };

/// The compositor's objects and counts.
type Comp = {
    Int registry; Int compositor; Int shm; Int wm_base; Int seat; Int surface; Int xdg_surface; Int toplevel;
    Int pointer; Int keyboard; Int buffer; Int commits; Int frames; Int sent; Bool streaming; Bool closed;
};

Comp comp_new() {
    return Comp { .registry = 0, .compositor = 0, .shm = 0, .wm_base = 0, .seat = 0, .surface = 0, .xdg_surface = 0, .toplevel = 0,
                  .pointer = 0, .keyboard = 0, .buffer = 0, .commits = 0, .frames = 0, .sent = 0, .streaming = false, .closed = false };
}

Comp set(Comp c, Str f, Int v) {
    return Comp {
        .registry = if (f == "registry") { v } else { c.registry }, .compositor = if (f == "compositor") { v } else { c.compositor },
        .shm = if (f == "shm") { v } else { c.shm }, .wm_base = if (f == "wm_base") { v } else { c.wm_base },
        .seat = if (f == "seat") { v } else { c.seat }, .surface = if (f == "surface") { v } else { c.surface },
        .xdg_surface = if (f == "xdg_surface") { v } else { c.xdg_surface }, .toplevel = if (f == "toplevel") { v } else { c.toplevel },
        .pointer = if (f == "pointer") { v } else { c.pointer }, .keyboard = if (f == "keyboard") { v } else { c.keyboard },
        .buffer = if (f == "buffer") { v } else { c.buffer }, .commits = if (f == "commits") { v } else { c.commits },
        .frames = if (f == "frames") { v } else { c.frames }, .sent = if (f == "sent") { v } else { c.sent },
        .streaming = if (f == "streaming") { v != 0 } else { c.streaming }, .closed = if (f == "closed") { v != 0 } else { c.closed }
    };
}

List(Int) global(Int reg, Int name, Str iface, Int version) {
    return wl_msg(reg, 0, wl_words([name]).concat(wl_string(utf8_bytes(iface))).concat(wl_words([version])));
}

@requires(display)
Bool out(Int fd, List(List(Int)) ms, Int i) {
    if (i >= ms.len()) { return true; }
    return resid_disp_send(fd, ms[i], -1) && out(fd, ms, i + 1);
}

/// Answer one request.
@requires(display)
Comp request(Int fd, Comp c, Int obj, Int op, List(Int) m) {
    if (obj == 1 && op == 1) {
        Int reg = wl_u32(m, 8);
        _ = out(fd, [global(reg, 1, "wl_compositor", 4), global(reg, 2, "wl_shm", 1), global(reg, 3, "xdg_wm_base", 2), global(reg, 4, "wl_seat", 5)], 0);
        return set(c, "registry", reg);
    }
    if (obj == 1 && op == 0) {
        _ = out(fd, [wl_msg(wl_u32(m, 8), 0, wl_words([1]))], 0);
        return c;
    }
    if (obj == c.registry && op == 0) {
        WlStr s = wl_str(m, 12);
        Int id = wl_u32(m, s.next + 4);
        if (s.s == "wl_seat") {
            _ = out(fd, [wl_msg(id, 0, wl_words([3]))], 0);
            return set(c, "seat", id);
        }
        return set(c, if (s.s == "wl_compositor") { "compositor" } else { if (s.s == "wl_shm") { "shm" } else { "wm_base" } }, id);
    }
    if (obj == c.compositor && op == 0) { return set(c, "surface", wl_u32(m, 8)); }
    if (obj == c.wm_base && op == 2) { return set(c, "xdg_surface", wl_u32(m, 8)); }
    if (obj == c.xdg_surface && op == 1) { return set(c, "toplevel", wl_u32(m, 8)); }
    if (obj == c.seat && op == 0) { return set(c, "pointer", wl_u32(m, 8)); }
    if (obj == c.seat && op == 1) { return set(c, "keyboard", wl_u32(m, 8)); }
    if (obj == c.shm && op == 0) {
        Int pfd = resid_disp_recv_fd();
        _ = if (pfd >= 0) { resid_disp_fd_read(pfd, 0).len() == 0 } else { false };
        return c;
    }
    if (obj == c.surface && op == 1) { return set(c, "buffer", wl_u32(m, 8)); }
    if (obj == c.surface && op == 3) {
        // the frame callback is done at once: a compositor at full speed
        _ = out(fd, [wl_msg(wl_u32(m, 8), 0, wl_words([c.frames]))], 0);
        return set(c, "frames", c.frames + 1);
    }
    if (obj == c.surface && op == 6) { return commit(fd, set(c, "commits", c.commits + 1)); }
    return c;
}

/// The first commit gets a configure; a commit with a buffer gets the
/// buffer back at once.
@requires(display)
Comp commit(Int fd, Comp c) {
    if (c.commits == 1) {
        _ = out(fd, [wl_msg(c.toplevel, 0, wl_words([200, 100]).concat(wl_array([]))), wl_msg(c.xdg_surface, 0, wl_words([7]))], 0);
        return c;
    }
    if (c.buffer != 0) { _ = out(fd, [wl_msg(c.buffer, 0, [])], 0); }
    if (!c.streaming && c.buffer != 0) {
        _ = out(fd, [wl_msg(c.pointer, 0, wl_words([1, c.surface, 10 * 256, 10 * 256]))], 0);
        return set(c, "streaming", 1);
    }
    return c;
}

/// The compositor's state and what it has read but not yet parsed.
type Comp2 = { Comp c; List(Int) buf; };

@requires(display)
Comp2 serve_once(Int fd, Comp2 s, Int ms) {
    List(Int) ready = resid_disp_poll([fd], [1], ms);
    if (ready.len() == 0 || (ready[0] & 1) == 0) { return s; }
    List(Int) got = resid_disp_recv(fd, 65536);
    if (got.len() == 0) { return Comp2 { .c = set(s.c, "closed", 1), .buf = [] }; }
    return parse(fd, Comp2 { .c = s.c, .buf = s.buf.concat(got) });
}

@requires(display)
Comp2 parse(Int fd, Comp2 s) {
    WlIn m = wl_take(s.buf);
    if (!m.ok) { return s; }
    return parse(fd, Comp2 { .c = request(fd, s.c, m.obj, m.opcode, m.msg), .buf = m.rest });
}

/// Until the window shows its first frame.
@requires(display)
Comp2 start(Int fd, Comp2 s, Int tries) {
    if (s.c.streaming || s.c.closed || tries <= 0) { return s; }
    return start(fd, serve_once(fd, s, 1000), tries - 1);
}

/// One batch: `moves` pointer moves and a click on the button.
List(List(Int)) batch(Comp c, Int moves, Int bx, Int by, Int k, ListBuf(List(Int)) acc) {
    if (k >= moves) {
        return acc.push(wl_msg(c.pointer, 2, wl_words([k, bx * 256, by * 256])))
                  .push(wl_msg(c.pointer, 3, wl_words([1, k, 272, 1])))
                  .push(wl_msg(c.pointer, 3, wl_words([2, k, 272, 0]))).finish();
    }
    return batch(c, moves, bx, by, k + 1, acc.push(wl_msg(c.pointer, 2, wl_words([k, (5 + k % 150) * 256, (5 + k % 80) * 256]))));
}

@requires(filesystem(readonly))
Str status_field(Str name) {
    Str s = filesystem.read_all("/proc/self/status");
    Int at = str_index_of(s, name, 0);
    if (at < 0) { return "?"; }
    Int end = str_index_of(str_slice(s, at, str_len(s)), "\n", 0);
    return str_trim(str_slice(s, at + str_len(name), at + end));
}

@requires(filesystem(readonly), clock(readonly))
Int report(Str what, Int events, Int frames, Int t0) {
    Str rss = status_field("VmRSS:");
    Str peak = status_field("VmHWM:");
    Int ms = (clock.monotonic_ns() - t0) / 1000000;
    println(f"{what} {events}  frames {frames}  rss {rss}  peak {peak}  {ms} ms");
    return 0;
}

@requires(display, filesystem(readonly), clock(readonly))
Comp2 stream(Int fd, Comp2 s, Int total, Int bx, Int by, Int next_report, Int t0) {
    if (s.c.closed || s.c.sent >= total) { return s; }
    List(List(Int)) b = batch(s.c, 5, bx, by, 0, ListBuf());
    _ = out(fd, b, 0);
    Comp2 s2 = serve_once(fd, Comp2 { .c = set(s.c, "sent", s.c.sent + b.len()), .buf = s.buf }, 0);
    // let the client draw before the next batch, so each batch is a turn
    Comp2 s3 = serve_once(fd, s2, 50);
    if (s3.c.sent >= next_report) {
        _ = report("events", s3.c.sent, s3.c.commits, t0);
        return stream(fd, s3, total, bx, by, next_report * 2, t0);
    }
    return stream(fd, s3, total, bx, by, next_report, t0);
}

@requires(display, filesystem(readonly), clock(readonly))
Comp2 wind_down(Int fd, Comp2 s, Int tries) {
    if (s.c.closed || tries <= 0) { return s; }
    return wind_down(fd, serve_once(fd, s, 1000), tries - 1);
}

@requires(display, accessibility, clock(readonly))
Int run_client(Int fd) {
    Wl w = wl_start_on(fd, WindowOptions { .title = "soak", .width = 200, .height = 100, .resizable = true });
    if (!w.alive) { return 100; }
    return gui_run_on(w, counter_init(), []);
}

@requires(display, accessibility, clock(readonly), filesystem(readonly), args)
Int main() {
    Int total = if (args.count() > 1) { str_parse_int(args.get(1)) } else { 20000 };
    List(Int) pair = resid_disp_pair();
    Int sfd = pair[0];
    Int cfd = pair[1];
    // where the button is, as the loop lays it out
    List(SemNode) sem = semantics(counter_view(0), Rect { .x = 0, .y = 0, .w = 200, .h = 100 }, ui_new());
    SemNode btn = find_button(sem, 0);
    Int bx = btn.bounds.x + btn.bounds.w / 2;
    Int by = btn.bounds.y + btn.bounds.h / 2;
    Str rss0 = status_field("VmRSS:");
    println(f"button at {bx},{by}; start rss {rss0}");
    Result(Int, RegionError) r = spawn (display, accessibility, clock(readonly)) {
        return run_client(cfd);
    };
    Int t0 = clock.monotonic_ns();
    Comp2 s0 = start(sfd, Comp2 { .c = comp_new(), .buf = [] }, 20);
    Comp2 s1 = stream(sfd, s0, total, bx, by, 10000, t0);
    _ = out(sfd, [wl_msg(s1.c.toplevel, 1, [])], 0);
    Comp2 s2 = wind_down(sfd, s1, 30);
    Int code = r else { -9 };
    println(f"exit {code}");
    _ = report("done: events", s2.c.sent, s2.c.commits, t0);
    return 0;
}

SemNode find_button(List(SemNode) t, Int i) {
    if (i >= t.len() || t[i].role == role_button()) { return t[if (i >= t.len()) { 0 } else { i }]; }
    return find_button(t, i + 1);
}
