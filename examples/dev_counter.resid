import "../src/gui.resid";
import "../src/dev/hot.resid";

// The counter as a development build: every event `update` sees is kept in
// counter.events, and the next run replays them before the window opens.
// Change `counter_step` (say, make "+1" add 10), rebuild, run: the count
// comes back, recomputed by the new code. Delete counter.events to start
// over. A release build calls `gui_run` and needs no `filesystem`.
Int counter_init() { return 0; }

Int counter_step(Int m, Msg msg) {
    return match (msg) {
        Custom(n) => if (n == 1) { m + 1 } else { if (n == 2) { m - 1 } else { 0 } },
        _ => m
    };
}

Int counter_update(Int m, Event e) {
    return match (e) { AppMsg(msg) => counter_step(m, msg), _ => m };
}

Widget counter_view(Int m) {
    return Padding(8, Column([
        Text(f"count: {m}"),
        Row([Button("+1", Custom(1)), Button("-1", Custom(2)), Button("reset", Custom(3))])
    ]));
}

App(Int) = { .init = counter_init, .update = counter_update, .view = counter_view };

@requires(display, accessibility, clock(readonly), filesystem, declassify)
Int main() {
    return gui_run_dev(WindowOptions { .title = "Counter (dev)", .width = 240, .height = 90, .resizable = true }, "counter.events");
}
