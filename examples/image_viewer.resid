import "../src/gui.resid";

// An image in a window: a generated gradient, shown at its own size and
// centred. Wheel up and down zooms between 1x and 4x by repeating pixels.

type Viewer = { Int zoom; };

Viewer viewer_init() { return Viewer { .zoom = 2 }; }

Viewer viewer_update(Viewer v, Event e) {
    return match (e) {
        Wheel(dx, dy) => Viewer { .zoom = if (dy < 0 && v.zoom < 4) { v.zoom + 1 } else { if (dy > 0 && v.zoom > 1) { v.zoom - 1 } else { v.zoom } } },
        _ => v
    };
}

/// A `w` x `h` gradient, blue-green-red-alpha.
List(Int) gradient(Int w, Int h) { return gradient_at(w, h, 0, ListBuf()); }

List(Int) gradient_at(Int w, Int h, Int i, ListBuf(Int) b) {
    if (i >= w * h) { return b.finish(); }
    Int x = i % w;
    Int y = i / w;
    return gradient_at(w, h, i + 1, b.push(((x + y) * 255) / (w + h)).push((y * 255) / h).push((x * 255) / w).push(255));
}

/// Each pixel of a `w`-wide image repeated `k` times across and down.
List(Int) zoomed(List(Int) px, Int w, Int h, Int k) { return zoom_at(px, w, k, 0, 0, w * k, h * k, ListBuf()); }

List(Int) zoom_at(List(Int) px, Int w, Int k, Int x, Int y, Int zw, Int zh, ListBuf(Int) b) {
    if (y >= zh) { return b.finish(); }
    if (x >= zw) { return zoom_at(px, w, k, 0, y + 1, zw, zh, b); }
    Int s = ((y / k) * w + (x / k)) * 4;
    return zoom_at(px, w, k, x + 1, y, zw, zh, b.push(px[s]).push(px[s + 1]).push(px[s + 2]).push(px[s + 3]));
}

Widget viewer_view(Viewer v) {
    Int w = 64;
    Int h = 48;
    return Column([
        Text(f"gradient {w}x{h} at {v.zoom}x (wheel zooms)"),
        Align(50, 50, Bitmap(w * v.zoom, h * v.zoom, zoomed(gradient(w, h), w, h, v.zoom)))
    ]);
}

App(Viewer) = { .init = viewer_init, .update = viewer_update, .view = viewer_view };

@requires(display, clock(readonly))
Int main() {
    return gui_run(WindowOptions { .title = "Image Viewer", .width = 320, .height = 260, .resizable = true });
}
