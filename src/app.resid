// app.resid — the types a program and the library share.
//
// A program describes its window with these values and nothing else: an
// `App(M)` instance (initial model, a pure step over events, a pure view)
// and the `WindowOptions` it opens with.

// The library owns the display, the loop and the pixels.

import "ui/theme.resid";

/// A message a widget raises. Widgets carry these as values, never
/// closures: a closure cannot be compared, and value equality is what
/// damage tracking is built on. `Custom(n)` tells many widgets apart.
type Msg = Clicked | Toggled | Changed(Str) | Submitted | Custom(Int);

/// What reaches `update`. Coordinates are logical pixels relative to the
/// window; key codes are Linux evdev codes (`KEY_A` is 30) whatever the
/// display server, and the `Str` is the text the key types under the US
/// layout, empty for keys that type nothing.
///
/// The widget events come from the library, not the display:
/// - `AppMsg(m)`: a `Button` or `Checkbox` was clicked, or Enter was
///   pressed in a focused `TextInput`; `m` is the widget's message.
/// - `TextEdited(m, text, caret)`: a focused `TextInput` was edited; the
///   program stores the new text and caret and passes them back in `view`.
/// - `SliderSet(m, value)`: a `Slider` was clicked or dragged to `value`
///   (0 to 100).
/// - `Assist(node, action)`: a screen reader or other assistive tool acted
///   on widget number `node` (see `act_*` in ui/semantics.resid). The
///   library turns it into what a pointer or keyboard would have done
///   (`AppMsg`, focus) and passes it on as well.
/// - `PasswordEdited(m, text, caret)`: a focused `PasswordInput` was
///   edited; as with `TextEdited`, the program stores the text and caret
///   and passes them back in `view`. The text is a `Secret(Str)`: the type
///   system keeps it out of `Show`, f-strings, logs and comparisons; the
///   program reads it only through `declassify`, where it chooses (to
///   check a login, say). The keys that typed it are not passed on.
/// - `ScrollTo(scroll, offset)`: a screen reader asked to see a widget
///   scrolled out of view; the `Scroll` numbered `scroll` (pre-order, as
///   `Assist` numbers widgets) shows it at `offset`. The program owns the
///   offset, as it does for `Wheel`: one with a single `Scroll` sets it.
type Event = PointerMoved(Int, Int) | PointerDown(Int, Int, Int) | PointerUp(Int, Int, Int) | Wheel(Int, Int) | KeyDown(Int, Str) | KeyUp(Int) | Resized(Int, Int) | Focused | Blurred | Closed | FrameTick | AppMsg(Msg) | TextEdited(Msg, Str, Int) | SliderSet(Msg, Int) | Assist(Int, Int) | ScrollTo(Int, Int) | PasswordEdited(Msg, Secret(Str), Int);

/// What the program wants on screen. A widget is a value, so two equal
/// models give two equal display lists and therefore identical pixels.
///
/// - `Text(s)`: one line of text.
/// - `Button(label, m)`: raises `AppMsg(m)` when clicked.
/// - `Checkbox(label, checked, m)`: raises `AppMsg(m)` when clicked.
/// - `TextInput(text, caret, m)`: an editable line; see `TextEdited`.
/// - `PasswordInput(text, caret, m)`: an editable line whose text is a
///   secret: drawn as one bullet per character, read to screen readers
///   as a password field holding that many bullets, never exported
///   (semantics, AT-SPI, the RSP tree, the timeline); see
///   `PasswordEdited`. Start it from `password_empty()`.
/// - `Row(xs)` / `Column(xs)`: children side by side or stacked, each at
///   its natural size; `Spacer`s share whatever space is left.
/// - `Stack(xs)`: children drawn over each other in the same box.
/// - `Padding(n, w)`: `n` pixels of space around `w`.
/// - `Align(ax, ay, w)`: takes the space it is given and places `w`, at
///   its natural size, at `ax`/`ay`
///   percent of the free space (0 start, 50 centre, 100 end).
/// - `Scroll(offset, w)`: `w` shifted up by `offset` pixels and clipped to
///   the box; the program moves `offset` on `Wheel` events.
/// - `Rows(offset, row_h, rows)`: a list of rows `row_h` pixels high,
///   shifted up by `offset` and clipped like `Scroll`. Only the rows in
///   view are laid out, painted and hit-tested, so a list of ten thousand
///   rows costs what the twenty on screen cost.
/// - `Bitmap(w, h, px)`: a `w` x `h` image, four bytes per pixel in
///   blue-green-red-alpha order.
/// - `Slider(value, m)`: a 0 to 100 slider; see `SliderSet`.
/// - `Spacer`: empty space that stretches.
/// - `Themed(spec, w)`: `w` in the theme `spec` derives (ui/theme.resid):
///   switch light and dark from the model, or give a panel its own
///   accent. Lays out exactly as `w`.
type Widget = Text(Str) | Button(Str, Msg) | Checkbox(Str, Bool, Msg) | TextInput(Str, Int, Msg) | Row(List(Widget)) | Column(List(Widget)) | Stack(List(Widget)) | Padding(Int, Widget) | Align(Int, Int, Widget) | Scroll(Int, Widget) | Rows(Int, Int, List(Widget)) | Bitmap(Int, Int, List(Int)) | Slider(Int, Msg) | Spacer | Themed(ThemeSpec, Widget) | PasswordInput(Secret(Str), Int, Msg);

/// An empty password, for a `PasswordInput`'s first view. (`classify`:
/// an empty text holds no secret, and a known one built with `secret`
/// would be refused, E0250.)
pub Secret(Str) password_empty() { return classify(""); }

/// The character a `PasswordInput` shows for each of its own: U+2022.
pub Str password_bullet() { return "•"; }

/// What a `PasswordInput` holding `s` shows and reads: one bullet per
/// character. Only the length is used, which is public (spec §48).
pub Str password_bullets(Secret(Str) s) { return bullets_n(s.len(), StrBuf()); }

Str bullets_n(Int n, StrBuf b) { return if (n <= 0) { b.finish() } else { bullets_n(n - 1, b.push(password_bullet())) }; }

/// A program's application: a model, a pure step over events, a pure view.
behavior App(M) {
    M init();
    M update(M m, Event e);
    Widget view(M m);
}

/// How a window is opened. `width` and `height` are logical pixels.
type WindowOptions = {
    Str title; Int width; Int height; Bool resizable;
};

/// The most pixels a side a window may ask for, logical or device.
pub Int window_max_side() { return 16384; }

/// Why a window cannot be opened with `o`, or "": a side past
/// `window_max_side()` is refused before any backend multiplies it by a
/// scale or allocates for it (R4-7). A side below 1 is taken as 1.
pub Str window_options_err(WindowOptions o) {
    if (o.width > window_max_side() || o.height > window_max_side()) {
        Str w = if (o.width > window_max_side()) { "width" } else { "height" };
        return f"resid-gui: the window's {w} is past {window_max_side()} pixels";
    }
    return "";
}

/// Message equality, field by field.
pub Bool msg_eq(Msg a, Msg b) {
    return match (a) {
        Clicked => match (b) { Clicked => true, _ => false },
        Toggled => match (b) { Toggled => true, _ => false },
        Changed(sa) => match (b) { Changed(sb) => sa == sb, _ => false },
        Submitted => match (b) { Submitted => true, _ => false },
        Custom(na) => match (b) { Custom(nb) => na == nb, _ => false }
    };
}

test "messages compare by value" {
    expect(msg_eq(Custom(1), Custom(1))).toEqual(true);
    expect(msg_eq(Custom(1), Custom(2))).toEqual(false);
    expect(msg_eq(Clicked, Toggled)).toEqual(false);
    expect(msg_eq(Changed("a"), Changed("a"))).toEqual(true);
}

test "a password shows one bullet per character" {
    expect(password_bullets(password_empty())).toEqual("");
    expect(str_len(password_bullets(classify("héllo")))).toEqual(5);
    expect(password_bullets(classify("ab"))).toEqual("••");
}
