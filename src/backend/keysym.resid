// keysym.resid — keysyms to the characters they type.
//
// X11 reports a key's symbols as numbers (GetKeyboardMapping) and a
// Wayland compositor's XKB keymap names them. Both come down to a code
// point here: every keysym libxkbcommon gives a Unicode character (ASCII,
// Latin-1 to 9, Cyrillic, Greek, Arabic, Hebrew, Thai, Armenian, Georgian,
// Korean, Vietnamese and the technical symbols), the keypad's digits and
// operators, and any keysym written as `U<hex>` or numbered in the Unicode
// range. Dead keys and function keys type nothing.
//
// GENERATED tables (`keysym_table`, `legacy_table`) from the comments of
// /usr/include/xkbcommon/xkbcommon-keysyms.h by tools/gen_keysyms.py; edit
// the generator, not the tables.

/// The code point a keysym number types, or 0.
pub Int keysym_cp(Int ks) {
    if ((ks >= 32 && ks <= 126) || (ks >= 160 && ks <= 255)) { return ks; }
    if (ks >= 16777472 && ks <= 17891327) { return ks - 16777216; }     // 0x1000100..0x110ffff: Unicode
    if (ks >= 65456 && ks <= 65465) { return ks - 65456 + 48; }          // KP_0..KP_9
    if (ks == 65408) { return 32; }                                      // KP_Space
    if (ks >= 65450 && ks <= 65455) { return [42, 43, 44, 45, 46, 47][ks - 65450]; }   // KP_Multiply..KP_Divide
    if (ks == 65469) { return 61; }                                      // KP_Equal
    if (ks > 255 && ks < 65280) { return legacy_table().get(ks) else { 0 }; }
    return 0;
}

/// The evdev code of the key a function keysym stands for (Escape is 1,
/// BackSpace 14, Return 28, Left 105, ...), or 0 for any other keysym.
/// The library acts on these codes, so a layout that moves Escape, or a
/// tool that types through key codes of its own, still edits text right.
pub Int keysym_key(Int ks) { return function_keys().get(ks) else { 0 }; }

Map(Int, Int) function_keys() {
    return { 65307: 1, 65288: 14, 65289: 15, 65056: 15, 65293: 28, 65421: 96, 65360: 102, 65361: 105, 65362: 103, 65363: 106, 65364: 108, 65365: 104, 65366: 109, 65367: 107, 65379: 110, 65535: 111, 65505: 42, 65506: 54, 65507: 29, 65508: 97, 65509: 58, 65513: 56, 65514: 100, 65515: 125, 65516: 126, 65027: 100 };
}

/// The function key a keysym name (or `0x` number) stands for, or 0.
pub Int keysym_name_key(Str n) {
    if (str_len(n) >= 3 && str_starts_with(n, "0x")) {
        Int k = hex_value(n, 2, 0);
        return if (k > 0) { keysym_key(k) } else { 0 };
    }
    Map(Str, Int) m = { "Escape": 65307, "BackSpace": 65288, "Tab": 65289, "ISO_Left_Tab": 65056, "Return": 65293, "KP_Enter": 65421, "Home": 65360, "Left": 65361, "Up": 65362, "Right": 65363, "Down": 65364, "Prior": 65365, "Next": 65366, "End": 65367, "Insert": 65379, "Delete": 65535, "Shift_L": 65505, "Shift_R": 65506, "Control_L": 65507, "Control_R": 65508, "Caps_Lock": 65509, "Alt_L": 65513, "Alt_R": 65514, "Super_L": 65515, "Super_R": 65516, "ISO_Level3_Shift": 65027 };
    return keysym_key(m.get(n) else { 0 });
}

