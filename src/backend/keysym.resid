/// The code point a keysym name types, or 0: a letter or digit names
/// itself, `U20AC` and `0x20ac` spell one out.
pub Int keysym_name_cp(Map(Str, Int) names, Str n) {
    Int len = str_len(n);
    if (len == 1) {
        Int c = str_char_at(n, 0);
        return if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { c } else { 0 };
    }
    if (len >= 5 && str_char_at(n, 0) == 85) {
        Int u = hex_value(n, 1, 0);
        if (u > 0 && u <= 1114111) { return u; }
    }
    if (len >= 3 && str_starts_with(n, "0x")) {
        Int k = hex_value(n, 2, 0);
        return if (k > 0) { keysym_cp(k) } else { 0 };
    }
    return names.get(n) else { 0 };
}

/// The hexadecimal number in `s` from `i`, or -1 when a character is not
/// a hex digit or it runs past eight digits.
Int hex_value(Str s, Int i, Int acc) {
    if (i >= str_len(s)) { return acc; }
    if (i > 9) { return 0 - 1; }
    Int c = str_char_at(s, i);
    Int d = if (c >= 48 && c <= 57) { c - 48 } else { if (c >= 97 && c <= 102) { c - 87 } else { if (c >= 65 && c <= 70) { c - 55 } else { 0 - 1 } } };
    if (d < 0) { return 0 - 1; }
    return hex_value(s, i + 1, acc * 16 + d);
}

test "keysym numbers" {
    expect(keysym_cp(97)).toEqual(97);
    expect(keysym_cp(228)).toEqual(228);
    expect(keysym_cp(16777216 + 1078)).toEqual(1078);
    expect(keysym_cp(65463)).toEqual(55);
    expect(keysym_cp(65293)).toEqual(0);
    expect(keysym_cp(1734)).toEqual(1092);
    expect(keysym_cp(8364)).toEqual(8364);
}

test "function keys" {
    expect(keysym_key(65307)).toEqual(1);
    expect(keysym_key(65535)).toEqual(111);
    expect(keysym_key(97)).toEqual(0);
    expect(keysym_name_key("Escape")).toEqual(1);
    expect(keysym_name_key("Return")).toEqual(28);
    expect(keysym_name_key("q")).toEqual(0);
    expect(keysym_name_key("0xff09")).toEqual(15);
    expect(keysym_name_key("0x47")).toEqual(0);
}

test "keysym names" {
    Map(Str, Int) t = keysym_table();
    expect(keysym_name_cp(t, "a")).toEqual(97);
    expect(keysym_name_cp(t, "exclam")).toEqual(33);
    expect(keysym_name_cp(t, "adiaeresis")).toEqual(228);
    expect(keysym_name_cp(t, "ssharp")).toEqual(223);
    expect(keysym_name_cp(t, "ydiaeresis")).toEqual(255);
    expect(keysym_name_cp(t, "EuroSign")).toEqual(8364);
    expect(keysym_name_cp(t, "U0436")).toEqual(1078);
    expect(keysym_name_cp(t, "0x1000436")).toEqual(1078);
    expect(keysym_name_cp(t, "KP_7")).toEqual(55);
    expect(keysym_name_cp(t, "Return")).toEqual(0);
    expect(keysym_name_cp(t, "dead_acute")).toEqual(0);
    expect(keysym_name_cp(t, "Cyrillic_ef")).toEqual(1092);
    expect(keysym_name_cp(t, "Greek_OMEGA")).toEqual(937);
    expect(keysym_name_cp(t, "Udiaeresis")).toEqual(220);
}
