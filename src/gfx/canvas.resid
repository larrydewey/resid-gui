// canvas.resid — a frame's pixels and the writes that change them.
//
// A canvas is `w * h` pixels of four bytes each in the order a window
// server reads them: blue, green, red, alpha (ARGB32, little-endian). Every
// write threads the pixel list through a tail call and replaces elements
// with `with`, which the compiler does in place because the old list is
// dead afterwards; nothing here copies the frame per pixel.

import "color.resid";

/// A frame: its size and its pixels, four bytes each.
pub type Canvas = { Int w; Int h; List(Int) px; };

/// A colour as one 32-bit ARGB word.
pub Int color_pack(Color c) {
    return ((c.a & 255) << 24) | ((c.r & 255) << 16) | ((c.g & 255) << 8) | (c.b & 255);
}

/// A canvas of the given size, every pixel transparent black.
pub Canvas canvas_new(Int ww, Int hh) {
    Int w = if (ww < 0) { 0 } else { ww };
    Int h = if (hh < 0) { 0 } else { hh };
    ListBuf(Int) b = ListBuf();
    return Canvas { .w = w, .h = h, .px = canvas_fill(0, w * h * 4, b) };
}

/// `n` zero bytes.
pub List(Int) canvas_fill(Int i, Int n, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return canvas_fill(i + 1, n, acc.push(0));
}

/// The whole canvas as a rectangle.
pub Rect canvas_bounds(Canvas c) { return Rect { .x = 0, .y = 0, .w = c.w, .h = c.h }; }

/// Fill a rectangle, clipped to the canvas.
pub Canvas fill_rect(Canvas c, Rect r, Color col) {
    return fill_rect_clip(c, r, col, canvas_bounds(c));
}

/// Fill a rectangle, clipped to `clip` and to the canvas.
pub Canvas fill_rect_clip(Canvas c, Rect r, Color col, Rect clip) {
    Rect a = rect_intersect(rect_intersect(r, clip), canvas_bounds(c));
    if (rect_is_empty(a)) { return c; }
    Int ww = c.w;
    Int hh = c.h;
    List(Int) px = fill_rows(c.px, ww, a, col.b & 255, col.g & 255, col.r & 255, col.a & 255, a.y, a.x);
    return Canvas { .w = ww, .h = hh, .px = px };
}

List(Int) fill_rows(List(Int) px, Int ww, Rect a, Int b, Int g, Int r, Int al, Int y, Int x) {
    if (y >= a.y + a.h) { return px; }
    if (x >= a.x + a.w) { return fill_rows(px, ww, a, b, g, r, al, y + 1, a.x); }
    Int i = (y * ww + x) * 4;
    return fill_rows(px.with(i, b).with(i + 1, g).with(i + 2, r).with(i + 3, al), ww, a, b, g, r, al, y, x + 1);
}

/// One pixel, when it lies inside `clip` and the canvas.
pub Canvas set_pixel_clip(Canvas c, Int x, Int y, Color col, Rect clip) {
    if (x < 0 || y < 0 || x >= c.w || y >= c.h || !rect_contains(clip, x, y)) { return c; }
    Int i = (y * c.w + x) * 4;
    Int ww = c.w;
    Int hh = c.h;
    return Canvas { .w = ww, .h = hh, .px = c.px.with(i, col.b & 255).with(i + 1, col.g & 255).with(i + 2, col.r & 255).with(i + 3, col.a & 255) };
}

/// `col` laid over one pixel with coverage `a` (0 to 255), when the pixel
/// lies inside `clip` and the canvas. The result is opaque.
pub Canvas blend_pixel_clip(Canvas c, Int x, Int y, Color col, Int a, Rect clip) {
    if (a <= 0 || x < 0 || y < 0 || x >= c.w || y >= c.h || !rect_contains(clip, x, y)) { return c; }
    if (a >= 255) { return set_pixel_clip(c, x, y, col, clip); }
    Int i = (y * c.w + x) * 4;
    Int na = 255 - a;
    Int b = (col.b * a + c.px[i] * na) / 255;
    Int g = (col.g * a + c.px[i + 1] * na) / 255;
    Int r = (col.r * a + c.px[i + 2] * na) / 255;
    Int ww = c.w;
    Int hh = c.h;
    return Canvas { .w = ww, .h = hh, .px = c.px.with(i, b).with(i + 1, g).with(i + 2, r).with(i + 3, 255) };
}

/// The colour of one pixel; transparent black outside the canvas.
pub Color pixel_at(Canvas c, Int x, Int y) {
    if (x < 0 || y < 0 || x >= c.w || y >= c.h) { return Color { .b = 0, .g = 0, .r = 0, .a = 0 }; }
    Int i = (y * c.w + x) * 4;
    return Color { .b = c.px[i], .g = c.px[i + 1], .r = c.px[i + 2], .a = c.px[i + 3] };
}

/// The bytes of rows `y0` up to (not including) `y1`, the band a damaged
/// rectangle needs uploaded.
pub List(Int) canvas_rows(Canvas c, Int y0, Int y1) {
    Int a = if (y0 < 0) { 0 } else { y0 };
    Int b = if (y1 > c.h) { c.h } else { y1 };
    if (b <= a) { return []; }
    return c.px[(a * c.w * 4)..(b * c.w * 4)];
}

/// The pixel bytes, for presenting or encoding.
pub List(Int) finish(Canvas c) { return c.px; }

test "canvas allocates" {
    Canvas c = canvas_new(4, 3);
    expect(c.px.len()).toEqual(48);
}

test "fill_rect writes inside and only inside" {
    Canvas c0 = canvas_new(4, 3);
    Color col = Color { .b = 1, .g = 2, .r = 3, .a = 4 };
    Canvas c1 = fill_rect(c0, Rect { .x = 1, .y = 1, .w = 2, .h = 1 }, col);
    Int base = (1 * 4 + 1) * 4;
    expect(c1.px[base + 0]).toEqual(1);
    expect(c1.px[base + 1]).toEqual(2);
    expect(c1.px[base + 2]).toEqual(3);
    expect(c1.px[base + 3]).toEqual(4);
    expect(c1.px[0]).toEqual(0);
    expect(c1.px[(1 * 4 + 3) * 4]).toEqual(0);
}

test "fill_rect clips to the canvas and to the clip" {
    Canvas c0 = canvas_new(4, 4);
    Color col = rgb(9, 9, 9);
    Canvas c1 = fill_rect(c0, Rect { .x = -2, .y = -2, .w = 100, .h = 100 }, col);
    expect(pixel_at(c1, 3, 3).r).toEqual(9);
    Canvas c2 = fill_rect_clip(canvas_new(4, 4), Rect { .x = 0, .y = 0, .w = 4, .h = 4 }, col, Rect { .x = 1, .y = 1, .w = 1, .h = 1 });
    expect(pixel_at(c2, 1, 1).r).toEqual(9);
    expect(pixel_at(c2, 0, 0).r).toEqual(0);
    expect(pixel_at(c2, 2, 2).r).toEqual(0);
}

test "blending mixes by coverage" {
    Canvas c = fill_rect(canvas_new(1, 1), Rect { .x = 0, .y = 0, .w = 1, .h = 1 }, rgb(0, 0, 0));
    Canvas d = blend_pixel_clip(c, 0, 0, rgb(255, 255, 255), 51, canvas_bounds(c));
    expect(pixel_at(d, 0, 0).r).toEqual(51);
    expect(pixel_at(d, 0, 0).a).toEqual(255);
}

test "rows are bands of the frame" {
    Canvas c = fill_rect(canvas_new(2, 3), Rect { .x = 0, .y = 1, .w = 2, .h = 1 }, rgb(5, 6, 7));
    List(Int) band = canvas_rows(c, 1, 2);
    expect(band.len()).toEqual(8);
    expect(band[2]).toEqual(5);
    expect(canvas_rows(c, 2, 1).len()).toEqual(0);
}

test "finish" {
    Canvas c = canvas_new(2, 2);
    expect(finish(c).len()).toEqual(16);
}
