// canvas.resid — a frame's pixels and the writes that change them.
//
// A canvas is `w * h` pixels, one 32-bit ARGB word each (alpha in the top
// byte, blue in the bottom one), which in memory is the blue, green, red,
// alpha byte order a window server reads (ARGB32, little-endian):
// `resid_disp_shm_put32` copies the words into shared memory as they are.
// A pixel is one list element, so a fill writes one element where a list
// of bytes took four. Every write threads the pixel list through a tail
// call and replaces elements with `with`, which the compiler does in place
// because the old list is dead afterwards; nothing here copies the frame
// per pixel.
//
// A writer reads the canvas's size from its fields, never by passing the
// canvas to another function first (`canvas_bounds(c)`): the compiler
// then treats the pixel list as shared and copies all of it on the first
// write, which made every draw op cost a whole frame.

import "color.resid";

/// A frame: its size and its pixels, one ARGB word each.
pub type Canvas = { Int w; Int h; List(UInt(32)) px; };

/// A colour as one 32-bit ARGB word.
pub Int color_pack(Color c) {
    return ((c.a & 255) << 24) | ((c.r & 255) << 16) | ((c.g & 255) << 8) | (c.b & 255);
}

/// A colour as the canvas stores it.
pub UInt(32) color_word(Color c) { return (UInt(32))color_pack(c); }

/// The colour a canvas word holds.
pub Color word_color(UInt(32) w) {
    Int v = (Int)w;
    return Color { .b = v & 255, .g = (v >> 8) & 255, .r = (v >> 16) & 255, .a = (v >> 24) & 255 };
}

/// A canvas of the given size, every pixel transparent black.
pub Canvas canvas_new(Int ww, Int hh) {
    Int w = if (ww < 0) { 0 } else { ww };
    Int h = if (hh < 0) { 0 } else { hh };
    ListBuf(UInt(32)) b = ListBuf();
    return Canvas { .w = w, .h = h, .px = words_of(0, w * h, (UInt(32))0, b) };
}

/// A canvas of the given size, every pixel `col`: one pass, where a new
/// canvas and a fill would be two.
pub Canvas canvas_filled(Int ww, Int hh, Color col) {
    Int w = if (ww < 0) { 0 } else { ww };
    Int h = if (hh < 0) { 0 } else { hh };
    ListBuf(UInt(32)) b = ListBuf();
    return Canvas { .w = w, .h = h, .px = words_of(0, w * h, color_word(col), b) };
}

List(UInt(32)) words_of(Int i, Int n, UInt(32) v, ListBuf(UInt(32)) acc) {
    if (i >= n) { return acc.finish(); }
    return words_of(i + 1, n, v, acc.push(v));
}

/// `n` zero bytes (an image's pixels start as these).
pub List(Int) canvas_fill(Int i, Int n, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return canvas_fill(i + 1, n, acc.push(0));
}

/// The whole canvas as a rectangle.
pub Rect canvas_bounds(Canvas c) { return Rect { .x = 0, .y = 0, .w = c.w, .h = c.h }; }

/// Fill a rectangle, clipped to the canvas.
pub Canvas fill_rect(Canvas c, Rect r, Color col) {
    Rect all = Rect { .x = 0, .y = 0, .w = c.w, .h = c.h };
    return fill_rect_clip(c, r, col, all);
}

/// Fill a rectangle, clipped to `clip` and to the canvas.
pub Canvas fill_rect_clip(Canvas c, Rect r, Color col, Rect clip) {
    Int ww = c.w;
    Int hh = c.h;
    Rect a = rect_intersect(rect_intersect(r, clip), Rect { .x = 0, .y = 0, .w = ww, .h = hh });
    if (rect_is_empty(a)) { return c; }
    List(UInt(32)) px = fill_rows(c.px, ww, a.x, a.x + a.w, a.y + a.h, color_word(col), a.y * ww + a.x, a.y);
    return Canvas { .w = ww, .h = hh, .px = px };
}

/// Pixels `x0` up to `x1` of rows `y` up to `y1`, `i` being the index of
/// the next one to write.
List(UInt(32)) fill_rows(List(UInt(32)) px, Int ww, Int x0, Int x1, Int y1, UInt(32) v, Int i, Int y) {
    if (y >= y1) { return px; }
    Int end = y * ww + x1;
    if (i >= end) { return fill_rows(px, ww, x0, x1, y1, v, (y + 1) * ww + x0, y + 1); }
    return fill_rows(px.with(i, v), ww, x0, x1, y1, v, i + 1, y);
}

/// One pixel, when it lies inside `clip` and the canvas.
pub Canvas set_pixel_clip(Canvas c, Int x, Int y, Color col, Rect clip) {
    if (x < 0 || y < 0 || x >= c.w || y >= c.h || !rect_contains(clip, x, y)) { return c; }
    Int ww = c.w;
    Int hh = c.h;
    return Canvas { .w = ww, .h = hh, .px = c.px.with(y * ww + x, color_word(col)) };
}

/// `col` laid over one pixel with coverage `a` (0 to 255), when the pixel
/// lies inside `clip` and the canvas. The result is opaque.
pub Canvas blend_pixel_clip(Canvas c, Int x, Int y, Color col, Int a, Rect clip) {
    if (a <= 0 || x < 0 || y < 0 || x >= c.w || y >= c.h || !rect_contains(clip, x, y)) { return c; }
    if (a >= 255) { return set_pixel_clip(c, x, y, col, clip); }
    Int ww = c.w;
    Int hh = c.h;
    Int i = y * ww + x;
    Int old = (Int)c.px[i];
    Int na = 255 - a;
    Int b = (col.b * a + (old & 255) * na) / 255;
    Int g = (col.g * a + ((old >> 8) & 255) * na) / 255;
    Int r = (col.r * a + ((old >> 16) & 255) * na) / 255;
    UInt(32) v = (UInt(32))((255 << 24) | (r << 16) | (g << 8) | b);
    return Canvas { .w = ww, .h = hh, .px = c.px.with(i, v) };
}

/// The colour of one pixel; transparent black outside the canvas.
pub Color pixel_at(Canvas c, Int x, Int y) {
    if (x < 0 || y < 0 || x >= c.w || y >= c.h) { return Color { .b = 0, .g = 0, .r = 0, .a = 0 }; }
    return word_color(c.px[y * c.w + x]);
}

/// The bytes of rows `y0` up to (not including) `y1`, blue, green, red and
/// alpha for each pixel: the band a `PutImage` sends.
pub List(Int) canvas_rows(Canvas c, Int y0, Int y1) {
    Int a = if (y0 < 0) { 0 } else { y0 };
    Int b = if (y1 > c.h) { c.h } else { y1 };
    if (b <= a) { return []; }
    ListBuf(Int) acc = ListBuf();
    return bytes_of(c.px, a * c.w, b * c.w, acc);
}

List(Int) bytes_of(List(UInt(32)) px, Int i, Int end, ListBuf(Int) acc) {
    if (i >= end) { return acc.finish(); }
    Int v = (Int)px[i];
    return bytes_of(px, i + 1, end, acc.push(v & 255).push((v >> 8) & 255).push((v >> 16) & 255).push((v >> 24) & 255));
}

/// The pixel bytes, blue, green, red and alpha each, for encoding.
pub List(Int) finish(Canvas c) { return canvas_rows(c, 0, c.h); }

test "canvas allocates" {
    Canvas c = canvas_new(4, 3);
    expect(c.px.len()).toEqual(12);
    expect(finish(c).len()).toEqual(48);
}

test "fill_rect writes inside and only inside" {
    Canvas c0 = canvas_new(4, 3);
    Color col = Color { .b = 1, .g = 2, .r = 3, .a = 4 };
    Canvas c1 = fill_rect(c0, Rect { .x = 1, .y = 1, .w = 2, .h = 1 }, col);
    List(Int) bytes = finish(c1);
    Int base = (1 * 4 + 1) * 4;
    expect(bytes[base + 0]).toEqual(1);
    expect(bytes[base + 1]).toEqual(2);
    expect(bytes[base + 2]).toEqual(3);
    expect(bytes[base + 3]).toEqual(4);
    expect(bytes[0]).toEqual(0);
    expect(bytes[(1 * 4 + 3) * 4]).toEqual(0);
    expect((Int)c1.px[1 * 4 + 2]).toEqual(67305985);
    expect((Int)c1.px[1 * 4 + 3]).toEqual(0);
}

test "fill_rect clips to the canvas and to the clip" {
    Canvas c0 = canvas_new(4, 4);
    Color col = rgb(9, 9, 9);
    Canvas c1 = fill_rect(c0, Rect { .x = -2, .y = -2, .w = 100, .h = 100 }, col);
    expect(pixel_at(c1, 3, 3).r).toEqual(9);
    Canvas c2 = fill_rect_clip(canvas_new(4, 4), Rect { .x = 0, .y = 0, .w = 4, .h = 4 }, col, Rect { .x = 1, .y = 1, .w = 1, .h = 1 });
    expect(pixel_at(c2, 1, 1).r).toEqual(9);
    expect(pixel_at(c2, 0, 0).r).toEqual(0);
    expect(pixel_at(c2, 2, 2).r).toEqual(0);
}

test "blending mixes by coverage" {
    Canvas c = fill_rect(canvas_new(1, 1), Rect { .x = 0, .y = 0, .w = 1, .h = 1 }, rgb(0, 0, 0));
    Canvas d = blend_pixel_clip(c, 0, 0, rgb(255, 255, 255), 51, canvas_bounds(c));
    expect(pixel_at(d, 0, 0).r).toEqual(51);
    expect(pixel_at(d, 0, 0).a).toEqual(255);
}

test "a filled canvas and a word round-trip a colour" {
    Color col = Color { .b = 10, .g = 20, .r = 30, .a = 40 };
    expect(pixel_at(canvas_filled(2, 2, col), 1, 1).g).toEqual(20);
    expect(word_color(color_word(col)).a).toEqual(40);
}

test "rows are bands of the frame" {
    Canvas c = fill_rect(canvas_new(2, 3), Rect { .x = 0, .y = 1, .w = 2, .h = 1 }, rgb(5, 6, 7));
    List(Int) band = canvas_rows(c, 1, 2);
    expect(band.len()).toEqual(8);
    expect(band[2]).toEqual(5);
    expect(canvas_rows(c, 2, 1).len()).toEqual(0);
}
