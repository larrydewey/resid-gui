/// Row `row` (0-15) of the built-in glyph for `code`: one byte, the
/// leftmost pixel in the high bit. Codes outside printable ASCII are blank.
pub Int glyph_row(Int code, Int row) {
    if (code < 32 || code > 126 || row < 0 || row > 15) { return 0; }
    return font_data()[(code - 32) * 16 + row];
}

// ─── Metrics ────────────────────────────────────────────────────────

/// The atlas character drawn for `code`: itself when printable ASCII,
/// otherwise `?`.
pub Int font_char(Int code) { return if (code >= 32 && code <= 126) { code } else { 63 }; }

/// Field `k` (0-6) of the atlas glyph for `code`.
pub Int glyph_field(Font f, Int code, Int k) { return f.glyphs[(font_char(code) - 32) * 7 + k]; }

/// The kerning between two characters, in device pixels.
pub Int kern_of(Font f, Int a, Int b) { return f.kern.get(font_char(a) * 256 + font_char(b)) else { 0 }; }

/// The width of `s` in device pixels at the font's own scale.
pub Int text_width_device(Font f, Str s) {
    if (font_is_builtin(f)) { return str_len(s) * 8; }
    return width_at(f, s, str_len(s), 0, 0);
}

Int width_at(Font f, Str s, Int n, Int i, Int acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(s, i);
    Int k = if (i + 1 < n) { kern_of(f, c, str_char_at(s, i + 1)) } else { 0 };
    return width_at(f, s, n, i + 1, acc + glyph_field(f, c, 0) + k);
}

/// The width of `s` in logical pixels, rounded up.
pub Int text_width_in(Font f, Str s) {
    Int d = text_width_device(f, s);
    return (d + f.scale - 1) / f.scale;
}

/// The height of a line in logical pixels, rounded up.
pub Int text_height_in(Font f) { return (f.line + f.scale - 1) / f.scale; }

/// The built-in font's width of `s`, for code that has no font at hand.
pub Int text_width(Str s) { return str_len(s) * 8; }

/// The built-in font's line height.
pub Int text_height() { return 16; }

/// The character index in `s` whose left edge is nearest logical `x`.
pub Int index_at_x(Font f, Str s, Int x) { return index_at(f, s, str_len(s), x * f.scale, 0, 0); }

Int index_at(Font f, Str s, Int n, Int xd, Int i, Int pen) {
    if (i >= n) { return n; }
    Int adv = if (font_is_builtin(f)) { 8 } else { glyph_field(f, str_char_at(s, i), 0) };
    if (xd < pen + adv / 2) { return i; }
    return index_at(f, s, n, xd, i + 1, pen + adv);
}

// ─── Atlas ──────────────────────────────────────────────────────────

/// The 32-bit little-endian integer at `i`, sign-extended.
Int le32(List(Int) b, Int i) {
    Int v = (b[i] & 255) | ((b[i + 1] & 255) << 8) | ((b[i + 2] & 255) << 16) | ((b[i + 3] & 255) << 24);
    return if (v >= 2147483648) { v - 4294967296 } else { v };
}

/// The header, 95 glyph records and 1024 kerning slots before the atlas.
pub Int atlas_offset() { return 32 + 95 * 28 + 1024 * 4; }

/// A font from the native module's answer (layout in native/font/font.c),
/// made for device `scale`. Every field is checked: the magic and status,
/// sizes within limits, and every glyph's bitmap inside the atlas.
pub Result(Font, Str) font_parse(List(Int) b, Int scale) {
    if (b.len() < atlas_offset()) { return Err("font: short answer"); }
    if (le32(b, 0) != 826689362) { return Err("font: not a font module answer"); }
    Int status = le32(b, 4);
    if (status == 1) { return Err("font: not a TrueType font"); }
    if (status == 2) { return Err("font: pixel size out of range"); }
    if (status != 0) { return Err("font: the glyphs do not fit the atlas"); }
    Int ascent = le32(b, 8);
    Int line = le32(b, 12);
    Int aw = le32(b, 16);
    Int ah = le32(b, 20);
    Int kerns = le32(b, 28);
    if (le32(b, 24) != 95 || aw <= 0 || ah <= 0 || aw > 4096 || kerns < 0 || kerns > 1024) { return Err("font: malformed header"); }
    if (line <= 0 || line > 1024 || ascent < 0 || ascent > line) { return Err("font: malformed metrics"); }
    if (atlas_offset() + aw * ah > b.len()) { return Err("font: atlas overruns the answer"); }
    ListBuf(Int) gb = ListBuf();
    List(Int) glyphs = read_glyphs(b, 0, gb);
    if (!glyphs_ok(glyphs, aw, ah, 0)) { return Err("font: a glyph lies outside the atlas"); }
    Map(Int, Int) none = {};
    return Ok(Font { .scale = if (scale < 1) { 1 } else { scale }, .px = line, .ascent = ascent, .line = line, .glyphs = glyphs,
                     .kern = read_kern(b, kerns, 0, none), .aw = aw, .ah = ah, .atlas = b[atlas_offset()..(atlas_offset() + aw * ah)] });
}

List(Int) read_glyphs(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= 95 * 7) { return acc.finish(); }
    return read_glyphs(b, i + 1, acc.push(le32(b, 32 + i * 4)));
}

Bool glyphs_ok(List(Int) g, Int aw, Int ah, Int i) {
    if (i >= 95) { return true; }
    Int k = i * 7;
    Bool ok = g[k] >= 0 && g[k] <= 1024 && g[k + 3] >= 0 && g[k + 4] >= 0
        && g[k + 5] >= 0 && g[k + 6] >= 0 && g[k + 5] + g[k + 3] <= aw && g[k + 6] + g[k + 4] <= ah
        && g[k + 1] > -1024 && g[k + 1] < 1024 && g[k + 2] > -1024 && g[k + 2] < 2048;
    return ok && glyphs_ok(g, aw, ah, i + 1);
}

Map(Int, Int) read_kern(List(Int) b, Int n, Int i, Map(Int, Int) m) {
    if (i >= n) { return m; }
    Int at = 32 + 95 * 28 + i * 4;
    Int v = (b[at + 2] & 255) | ((b[at + 3] & 255) << 8);
    Int adj = if (v >= 32768) { v - 65536 } else { v };
    return read_kern(b, n, i + 1, m.insert((b[at] & 255) * 256 + (b[at + 1] & 255), adj));
}

/// A tiny atlas answer for tests: every glyph a 2x3 block at the atlas
/// origin, advance 5, and one kerning pair ("AV", -1).
pub List(Int) test_atlas_answer() {
    ListBuf(Int) b = ListBuf();
    ListBuf(Int) h = put_le(put_le(put_le(put_le(put_le(put_le(put_le(put_le(b, 826689362), 0), 10), 14), 4), 4), 95), 1);
    ListBuf(Int) g = test_glyphs(h, 0);
    ListBuf(Int) k = test_zeros(g.push(65).push(86).push(255).push(255), 1023 * 4);
    return test_atlas(k, 0).finish();
}

ListBuf(Int) put_le(ListBuf(Int) b, Int v) { return b.push(v & 255).push((v >> 8) & 255).push((v >> 16) & 255).push((v >> 24) & 255); }
ListBuf(Int) test_glyphs(ListBuf(Int) b, Int i) {
    return if (i >= 95) { b } else { test_glyphs(put_le(put_le(put_le(put_le(put_le(put_le(put_le(b, 5), 0), 2), 2), 3), 0), 0), i + 1) };
}
ListBuf(Int) test_zeros(ListBuf(Int) b, Int n) { return if (n <= 0) { b } else { test_zeros(b.push(0), n - 1) }; }
ListBuf(Int) test_atlas(ListBuf(Int) b, Int i) { return if (i >= 16) { b } else { test_atlas(b.push(255), i + 1) }; }

test "font data len" { List(Int) xs = font_data(); expect(xs.len()).toEqual(1520); }
test "glyph rows read the bitmap" { expect(glyph_row(33, 4)).toEqual(24); expect(glyph_row(10, 4)).toEqual(0); }

test "the built-in font measures 8 pixels a character" {
    Font f = font_builtin();
    expect(text_width_in(f, "abc")).toEqual(24);
    expect(text_height_in(f)).toEqual(16);
    expect(index_at_x(f, "abcd", 13)).toEqual(2);
}

test "an atlas answer parses and measures, kerning included" {
    Font f = font_parse(test_atlas_answer(), 2) else { font_builtin() };
    expect(f.px).toEqual(14);
    expect(f.aw).toEqual(4);
    expect(glyph_field(f, 65, 0)).toEqual(5);
    expect(kern_of(f, 65, 86)).toEqual(-1);
    expect(text_width_device(f, "AV")).toEqual(9);
    expect(text_width_in(f, "AV")).toEqual(5);
    expect(text_height_in(f)).toEqual(7);
    expect(glyph_field(f, 233, 0)).toEqual(5);
}

test "a lying atlas answer is refused" {
    List(Int) good = test_atlas_answer();
    Bool short = match (font_parse(good[0..100], 1)) { Ok(f) => false, Err(e) => true };
    expect(short).toEqual(true);
    // a glyph placed past the atlas's right edge
    List(Int) bad = good.with(32 + 5 * 4, 9);
    Bool outside = match (font_parse(bad, 1)) { Ok(f) => false, Err(e) => e == "font: a glyph lies outside the atlas" };
    expect(outside).toEqual(true);
    Bool notfont = match (font_parse(good.with(4, 1), 1)) { Ok(f) => false, Err(e) => e == "font: not a TrueType font" };
    expect(notfont).toEqual(true);
}

/// The next value of a 31-bit linear congruential generator, for the
/// mutation tests below.
Int lcg(Int x) { return (x * 1103515245 + 12345) % 2147483648; }

/// `n` answers, each a copy of `good` with up to four random bytes
/// replaced by random values and some cut short, fed to `font_parse`:
/// every one must come back as `Ok` or `Err`, never an abort. Returns how
/// many were refused.
Int parse_mutants(List(Int) good, Int n, Int seed, Int refused) {
    if (n <= 0) { return refused; }
    Int s1 = lcg(seed);
    Int s2 = lcg(s1);
    Int s3 = lcg(s2);
    Int s4 = lcg(s3);
    // Mutate the header and glyph records most: that is where lies hide.
    Int span = if (s1 % 4 == 0) { good.len() } else { 32 + 95 * 28 + 8 };
    List(Int) m1 = good.with(s1 % span, s2 % 256);
    List(Int) m2 = if (s2 % 2 == 0) { m1.with(s3 % span, s4 % 256) } else { m1 };
    List(Int) m3 = if (s3 % 3 == 0) { m2.with((s4 / 7) % span, if (s4 % 2 == 0) { 255 } else { 128 }) } else { m2 };
    List(Int) m = if (s4 % 16 == 0) { m3[0..(s1 % m3.len())] } else { m3 };
    Bool no = match (font_parse(m, 1)) { Ok(f) => false, Err(e) => true };
    return parse_mutants(good, n - 1, s4, refused + if (no) { 1 } else { 0 });
}

test "mutated atlas answers are parsed or refused, never an abort" {
    Int refused = parse_mutants(test_atlas_answer(), 400, 7, 0);
    expect(refused > 0).toEqual(true);
}
