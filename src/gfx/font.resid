// font.resid — fonts: the built-in bitmap font and glyph atlases.
//
// A `Font` is either the built-in 8x16 bitmap font (`px` 0), which needs
// nothing, or a glyph atlas the native `font` module rasterized from a
// TrueType file (native/font/). An atlas is made for one device scale:
// its metrics are device pixels, and `text_width` divides them back into
// the logical pixels layout works in. Everything in an atlas came out of
// native code, so `font_parse` checks it as untrusted input before a
// single glyph is drawn.

import "color.resid";

/// A font. For an atlas, `glyphs` holds seven integers per printable ASCII
/// character (advance, x and y offset of its bitmap from the pen and the
/// top of the line, bitmap width and height, position in the atlas), and
/// `kern` maps a pair `a * 256 + b` to its adjustment; all device pixels at
/// `scale`. `atlas` is one coverage byte per pixel, `aw` x `ah`.
pub type Font = {
    Int scale; Int px; Int ascent; Int line;
    List(Int) glyphs; Map(Int, Int) kern;
    Int aw; Int ah; List(Int) atlas;
};

/// The built-in 8x16 bitmap font.
pub Font font_builtin() {
    Map(Int, Int) none = {};
    return Font { .scale = 1, .px = 0, .ascent = 12, .line = 16, .glyphs = [], .kern = none, .aw = 0, .ah = 0, .atlas = [] };
}

/// Whether `f` is the built-in font.
pub Bool font_is_builtin(Font f) { return f.px == 0; }

// ─── Built-in bitmap font ───────────────────────────────────────────

