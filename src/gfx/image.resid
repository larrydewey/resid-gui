import "canvas.resid";
import "color.resid";

pub type Image = { Int w; Int h; List(Int) px; };

/// A transparent image of the given size.
pub Image image_new(Int w, Int h) {
    ListBuf(Int) b = ListBuf();
    return Image { .w = w, .h = h, .px = canvas_fill(0, w * h * 4, b) };
}

/// Draw `im` over `c` with its top-left corner at (`x0`, `y0`), clipped to
/// `clip` and to the canvas. Each pixel is laid over what is there by its
/// alpha, so transparent parts of an image show the window behind them.
pub Canvas blit_clip(Canvas c, Image im, Int x0, Int y0, Rect clip) {
    Rect a = rect_intersect(rect_intersect(Rect { .x = x0, .y = y0, .w = im.w, .h = im.h }, clip), canvas_bounds(c));
    if (rect_is_empty(a) || im.px.len() < im.w * im.h * 4) { return c; }
    return blit_rows(c, im, x0, y0, a, a.y, a.x);
}

Canvas blit_rows(Canvas c, Image im, Int x0, Int y0, Rect a, Int y, Int x) {
    if (y >= a.y + a.h) { return c; }
    if (x >= a.x + a.w) { return blit_rows(c, im, x0, y0, a, y + 1, a.x); }
    Int s = ((y - y0) * im.w + (x - x0)) * 4;
    Color col = Color { .b = im.px[s], .g = im.px[s + 1], .r = im.px[s + 2], .a = 255 };
    return blit_rows(blend_pixel_clip(c, x, y, col, im.px[s + 3], a), im, x0, y0, a, y, x + 1);
}

/// `blit_clip` with each image pixel drawn as a `k` x `k` block.
pub Canvas blit_scaled(Canvas c, Image im, Int x0, Int y0, Rect clip, Int k) {
    if (k <= 1) { return blit_clip(c, im, x0, y0, clip); }
    if (im.px.len() < im.w * im.h * 4) { return c; }
    return blit_blocks(c, im, x0, y0, clip, k, 0, 0);
}

Canvas blit_blocks(Canvas c, Image im, Int x0, Int y0, Rect clip, Int k, Int i, Int j) {
    if (i >= im.h) { return c; }
    if (j >= im.w) { return blit_blocks(c, im, x0, y0, clip, k, i + 1, 0); }
    Int s = (i * im.w + j) * 4;
    Color col = Color { .b = im.px[s], .g = im.px[s + 1], .r = im.px[s + 2], .a = 255 };
    Canvas next = if (im.px[s + 3] >= 255) { fill_rect_clip(c, Rect { .x = x0 + j * k, .y = y0 + i * k, .w = k, .h = k }, col, clip) }
                  else { blend_rect(c, x0 + j * k, y0 + i * k, k, col, im.px[s + 3], clip, 0) };
    return blit_blocks(next, im, x0, y0, clip, k, i, j + 1);
}

Canvas blend_rect(Canvas c, Int x, Int y, Int k, Color col, Int a, Rect clip, Int i) {
    if (i >= k * k) { return c; }
    return blend_rect(blend_pixel_clip(c, x + i % k, y + i / k, col, a, clip), x, y, k, col, a, clip, i + 1);
}

/// `blit_clip` clipped to the canvas alone.
pub Canvas blit_at(Canvas c, Image im, Int x0, Int y0) {
    return blit_clip(c, im, x0, y0, canvas_bounds(c));
}

test "image shape" {
    Image im = image_new(2, 2);
    expect(im.px.len()).toEqual(16);
    Canvas c = canvas_new(4, 4);
    Canvas c2 = blit_at(c, im, 1, 1);
    expect(c2.px.len()).toEqual(64);
    Image red = Image { .w = 1, .h = 1, .px = [0, 0, 255, 255] };
    Image clear = Image { .w = 1, .h = 1, .px = [0, 0, 255, 0] };
    expect(pixel_at(blit_at(fill_rect(canvas_new(1, 1), Rect { .x = 0, .y = 0, .w = 1, .h = 1 }, rgb(0, 9, 0)), clear, 0, 0), 0, 0).g).toEqual(9);
    Canvas c3 = blit_at(canvas_new(3, 3), red, 1, 1);
    expect(pixel_at(c3, 1, 1).r).toEqual(255);
    expect(pixel_at(c3, 0, 0).r).toEqual(0);
}

// ─── Decoded images ─────────────────────────────────────────────────

Int img_le32(List(Int) b, Int i) {
    return (b[i] & 255) | ((b[i + 1] & 255) << 8) | ((b[i + 2] & 255) << 16) | ((b[i + 3] & 255) << 24);
}

/// An image from the native `image` module's answer (layout in
/// native/image/image.c): magic, status, width, height, then blue, green,
/// red and alpha bytes. The answer came from native code, so the size is
/// checked against what arrived before a pixel is used.
pub Result(Image, Str) image_parse(List(Int) b) {
    if (b.len() < 16 || img_le32(b, 0) != 826885970) { return Err("image: not an image module answer"); }
    Int status = img_le32(b, 4);
    if (status == 2) { return Err("image: too large (at most 4096 pixels a side and 16 MB of pixels)"); }
    if (status != 0) { return Err("image: not a PNG, JPEG, BMP, GIF or TGA image"); }
    Int w = img_le32(b, 8);
    Int h = img_le32(b, 12);
    if (w <= 0 || h <= 0 || w > 4096 || h > 4096 || 16 + w * h * 4 > b.len()) { return Err("image: malformed answer"); }
    return Ok(Image { .w = w, .h = h, .px = b[16..(16 + w * h * 4)] });
}

test "an image answer parses, and a lying one is refused" {
    List(Int) ok = [82, 71, 73, 49, 0, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 2, 3, 4];
    Image im = image_parse(ok) else { image_new(0, 0) };
    expect(im.w).toEqual(1);
    expect(im.px[2]).toEqual(3);
    Bool big = match (image_parse(ok.with(8, 9))) { Ok(i) => false, Err(e) => e == "image: malformed answer" };
    expect(big).toEqual(true);
    Bool bad = match (image_parse(ok.with(4, 1))) { Ok(i) => false, Err(e) => true };
    expect(bad).toEqual(true);
}
