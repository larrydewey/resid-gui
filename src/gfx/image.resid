import "canvas.resid";
import "color.resid";

pub type Image = { Int w; Int h; List(Int) px; };

/// A transparent image of the given size.
pub Image image_new(Int w, Int h) {
    ListBuf(Int) b = ListBuf();
    return Image { .w = w, .h = h, .px = canvas_fill(0, w * h * 4, b) };
}

/// Copy `im` onto `c` with its top-left corner at (`x0`, `y0`), clipped to
/// `clip` and to the canvas. Pixels are copied, not blended.
pub Canvas blit_clip(Canvas c, Image im, Int x0, Int y0, Rect clip) {
    Rect a = rect_intersect(rect_intersect(Rect { .x = x0, .y = y0, .w = im.w, .h = im.h }, clip), canvas_bounds(c));
    if (rect_is_empty(a) || im.px.len() < im.w * im.h * 4) { return c; }
    Int ww = c.w;
    Int hh = c.h;
    return Canvas { .w = ww, .h = hh, .px = blit_rows(c.px, ww, im, x0, y0, a, a.y, a.x) };
}

List(Int) blit_rows(List(Int) px, Int ww, Image im, Int x0, Int y0, Rect a, Int y, Int x) {
    if (y >= a.y + a.h) { return px; }
    if (x >= a.x + a.w) { return blit_rows(px, ww, im, x0, y0, a, y + 1, a.x); }
    Int d = (y * ww + x) * 4;
    Int s = ((y - y0) * im.w + (x - x0)) * 4;
    return blit_rows(px.with(d, im.px[s]).with(d + 1, im.px[s + 1]).with(d + 2, im.px[s + 2]).with(d + 3, im.px[s + 3]), ww, im, x0, y0, a, y, x + 1);
}

/// `blit_clip` with each image pixel drawn as a `k` x `k` block.
pub Canvas blit_scaled(Canvas c, Image im, Int x0, Int y0, Rect clip, Int k) {
    if (k <= 1) { return blit_clip(c, im, x0, y0, clip); }
    if (im.px.len() < im.w * im.h * 4) { return c; }
    return blit_blocks(c, im, x0, y0, clip, k, 0, 0);
}

Canvas blit_blocks(Canvas c, Image im, Int x0, Int y0, Rect clip, Int k, Int i, Int j) {
    if (i >= im.h) { return c; }
    if (j >= im.w) { return blit_blocks(c, im, x0, y0, clip, k, i + 1, 0); }
    Int s = (i * im.w + j) * 4;
    Color col = Color { .b = im.px[s], .g = im.px[s + 1], .r = im.px[s + 2], .a = im.px[s + 3] };
    return blit_blocks(fill_rect_clip(c, Rect { .x = x0 + j * k, .y = y0 + i * k, .w = k, .h = k }, col, clip), im, x0, y0, clip, k, i, j + 1);
}

/// `blit_clip` clipped to the canvas alone.
pub Canvas blit_at(Canvas c, Image im, Int x0, Int y0) {
    return blit_clip(c, im, x0, y0, canvas_bounds(c));
}

test "image shape" {
    Image im = image_new(2, 2);
    expect(im.px.len()).toEqual(16);
    Canvas c = canvas_new(4, 4);
    Canvas c2 = blit_at(c, im, 1, 1);
    expect(c2.px.len()).toEqual(64);
    Image red = Image { .w = 1, .h = 1, .px = [0, 0, 255, 255] };
    Canvas c3 = blit_at(canvas_new(3, 3), red, 1, 1);
    expect(pixel_at(c3, 1, 1).r).toEqual(255);
    expect(pixel_at(c3, 0, 0).r).toEqual(0);
}

// ─── Native image decode (optional, requires native_image capability) ───

// Native module binding - returns packed image bytes
// Result format: [w][h][channels][pixels...] (BGRA premultiplied)
// @link("image_decode") Bytes(16777216) image_decode_native(Bytes(16777216) data, Int len) {}

/// Result of native image decode
pub type DecodedImage = {
    Int w;
    Int h;
    Int channels;
    List(Int) pixels; // premultiplied BGRA
};

/// Unpack native image decode result
pub DecodedImage unpack_image(Bytes(16777216) packed, Int len) {
    if (len < 12) { return empty_image(); }
    
    Int w = packed[0] | (packed[1] << 8) | (packed[2] << 16) | (packed[3] << 24);
    Int h = packed[4] | (packed[5] << 8) | (packed[6] << 16) | (packed[7] << 24);
    Int channels = packed[8] | (packed[9] << 8) | (packed[10] << 16) | (packed[11] << 24);
    
    List(Int) pixels = unpack_pixels(packed, len, 12, w * h * channels, 0, []);
    
    return DecodedImage { .w = w, .h = h, .channels = channels, .pixels = pixels };
}

List(Int) unpack_pixels(Bytes(16777216) packed, Int len, Int offset, Int count, Int i, List(Int) acc) {
    if (i >= count) { return acc; }
    if (offset >= len) { return acc; }
    return unpack_pixels(packed, len, offset + 1, count, i + 1, acc.concat([packed[offset]]));
}

DecodedImage empty_image() {
    return DecodedImage { .w = 0, .h = 0, .channels = 0, .pixels = [] };
}

/// Convert DecodedImage to Image (Canvas-compatible)
pub Image decoded_to_image(DecodedImage d) {
    return Image { .w = d.w, .h = d.h, .px = d.pixels };
}

test "unpack empty image" {
    DecodedImage d = empty_image();
    expect(d.w).toEqual(0);
    expect(d.h).toEqual(0);
}