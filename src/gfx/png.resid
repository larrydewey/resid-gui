// PNG encoder in pure Resid (minimal, for golden-image tests)
// Based on RFC 2083 / ISO/IEC 15948 - only supports truecolor (RGB) + alpha, no compression

import "color.resid";
import "canvas.resid";

pub type Png = { List(Int) bytes; };

/// The CRC-32 lookup table for the reflected polynomial 0xEDB88320,
/// computed rather than written out (a hand-copied table had nine wrong
/// entries); the compiler folds it.
pub List(Int) crc32_table() { ListBuf(Int) b = ListBuf(); return crc_table_at(0, b); }

List(Int) crc_table_at(Int n, ListBuf(Int) b) {
    if (n >= 256) { return b.finish(); }
    return crc_table_at(n + 1, b.push(crc_entry(n, 0)));
}

Int crc_entry(Int c, Int k) {
    if (k >= 8) { return c; }
    return crc_entry(if ((c & 1) != 0) { 3988292384 ^ (c >> 1) } else { c >> 1 }, k + 1);
}

Int crc32_update(Int crc, Int b) {
    return ((crc >> 8) ^ crc32_table()[(crc ^ b) & 255]) & 4294967295;
}

/// The CRC-32 of `data` (ISO 3309, as PNG chunks use it).
pub Int crc32(List(Int) data) { return crc32_loop(data, 0, 4294967295) ^ 4294967295; }

Int crc32_loop(List(Int) data, Int i, Int crc) {
    if (i >= data.len()) { return crc; }
    return crc32_loop(data, i + 1, crc32_update(crc, data[i] & 255));
}

/// An empty byte builder.
ListBuf(Int) lb() { ListBuf(Int) b = ListBuf(); return b; }

ListBuf(Int) be32(ListBuf(Int) b, Int v) { return b.push((v >> 24) & 255).push((v >> 16) & 255).push((v >> 8) & 255).push(v & 255); }

/// A chunk: length, type, data, CRC over type and data.
List(Int) chunk(List(Int) type, List(Int) data) {
    List(Int) td = type.concat(data);
    return be32(lb(), data.len()).finish().concat(td).concat(be32(lb(), crc32(td)).finish());
}

/// A PNG of the canvas: 8-bit RGBA, every row filter 0, the image data in
/// stored (uncompressed) deflate blocks. Pixels are exact, so two canvases
/// that differ in one byte give different files — what a golden test needs.
pub Png canvas_to_png(Canvas c) {
    List(Int) sig = [137, 80, 78, 71, 13, 10, 26, 10];
    List(Int) ihdr = be32(be32(lb(), c.w), c.h).finish().concat([8, 6, 0, 0, 0]);
    List(Int) raw = rgba_rows(c, 0, lb());
    return Png { .bytes = sig.concat(chunk([73, 72, 68, 82], ihdr)).concat(chunk([73, 68, 65, 84], zlib_stored(raw))).concat(chunk([73, 69, 78, 68], [])) };
}

/// Each row as a filter byte of 0 and the row's pixels in RGBA order.
List(Int) rgba_rows(Canvas c, Int y, ListBuf(Int) b) {
    if (y >= c.h) { return b.finish(); }
    return rgba_rows(c, y + 1, rgba_row(c, y, 0, b.push(0)));
}

ListBuf(Int) rgba_row(Canvas c, Int y, Int x, ListBuf(Int) b) {
    if (x >= c.w) { return b; }
    Int v = (Int)c.px[y * c.w + x];
    return rgba_row(c, y, x + 1, b.push((v >> 16) & 255).push((v >> 8) & 255).push(v & 255).push((v >> 24) & 255));
}

/// A zlib stream (RFC 1950) holding `data` in stored deflate blocks of at
/// most 65535 bytes (RFC 1951 §3.2.4), then its Adler-32.
pub List(Int) zlib_stored(List(Int) data) {
    ListBuf(Int) b = stored_blocks(lb().push(120).push(1), data, 0);
    return be32(b, adler32(data, 0, 1)).finish();
}

ListBuf(Int) stored_blocks(ListBuf(Int) b, List(Int) data, Int at) {
    Int n0 = data.len() - at;
    Int n = if (n0 > 65535) { 65535 } else { n0 };
    Bool last = at + n >= data.len();
    ListBuf(Int) h = b.push(if (last) { 1 } else { 0 }).push(n & 255).push((n >> 8) & 255).push((65535 - n) & 255).push(((65535 - n) >> 8) & 255);
    ListBuf(Int) d = put_range(h, data, at, at + n);
    return if (last) { d } else { stored_blocks(d, data, at + n) };
}

ListBuf(Int) put_range(ListBuf(Int) b, List(Int) xs, Int i, Int stop) { return if (i >= stop) { b } else { put_range(b.push(xs[i] & 255), xs, i + 1, stop) }; }

Int adler32(List(Int) data, Int i, Int adler) {
    if (i >= data.len()) { return adler; }
    Int s1 = ((adler & 65535) + (data[i] & 255)) % 65521;
    Int s2 = (((adler >> 16) & 65535) + s1) % 65521;
    return adler32(data, i + 1, (s2 << 16) | s1);
}

/// Byte-for-byte equality of two PNGs.
pub Bool png_equal(Png a, Png b) {
    return list_equal(a.bytes, b.bytes, 0);
}

Bool list_equal(List(Int) a, List(Int) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (a[i] != b[i]) { return false; }
    return list_equal(a, b, i + 1);
}

test "crc32 matches the standard check value" {
    expect(crc32_table().len()).toEqual(256);
    // CRC-32 of "123456789" is 0xCBF43926.
    expect(crc32([49, 50, 51, 52, 53, 54, 55, 56, 57])).toEqual(3421780262);
    // The IEND chunk's CRC is fixed: 0xAE426082.
    expect(crc32([73, 69, 78, 68])).toEqual(2923585666);
    expect(crc32_table()[163]).toEqual(1340076626);           // 0x4FDFF252
    expect(crc32_table()[255]).toEqual(755167117);            // 0x2D02EF8D
}

test "a PNG has its signature, chunks and RGBA pixels" {
    Canvas c = fill_rect(canvas_new(2, 2), Rect { .x = 0, .y = 0, .w = 2, .h = 2 }, Color { .r = 255, .g = 1, .b = 2, .a = 255 });
    Png p = canvas_to_png(c);
    expect(p.bytes[0]).toEqual(137);
    expect(p.bytes[12]).toEqual(73);                 // "IHDR"
    // the first pixel, after the zlib header, the block header and the
    // filter byte, is red first
    Int idat = 8 + 25;
    expect(p.bytes[idat + 4]).toEqual(73);           // "IDAT"
    expect(p.bytes[idat + 8 + 2 + 5 + 1]).toEqual(255);
    expect(p.bytes[idat + 8 + 2 + 5 + 2]).toEqual(1);
    expect(p.bytes[idat + 8 + 2 + 5 + 3]).toEqual(2);
    expect(png_equal(p, canvas_to_png(c))).toEqual(true);
}

test "large images split into stored blocks" {
    List(Int) z = zlib_stored(canvas_fill(0, 70000, lb()));
    // header, two blocks of 5-byte headers, data, Adler-32
    expect(z.len()).toEqual(2 + 5 + 5 + 70000 + 4);
    expect(z[2]).toEqual(0);
    expect(z[2 + 5 + 65535]).toEqual(1);
}
