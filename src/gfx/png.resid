Int crc32_update(Int crc, Int b) {
    return (crc >> 8) ^ crc32_table()[(crc ^ b) & 0xFF];
}

Int crc32(List(Int) data, Int len) {
    return crc32_loop(data, 0, len, 0xFFFFFFFF) ^ 0xFFFFFFFF;
}

Int crc32_loop(List(Int) data, Int i, Int len, Int crc) {
    if (i >= len) { return crc; }
    return crc32_loop(data, i + 1, len, crc32_update(crc, data[i]));
}

// Write 32-bit big-endian
List(Int) write_be32(List(Int) buf, Int val) {
    return buf.concat([(val >> 24) & 0xFF, (val >> 16) & 0xFF, (val >> 8) & 0xFF, val & 0xFF]);
}

// Write chunk: length (4), type (4), data, CRC (4)
List(Int) write_chunk(List(Int) buf, Str type, List(Int) chunk_data) {
    List(Int) out1 = write_be32(buf, chunk_data.len());
    List(Int) out2 = out1.concat(str_to_bytes(type));
    List(Int) out3 = out2.concat(chunk_data);
    Int crc = crc32(str_to_bytes(type).concat(chunk_data), 4 + chunk_data.len());
    return write_be32(out3, crc);
}

List(Int) str_to_bytes(Str s) {
    return str_to_bytes_loop(s, 0, s.len(), []);
}

List(Int) str_to_bytes_loop(Str s, Int i, Int len, List(Int) acc) {
    if (i >= len) { return acc; }
    return str_to_bytes_loop(s, i + 1, len, acc.concat([str_char_at(s, i)]));
}

// Filter type 0 (None) - no filtering
List(Int) apply_filter_none(List(Int) scanline) {
    return [0].concat(scanline);
}

// Encode canvas as PNG (RGBA, no compression - IDAT is just filtered raw data)
pub Png canvas_to_png(Canvas c) {
    Int w = c.w;
    Int h = c.h;
    Int stride = w * 4;
    
    // Build raw image data (top-to-bottom, each row: filter byte + RGBA)
    List(Int) raw = build_raw_rows(c.px, h, stride, 0, []);
    
    // Build PNG
    List(Int) png0 = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]; // Signature
    
    // IHDR chunk
    List(Int) ihdr0 = write_be32(write_be32([], w), h);
    List(Int) ihdr1 = ihdr0.concat([8, 6, 0, 0, 0]); // bit depth=8, color type=6 (RGBA), compression=0, filter=0, interlace=0
    List(Int) png1 = write_chunk(png0, "IHDR", ihdr1);
    
    // IDAT chunk
    List(Int) idat_data = zlib_wrap(raw);
    List(Int) png2 = write_chunk(png1, "IDAT", idat_data);
    
    // IEND chunk
    List(Int) png3 = write_chunk(png2, "IEND", []);
    
    return Png { .bytes = png3 };
}

List(Int) build_raw_rows(List(Int) px, Int h, Int stride, Int y, List(Int) acc) {
    if (y >= h) { return acc; }
    Int row_start = y * stride;
    List(Int) scanline = slice_bytes(px, row_start, stride, 0, []);
    List(Int) filtered = apply_filter_none(scanline);
    return build_raw_rows(px, h, stride, y + 1, acc.concat(filtered));
}

List(Int) slice_bytes(List(Int) src, Int start, Int len, Int i, List(Int) acc) {
    if (i >= len) { return acc; }
    return slice_bytes(src, start, len, i + 1, acc.concat([src[start + i]]));
}

// Minimal zlib wrapper for uncompressed data
List(Int) zlib_wrap(List(Int) data) {
    // zlib header: 0x78 0x01 (RFC 1950)
    List(Int) out0 = [0x78, 0x01];
    
    // Uncompressed blocks (RFC 1951)
    // We'll use one block since data is small
    Int len = data.len();
    // Block header: BFINAL=1, BTYPE=00 (uncompressed)
    List(Int) out1 = out0.concat([0x01]); // BFINAL=1, BTYPE=00
    // LEN (little-endian)
    List(Int) out2 = out1.concat([len & 0xFF, (len >> 8) & 0xFF]);
    // NLEN = ~LEN
    List(Int) out3 = out2.concat([(~len) & 0xFF, ((~len) >> 8) & 0xFF]);
    // Data
    List(Int) out4 = out3.concat(data);
    
    // ADLER32
    Int adler = adler32(data, 0, len, 1);
    List(Int) out5 = out4.concat([(adler >> 24) & 0xFF, (adler >> 16) & 0xFF, (adler >> 8) & 0xFF, adler & 0xFF]);
    
    return out5;
}

Int adler32(List(Int) data, Int i, Int len, Int adler) {
    if (i >= len) { return adler; }
    Int s1 = adler & 0xFFFF;
    Int s2 = (adler >> 16) & 0xFFFF;
    Int s1_new = (s1 + data[i]) % 65521;
    Int s2_new = (s2 + s1_new) % 65521;
    return adler32(data, i + 1, len, (s2_new << 16) | s1_new);
}

// Compare two PNGs by SHA-256 (simplified - just compare bytes for now)
pub Bool png_equal(Png a, Png b) {
    return list_equal(a.bytes, b.bytes, 0);
}

Bool list_equal(List(Int) a, List(Int) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (a[i] != b[i]) { return false; }
    return list_equal(a, b, i + 1);
}

test "crc32 table len" {
    expect(crc32_table().len()).toEqual(256);
}

test "png roundtrip" {
    Canvas c0 = canvas_new(2, 2);
    Canvas c1 = fill_rect(c0, Rect { .x = 0, .y = 0, .w = 2, .h = 2 }, Color { .r = 255, .g = 0, .b = 0, .a = 255 });
    Png p = canvas_to_png(c1);
    expect(p.bytes.len() > 0).toEqual(true);
    expect(p.bytes[0]).toEqual(0x89);
    expect(p.bytes[1]).toEqual(0x50);
}