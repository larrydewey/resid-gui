// PNG encoder in pure Resid (minimal, for golden-image tests)
// Based on RFC 2083 / ISO/IEC 15948 - only supports truecolor (RGB) + alpha, no compression

import "color.resid";
import "canvas.resid";

pub type Png = { List(Int) bytes; };

