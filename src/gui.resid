// gui.resid — the program-facing entry point of resid-gui.
//
// A program declares an `App(M)` instance and calls `gui_run`. The library
// owns the display connection, the frame loop and the pixels; the program
// owns the model. Nothing here holds ambient authority: every function
// that reaches a display builtin or the clock says so with @requires. The
// loop also needs `declassify`: editing a `PasswordInput` splices each
// keystroke into its `Secret(Str)` text (`pw_splice`, ui/input.resid),
// the library's one declassification; so a program's `main` grants it.
//
// The loop is written once against `Backend(B)` and runs over whichever
// backend could open a window: Wayland when a compositor is reachable,
// X11 otherwise. Each turn it
//   1. presents the pixels changed since the last present, when the
//      backend has a free buffer,
//   2. waits for input until the next timer is due,
//   3. folds every event through the widgets (`ui_event`) and `update`,
//   4. fires the caret-blink timer (`FrameTick`),
//   5. re-runs `view` and `paint` and diffs the display list against the
//      previous one; the rectangles that differ are the damage, and only
//      they are rasterized when the frame is presented.
//
// There is no frame buffer in the loop: a frame is its display list, and a
// backend rasterizes the damaged rectangles straight into the shared
// buffer it is about to show.

import "app.resid";
import "backend/backend.resid";
import "x11/x11.resid";
import "wayland/wayland.resid";
import "gfx/color.resid";
import "gfx/canvas.resid";
import "gfx/font.resid";
import "gfx/draw.resid";
import "gfx/raster.resid";
import "ui/layout.resid";
import "ui/paint.resid";
import "ui/damage.resid";
import "ui/input.resid";
import "ui/state.resid";
import "ui/timer.resid";
import "ui/semantics.resid";
import "ui/theme.resid";
import "a11y/atspi.resid";
import "rsp/client.resid";
import "rsp/wire.resid";

/// The caret blinks, and `FrameTick` arrives, this often.
pub Int blink_ms() { return 500; }

/// Everything the loop carries between turns. `ops` is the frame last
/// painted, in logical pixels, for a window of `w` x `h` device pixels at
/// `scale`; `pending` is the device damage not yet presented.
type Loop(M) = {
    M model; UiState ui; Widget view;
    List(DrawOp) ops; Int w; Int h; Int scale;
    List(Rect) pending; Timer blink; Bool done;
    List(Font) fonts; Font font;
    Bool rec; List(Event) log;
    A11y a11y;
};

/// The font to draw at `scale`: the atlas made for that scale, else one
/// made for a scale that divides it (its pixels are repeated), else the
/// first atlas, else the built-in font.
pub Font pick_font(List(Font) fs, Int scale) {
    if (fs.len() == 0) { return font_builtin(); }
    return pick_at(fs, scale, 0, fs[0]);
}

Font pick_at(List(Font) fs, Int scale, Int i, Font best) {
    if (i >= fs.len()) { return best; }
    Font f = fs[i];
    if (f.scale == scale) { return f; }
    Bool better = scale % f.scale == 0 && (scale % best.scale != 0 || f.scale > best.scale);
    return pick_at(fs, scale, i + 1, if (better) { f } else { best });
}

/// Milliseconds on the monotonic clock.
@requires(clock(readonly))
Int now_ms() { return clock.monotonic_ns() / 1000000; }

/// Open a window and run the program's `App(M)` instance until the window
/// is closed. Returns the process exit status: 0 after a clean close, 1
/// when no display could be opened.
@needs(App(M))
@requires(display, accessibility, clock(readonly), declassify)
pub Int gui_run(WindowOptions opts) { return gui_run_with(opts, []); }

/// `gui_run` with text in TrueType fonts: glyph atlases the program made
/// with the native font module (native/font/font.resid), one per device
/// scale it wants sharp. An empty list means the built-in bitmap font.
@needs(App(M))
@requires(display, accessibility, clock(readonly), declassify)
pub Int gui_run_with(WindowOptions opts, List(Font) fonts) {
    M m0 = init();
    return gui_run_model(opts, m0, fonts);
}

/// `gui_run_with` starting from `m0` instead of `init()`: for a program
/// whose first model depends on what `main` read (a file, the arguments).
@needs(App(M))
@requires(display, accessibility, clock(readonly), declassify)
pub Int gui_run_model(WindowOptions opts, M m0, List(Font) fonts) {
    Int rfd = resid_disp_connect_rsp();
    if (rfd >= 0) {
        Rsp r = rsp_start_on(rfd, opts);
        if (r.alive) { return gui_run_on(r, m0, fonts); }
        eprintln(r.err);
        return 1;
    }
    Wl w = wl_start(opts);
    if (w.alive) { return gui_run_on(w, m0, fonts); }
    Bool wl_tried = str_len(w.err) > 0;
    X11 x = x11_start(opts);
    if (x.alive) { return gui_run_on(x, m0, fonts); }
    if (wl_tried) { eprintln(w.err); }
    eprintln(if (str_len(x.err) > 0) { x.err } else { "resid-gui: no display" });
    return 1;
}

/// `gui_run_model`, recording: on whichever display opens (a host shell,
/// Wayland, X11), with the events `update` saw kept. `opened` is false
/// when no display could be opened.
@needs(App(M))
@requires(display, accessibility, clock(readonly), declassify)
pub Recorded(M) gui_run_model_recorded(WindowOptions opts, M m0, List(Font) fonts) {
    Int rfd = resid_disp_connect_rsp();
    if (rfd >= 0) {
        Rsp r = rsp_start_on(rfd, opts);
        if (r.alive) { return gui_run_recorded(r, m0, fonts); }
        eprintln(r.err);
        return Recorded { .opened = false, .model = m0, .log = [] };
    }
    Wl w = wl_start(opts);
    if (w.alive) { return gui_run_recorded(w, m0, fonts); }
    X11 x = x11_start(opts);
    if (x.alive) { return gui_run_recorded(x, m0, fonts); }
    eprintln(if (str_len(x.err) > 0) { x.err } else { "resid-gui: no display" });
    return Recorded { .opened = false, .model = m0, .log = [] };
}

/// `gui_run` over X11 only, for testing the X11 backend on a Wayland
/// desktop (Xwayland).
@needs(App(M))
@requires(display, accessibility, clock(readonly), declassify)
pub Int gui_run_x11(WindowOptions opts) {
    X11 x = x11_start(opts);
    M m0 = init();
    if (x.alive) { return gui_run_on(x, m0, []); }
    eprintln(x.err);
    return 1;
}

/// Run the program from model `m0` on an opened backend, with text in
/// `fonts` (see `gui_run_with`).
@needs(App(M), Backend(B))
@requires(display, accessibility, clock(readonly), declassify)
pub Int gui_run_on(B b, M m0, List(Font) fonts) {
    Widget v0 = view(m0);
    Loop(M) st = Loop {
        .model = m0, .ui = ui_new(), .view = v0, .ops = [], .w = 0, .h = 0, .scale = 0,
        .pending = [], .blink = timer_start(0, blink_ms(), now_ms()), .done = false,
        .fonts = fonts, .font = pick_font(fonts, be_scale(b)), .rec = false, .log = [], .a11y = a11y_start("resid-gui")
    };
    return gui_loop(b, st);
}

@needs(App(M), Backend(B))
@requires(display, clock(readonly), declassify)
Int gui_loop(B b, Loop(M) st0) {
    Loop(M) end = run_loop(b, st0);
    return 0;
}

/// What a recorded run leaves: the last model, and every event `update`
/// saw, in order (`Closed` and the caret's `FrameTick`s left out), for
/// src/dev/timeline.resid.
pub type Recorded(M) = { Bool opened; M model; List(Event) log; };

/// `gui_run_on`, keeping the events `update` saw.
@needs(App(M), Backend(B))
@requires(display, accessibility, clock(readonly), declassify)
pub Recorded(M) gui_run_recorded(B b, M m0, List(Font) fonts) {
    Widget v0 = view(m0);
    Loop(M) st = Loop {
        .model = m0, .ui = ui_new(), .view = v0, .ops = [], .w = 0, .h = 0, .scale = 0,
        .pending = [], .blink = timer_start(0, blink_ms(), now_ms()), .done = false,
        .fonts = fonts, .font = pick_font(fonts, be_scale(b)), .rec = true, .log = [], .a11y = a11y_start("resid-gui")
    };
    Loop(M) end = run_loop(b, st);
    return Recorded { .opened = true, .model = end.model, .log = end.log };
}

@needs(App(M), Backend(B))
@requires(display, clock(readonly), declassify)
Loop(M) run_loop(B b, Loop(M) st0) {
    if (st0.done || !be_alive(b)) {
        _ = be_close(b);
        return st0;
    }
    Loop(M) st = render(b, st0);
    Int s = be_scale(b);
    // each node carries its token, so a reader's action on a number from
    // an older tree that now names another widget is refused (R6-3, R6-4)
    List(SemNode) sem = with_tokens(semantics_in(st.view, Rect { .x = 0, .y = 0, .w = be_width(b) / s, .h = be_height(b) / s }, st.ui, st.font),
                                    node_tokens(st.view));
    B bs = be_semantics(b, sem);
    A11y a1 = a11y_tree(st.a11y, sem);
    Bool show = st.pending.len() > 0 && be_ready(bs);
    B b2 = if (show) { be_present(bs, Frame { .ops = st.ops, .scale = st.scale, .font = st.font }, st.pending) } else { bs };
    Loop(M) st2 = with_a11y(if (show) { with_pending(st, []) } else { st }, a1);
    Int wait0 = timer_wait(st2.blink, now_ms());
    Int wait = if (wait0 < 0) { 1000 } else { wait0 };
    // With a screen reader's bus open, wait on it and the display together,
    // then read the display without waiting: a reader's question is
    // answered at once, not at the next caret blink.
    Int ms = turn_ms(b2, a11y_fd(a1), a11y_alive(a1), wait);
    Pumped(B) p = be_pump(b2, ms);
    A11yStep ax = a11y_pump(a1);
    // A reader's actions first, while the view is the one its tree was
    // made from; each keeps a print of the widget it named, and is
    // dropped if an earlier event has changed that widget or those
    // numbered before it (R4-2, HP-6). Then the display's events, whose
    // Assists (a shell's reader) are printed and checked the same way
    // (R6-4).
    List(Int) prints = turn_prints(ax.events, p.events, st2.view);
    Loop(M) st3 = fold_events(ax.events.concat(p.events), prints, 0, with_a11y(st2, ax.a), be_scale(p.b), be_width(p.b), be_height(p.b));
    Loop(M) st4 = tick(st3, now_ms());
    return run_loop(p.b, st4);
}

/// How long this turn waits for input before pumping: not at all while
/// the backend holds whole messages it has not handled (polling its
/// descriptor cannot see them, so a wait there would hold a backlog to
/// one pump per caret blink); with a screen reader's bus open, it waits
/// on the display and the bus together.
@needs(Backend(B))
@requires(display)
Int turn_ms(B b, Int afd, Bool a11y, Int wait) {
    Int ms = if (be_pending(b)) { 0 } else { wait };
    return if (a11y) { wait_both(be_fd(b), afd, ms) } else { ms };
}

/// Wait up to `ms` for either descriptor; 0 afterwards, so the backend
/// reads what came without waiting again.
@requires(display)
Int wait_both(Int dfd, Int afd, Int ms) {
    List(Int) fds = if (dfd >= 0) { [dfd, afd] } else { [afd] };
    _ = resid_disp_poll(fds, if (dfd >= 0) { [1, 1] } else { [1] }, ms);
    return 0;
}

@needs(App(M))
Loop(M) with_a11y(Loop(M) st, A11y a) {
    return Loop { .model = st.model, .ui = st.ui, .view = st.view, .ops = st.ops, .w = st.w, .h = st.h, .scale = st.scale,
                  .pending = st.pending, .blink = st.blink, .done = st.done, .fonts = st.fonts, .font = st.font,
                  .rec = st.rec, .log = st.log, .a11y = a };
}

/// Paint the current view and add what changed to the pending damage. A
/// new window size or scale damages the whole window.
@needs(App(M), Backend(B))
Loop(M) render(B b, Loop(M) st) {
    Int w = be_width(b);
    Int h = be_height(b);
    Int s = be_scale(b);
    Font f = if (s == st.scale) { st.font } else { pick_font(st.fonts, s) };
    List(DrawOp) ops = paint_with(st.view, Rect { .x = 0, .y = 0, .w = w / s, .h = h / s }, st.ui, f, theme_from(theme_default(), be_hints(b)));
    Bool fresh = st.w != w || st.h != h || st.scale != s;
    Rect all = Rect { .x = 0, .y = 0, .w = w, .h = h };
    List(Rect) dmg = if (fresh) { [all] } else { scale_all(damage_rects_in(st.ops, ops, f), s, 0, ListBuf()) };
    return Loop {
        .model = st.model, .ui = st.ui, .view = st.view, .ops = ops, .w = w, .h = h, .scale = s,
        .pending = rects_clip(if (fresh) { dmg } else { rects_merge(st.pending, dmg) }, all), .blink = st.blink, .done = st.done,
        .fonts = st.fonts, .font = f, .rec = st.rec, .log = st.log, .a11y = st.a11y
    };
}

List(Rect) scale_all(List(Rect) rs, Int s, Int i, ListBuf(Rect) acc) {
    if (i >= rs.len()) { return acc.finish(); }
    return scale_all(rs, s, i + 1, acc.push(scale_up(rs[i], s)));
}

@needs(App(M))
Loop(M) with_pending(Loop(M) st, List(Rect) p) {
    return Loop { .model = st.model, .ui = st.ui, .view = st.view, .ops = st.ops, .w = st.w, .h = st.h, .scale = st.scale,
                  .pending = p, .blink = st.blink, .done = st.done, .fonts = st.fonts, .font = st.font, .rec = st.rec, .log = st.log, .a11y = st.a11y };
}

/// A device-pixel event in the program's logical pixels.
pub Event to_logical(Event e, Int s) {
    if (s <= 1) { return e; }
    return match (e) {
        PointerMoved(x, y) => PointerMoved(x / s, y / s),
        PointerDown(x, y, b) => PointerDown(x / s, y / s, b),
        PointerUp(x, y, b) => PointerUp(x / s, y / s, b),
        Resized(w, h) => Resized(w / s, h / s),
        _ => e
    };
}

/// The prints (`assist_prints`) of a turn's events, the reader's `ax`
/// then the display's `p`, all against view `v`, the one the tree they
/// were aimed at was made from: a shell's action (`A11yAction`, among the
/// display's events) is checked as a bus's is, so a click earlier in the
/// same pump that renumbers the view cannot send it to another widget
/// (R6-4).
pub List(Int) turn_prints(List(Event) ax, List(Event) p, Widget v) { return assist_prints(ax.concat(p), 0, v, ListBuf()); }

/// For each event, the print (`press_print`) of the widget an `Assist`
/// names in view `v`, or -1 for any other event.
pub List(Int) assist_prints(List(Event) es, Int i, Widget v, ListBuf(Int) acc) {
    if (i >= es.len()) { return acc.finish(); }
    Int p = match (es[i]) { Assist(n, act) => press_print(v, n), _ => -1 };
    return assist_prints(es, i + 1, v, acc.push(p));
}

/// Whether event `e`, printed `p` when it arrived (-1: not an `Assist`),
/// still names the widget it named in view `v`: the same widget, with the
/// same kind, label and message, and the same widgets numbered before it.
/// Otherwise an earlier event renumbered the view, and the action would
/// land on another widget; it is dropped (a reader acts again on the new
/// tree).
pub Bool assist_current(Event e, Int p, Widget v) {
    if (p < 0) { return true; }
    return match (e) { Assist(n, act) => press_print(v, n) == p, _ => true };
}

/// Fold the backend's events, in order, through the widgets and `update`.
/// `prints` holds `assist_prints` for the first events (a reader's).
@needs(App(M))
@requires(declassify)
Loop(M) fold_events(List(Event) es, List(Int) prints, Int i, Loop(M) st, Int s, Int w, Int h) {
    if (i >= es.len() || st.done) { return st; }
    if (i < prints.len() && !assist_current(es[i], prints[i], st.view)) { return fold_events(es, prints, i + 1, st, s, w, h); }
    Rect area = Rect { .x = 0, .y = 0, .w = w / s, .h = h / s };
    UiStep u = ui_event_in(st.ui, st.view, area, to_logical(es[i], s), st.font);
    Loop(M) next = apply(u.out, 0, Loop {
        .model = st.model, .ui = u.ui, .view = st.view, .ops = st.ops, .w = st.w, .h = st.h, .scale = st.scale,
        .pending = st.pending, .blink = st.blink, .done = st.done, .fonts = st.fonts, .font = st.font, .rec = st.rec, .log = st.log, .a11y = st.a11y
    });
    // The new view may have renumbered the focused input: the caret, the
    // screen reader and the next key follow the input, not the number.
    UiState ui2 = ui_refocus(next.ui, next.view, area, next.font);
    Loop(M) kept = Loop {
        .model = next.model, .ui = ui2, .view = next.view, .ops = next.ops, .w = next.w, .h = next.h, .scale = next.scale,
        .pending = next.pending, .blink = next.blink, .done = next.done, .fonts = next.fonts, .font = next.font, .rec = next.rec, .log = next.log, .a11y = next.a11y
    };
    return fold_events(es, prints, i + 1, kept, s, w, h);
}

/// Hand each event to `update`, refreshing the view after each so the next
/// event meets the widgets the program now shows. `Closed` ends the loop
/// once `update` has seen it.
@needs(App(M))
Loop(M) apply(List(Event) es, Int i, Loop(M) st) {
    if (i >= es.len()) { return st; }
    M m = update(st.model, es[i]);
    Bool closed = match (es[i]) { Closed => true, _ => false };
    return apply(es, i + 1, Loop {
        .model = m, .ui = st.ui, .view = view(m), .ops = st.ops, .w = st.w, .h = st.h, .scale = st.scale,
        .pending = st.pending, .blink = st.blink, .done = st.done || closed, .fonts = st.fonts, .font = st.font,
        .rec = st.rec, .log = if (st.rec && !closed) { st.log.concat([es[i]]) } else { st.log }, .a11y = st.a11y
    });
}

/// Fire the blink timer: flip the caret and send `FrameTick`.
@needs(App(M))
Loop(M) tick(Loop(M) st, Int now) {
    if (!timer_due(st.blink, now) || st.done) { return st; }
    M m = update(st.model, FrameTick);
    return Loop {
        .model = m, .ui = ui_with_caret(st.ui, !st.ui.caret_on), .view = view(m), .ops = st.ops, .w = st.w, .h = st.h,
        .scale = st.scale, .pending = st.pending, .blink = timer_reset(st.blink, now), .done = st.done,
        .fonts = st.fonts, .font = st.font, .rec = st.rec, .log = st.log, .a11y = st.a11y
    };
}

test "the font for a scale is the one made for it, or one that divides it" {
    Font one = font_parse(test_atlas_answer(), 1) else { font_builtin() };
    Font two = font_parse(test_atlas_answer(), 2) else { font_builtin() };
    expect(pick_font([one, two], 2).scale).toEqual(2);
    expect(pick_font([one, two], 1).scale).toEqual(1);
    expect(pick_font([one, two], 4).scale).toEqual(2);
    expect(pick_font([two], 3).scale).toEqual(2);
    expect(font_is_builtin(pick_font([], 2))).toEqual(true);
}

test "device events become logical" {
    Bool ok = match (to_logical(PointerDown(10, 20, 1), 2)) { PointerDown(x, y, b) => x == 5 && y == 10 && b == 1, _ => false };
    expect(ok).toEqual(true);
    Bool same = match (to_logical(KeyDown(30, "a"), 2)) { KeyDown(k, t) => k == 30 && t == "a", _ => false };
    expect(same).toEqual(true);
}

test "a caret blink damages only the caret" {
    Widget v = Column([TextInput("hello", 5, Clicked), Button("ok", Clicked), Text("below")]);
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 120 };
    UiState on = ui_with_focus(ui_new(), 1);
    List(DrawOp) lit = paint(v, r, on);
    List(DrawOp) dark = paint(v, r, ui_with_caret(on, false));
    List(Rect) d = damage_rects(lit, dark);
    expect(d.len()).toEqual(1);
    expect(d[0].w).toEqual(1);
    expect(d[0].h).toEqual(16);
}

/// `n` pointer moves as a shell sends them.
List(Int) shell_moves(Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return shell_moves(n - 1, push_all(acc, from_shell_bytes(Pointer(ptr_move(), n, n, 0, 0, dev_mouse(), 0)), 0));
}

ListBuf(Int) push_all(ListBuf(Int) b, List(Int) xs, Int i) { return if (i >= xs.len()) { b } else { push_all(b.push(xs[i]), xs, i + 1) }; }

@requires(display, clock(readonly))
test "a turn with whole messages already read does not wait for more (R3-1)" {
    List(Int) pair = resid_disp_pair();
    List(Int) bus = resid_disp_pair();   // a screen reader's bus, silent
    Rsp r = rsp_failed("");
    Rsp r0 = Rsp { .fd = pair[1], .alive = true, .err = "", .buf = [], .win = r.win, .bufs = r.bufs, .frame_ok = true, .sem = [], .sent = 0 };
    // 1500 moves, under one read's 64 KB: the first pump reads them all,
    // handles 256, and leaves the rest whole in the buffer
    _ = resid_disp_send(pair[0], shell_moves(1500, ListBuf()), -1);
    Int t0 = now_ms();
    Pumped(Rsp) p1 = be_pump(r0, turn_ms(r0, bus[1], true, 0));
    Pumped(Rsp) p2 = be_pump(p1.b, turn_ms(p1.b, bus[1], true, 500));
    Pumped(Rsp) p3 = be_pump(p2.b, turn_ms(p2.b, bus[1], true, 500));
    Int took = now_ms() - t0;
    expect(p1.events.len() + p2.events.len() + p3.events.len()).toEqual(3 * rsp_max_per_pump());
    // the caret's 500 ms is waited only once nothing whole is left
    expect(took < 250).toEqual(true);
    _ = resid_disp_close(pair[0]);
    _ = resid_disp_close(pair[1]);
    _ = resid_disp_close(bus[0]);
    _ = resid_disp_close(bus[1]);
}

test "an image whose size is a lie is not multiplied into damage (R4-7)" {
    List(Rect) d = scale_all(damage_rects_in([], [OpImage(0, 0, 1 << 62, 1, [])], font_builtin()), 2, 0, ListBuf());
    expect(d.len() <= 1).toEqual(true);
    List(DrawOp) ops = paint(Row([Bitmap(1 << 62, 1 << 62, []), Bitmap(1 << 62, 3, [1, 2, 3])]), Rect { .x = 0, .y = 0, .w = 100, .h = 100 }, ui_new());
    expect(ops.len()).toEqual(0);
    // laid out far past the window: no node near enough to export, and no abort
    List(SemNode) sem = semantics(Padding(1 << 62, Padding(1 << 62, Bitmap(1 << 62, 1, []))), Rect { .x = 0, .y = 0, .w = 100, .h = 100 }, ui_new());
    expect(sem.len() <= 1).toEqual(true);
}

@requires(display, clock(readonly))
test "a window past 16384 pixels a side is refused before it is asked for (R4-7)" {
    WindowOptions big = WindowOptions { .title = "big", .width = 1 << 31, .height = 100, .resizable = true };
    expect(window_options_err(big) != "").toEqual(true);
    expect(window_options_err(WindowOptions { .title = "ok", .width = 16384, .height = 16384, .resizable = false })).toEqual("");
    X11 x = x11_start(big);
    expect(x.alive).toEqual(false);
    expect(str_contains(x.err, "16384")).toEqual(true);
    List(Int) pair = resid_disp_pair();
    Wl w = wl_start_on(pair[1], big);
    expect(w.alive).toEqual(false);
    expect(str_contains(w.err, "16384")).toEqual(true);
    List(Int) pair2 = resid_disp_pair();
    Rsp r = rsp_start_on(pair2[1], WindowOptions { .title = "big", .width = 10, .height = 1 << 40, .resizable = true });
    expect(r.alive).toEqual(false);
    expect(str_contains(r.err, "16384")).toEqual(true);
    _ = resid_disp_close(pair[0]);
    _ = resid_disp_close(pair2[0]);
}

@requires(declassify)
test "a reader's action after the view renumbered hits its widget or nothing (R4-2)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    // Column 0, Row 1, Text A 2, Dismiss 3, Row 4, Text B 5, Dismiss 6, ...
    Widget abc = Column([Row([Text("A"), Button("Dismiss", Custom(0))]), Row([Text("B"), Button("Dismiss", Custom(1))]),
                         Row([Text("C"), Button("Dismiss", Custom(2))])]);
    List(Event) es = [Assist(6, act_activate()), FrameTick];
    List(Int) ps = assist_prints(es, 0, abc, ListBuf());
    expect(ps[1]).toEqual(-1);
    // the view the reader saw: it acts
    expect(assist_current(es[0], ps[0], abc)).toEqual(true);
    // an earlier event removed A: number 6 is C's Dismiss, now Custom(1)
    Widget bc = Column([Row([Text("B"), Button("Dismiss", Custom(0))]), Row([Text("C"), Button("Dismiss", Custom(1))])]);
    expect(assist_current(es[0], ps[0], bc)).toEqual(false);
    // which matters: by its number alone, the action would delete C
    Bool deletes_c = match (ui_event(ui_new(), bc, r, es[0]).out[1]) { AppMsg(m) => msg_eq(m, Custom(1)), _ => false };
    expect(deletes_c).toEqual(true);
    // a change after it does not matter
    Widget abd = Column([Row([Text("A"), Button("Dismiss", Custom(0))]), Row([Text("B"), Button("Dismiss", Custom(1))]),
                         Row([Text("D"), Button("Dismiss", Custom(2))])]);
    expect(assist_current(es[0], ps[0], abd)).toEqual(true);
    expect(assist_current(FrameTick, -1, bc)).toEqual(true);
}

/// A reader's call on `path`, as the bus delivers it.
DMsg reader_call(Str path, Str iface, Str member, List(DV) body) {
    DMsg m = dcall(99, ":1.7", path, iface, member, body);
    return DMsg { .kind = m.kind, .flags = 0, .serial = 99, .reply_serial = 0, .path = path, .iface = iface, .member = member,
                  .error = "", .dest = ":1.7", .sender = ":1.42", .body = body };
}

/// The tree a reader is given for view `v`: its semantics, with tokens.
List(SemNode) exported(Widget v) { return with_tokens(semantics(v, Rect { .x = 0, .y = 0, .w = 200, .h = 200 }, ui_new()), node_tokens(v)); }

A11y reader_a11y() { return A11y { .fd = -1, .alive = true, .err = "", .buf = [], .serial = 10, .name = ":1.7", .title = "Rows", .tree = [], .skip = 0 }; }

Bool did_assist(Served s, Int node) {
    return s.events.len() == 1 && match (s.events[0]) { Assist(n, act) => n == node, _ => false };
}

test "a reader's path from before the rows changed names nothing (R5-4)" {
    // Column 0, Row 1, Text A 2, Dismiss 3, Row 4, Text B 5, Dismiss 6, ...
    Widget abc = Column([Row([Text("A"), Button("Dismiss", Custom(0))]), Row([Text("B"), Button("Dismiss", Custom(1))]),
                         Row([Text("C"), Button("Dismiss", Custom(2))])]);
    A11y a1 = changed(reader_a11y(), exported(abc)).a;
    // the reader holds B's Dismiss
    Str b6 = path_in(a1, 6);
    expect(did_assist(serve(a1, reader_call(b6, "org.a11y.atspi.Action", "DoAction", [DI32(0)])), 6)).toEqual(true);
    // A is removed: number 6 is now C's Dismiss, Custom(1)
    Widget bc = Column([Row([Text("B"), Button("Dismiss", Custom(0))]), Row([Text("C"), Button("Dismiss", Custom(1))])]);
    Served moved = changed(a1, exported(bc));
    Served stale = serve(moved.a, reader_call(b6, "org.a11y.atspi.Action", "DoAction", [DI32(0)]));
    expect(stale.events.len()).toEqual(0);
    expect(stale.out[0].error).toEqual("org.freedesktop.DBus.Error.UnknownObject");
    // the reader was told the old objects went and the new ones came:
    // removals first, from the last
    expect(moved.out.len()).toEqual(6 + 4);
    expect(arg_str(moved.out[0].body, 0)).toEqual("remove");
    expect(arg_int(moved.out[0].body, 1) > arg_int(moved.out[1].body, 1)).toEqual(true);
    expect(arg_str(moved.out[6].body, 0)).toEqual("add");
    // and the new tree's paths act on what they now name
    expect(did_assist(serve(moved.a, reader_call(path_in(moved.a, 6), "org.a11y.atspi.Action", "DoAction", [DI32(0)])), 6)).toEqual(true);
    // text changing in another row, or scrolling, keeps the paths
    Widget s0 = Column([Row([Text("12:00")]), Scroll(0, bc)]);
    Widget s1 = Column([Row([Text("12:01")]), Scroll(40, bc)]);
    Served same = changed(changed(reader_a11y(), exported(s0)).a, exported(s1));
    expect(path_in(same.a, 9)).toEqual(path_in(changed(reader_a11y(), exported(s0)).a, 9));
}

test "a reader's path names nothing once a row of the same shape replaced it (R6-3)" {
    // rows A, B, C, then the feed drops A and appends D: every number,
    // kind and message is as it was
    Widget abc = Column([Row([Text("A"), Button("Delete", Custom(0))]), Row([Text("B"), Button("Delete", Custom(1))]),
                         Row([Text("C"), Button("Delete", Custom(2))])]);
    Widget bcd = Column([Row([Text("B"), Button("Delete", Custom(0))]), Row([Text("C"), Button("Delete", Custom(1))]),
                         Row([Text("D"), Button("Delete", Custom(2))])]);
    A11y a1 = changed(reader_a11y(), exported(abc)).a;
    Str b6 = path_in(a1, 6);
    Served next = changed(a1, exported(bcd));
    Served stale = serve(next.a, reader_call(b6, "org.a11y.atspi.Action", "DoAction", [DI32(0)]));
    expect(stale.events.len()).toEqual(0);
    expect(stale.out[0].error).toEqual("org.freedesktop.DBus.Error.UnknownObject");
    // the tokens are press_print's
    List(Int) toks = node_tokens(abc);
    expect(toks.len()).toEqual(10);
    expect(toks[6]).toEqual(node_token(press_print(abc, 6)));
    expect(toks[9]).toEqual(node_token(press_print(abc, 9)));
}

/// The events a turn's pump turns `msgs` from a shell into.
@requires(display)
List(Event) shell_says(List(FromShell) msgs) { return shell_says_over([], msgs); }

/// `shell_says` to a core that sent the shell tree `sem`.
@requires(display)
List(Event) shell_says_over(List(SemNode) sem, List(FromShell) msgs) {
    List(Int) pair = resid_disp_pair();
    Rsp r = rsp_failed("");
    Rsp r0 = Rsp { .fd = pair[1], .alive = true, .err = "", .buf = [], .win = r.win, .bufs = r.bufs, .frame_ok = true, .sem = sem, .sent = 0 };
    _ = resid_disp_send(pair[0], shell_bytes(msgs, 0, ListBuf()), -1);
    List(Event) es = be_pump(r0, 100).events;
    _ = resid_disp_close(pair[0]);
    _ = resid_disp_close(pair[1]);
    return es;
}

List(Int) shell_bytes(List(FromShell) ms, Int i, ListBuf(Int) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return shell_bytes(ms, i + 1, push_all(acc, from_shell_bytes(ms[i]), 0));
}

/// What `ui_event` passes on of `es`, folded in order over `v`.
@requires(declassify)
List(Event) passed_on(UiState ui, Widget v, List(Event) es, Int i, List(Event) acc) {
    if (i >= es.len()) { return acc; }
    UiStep u = ui_event(ui, v, Rect { .x = 0, .y = 0, .w = 200, .h = 200 }, es[i]);
    return passed_on(u.ui, v, es, i + 1, acc.concat(u.out));
}

Bool any_key(List(Event) es, Int i) {
    if (i >= es.len()) { return false; }
    Bool k = match (es[i]) { KeyDown(c, t) => true, KeyUp(c) => true, _ => false };
    return k || any_key(es, i + 1);
}

@requires(display, declassify)
test "a password typed through a shell passes no key on (R6-1)" {
    Widget login = Column([Text("Login"), PasswordInput(password_empty(), 0, Submitted)]);
    UiState on = ui_event(ui_new(), login, Rect { .x = 0, .y = 0, .w = 200, .h = 200 }, Assist(2, act_focus())).ui;
    List(Event) es = shell_says([Key(30, 1, 0), TextCommit("a"), Key(30, 0, 0)]);
    expect(es.len()).toEqual(3);
    expect(any_key(passed_on(on, login, es, 0, []), 0)).toEqual(false);
}

Widget dismiss_feed(List(Str) names, Int i, ListBuf(Widget) acc) {
    if (i >= names.len()) { return Column(acc.finish()); }
    return dismiss_feed(names, i + 1, acc.push(Row([Text(names[i]), Button("Dismiss", Custom(i))])));
}

test "a shell's action after a click in the same pump hits its widget or nothing (R6-4)" {
    // Column 0, Row 1, Text A 2, Dismiss 3, Row 4, Text B 5, Dismiss 6, ...
    Widget abc = dismiss_feed(["A", "B", "C"], 0, ListBuf());
    // one pump from a shell: a click that dismisses A, then the reader's
    // action on B's Dismiss (number 6 in the tree it was given)
    List(Event) es = [PointerDown(5, 5, 1), PointerUp(5, 5, 1), Assist(6, act_activate())];
    List(Int) ps = turn_prints([], es, abc);
    expect(ps.len()).toEqual(3);
    // the click's update removed A: number 6 is C's Dismiss, Custom(1)
    Widget bc = dismiss_feed(["B", "C"], 0, ListBuf());
    expect(assist_current(es[2], ps[2], bc)).toEqual(false);
    expect(assist_current(es[2], ps[2], abc)).toEqual(true);
}

@requires(display)
test "a shell's action with a stale token is dropped (R6-4)" {
    Widget abc = dismiss_feed(["A", "B", "C"], 0, ListBuf());
    List(SemNode) sent = exported(abc);
    Int t6 = node_tokens(abc)[6];
    // the shell names node 6 with the token the core sent: an Assist
    List(Event) ok = shell_says_over(sent, [A11yAction(6, act_activate(), t6)]);
    Bool acts = ok.len() == 1 && match (ok[0]) { Assist(n, act) => n == 6, _ => false };
    expect(acts).toEqual(true);
    // after the core sent rows B, C, the old token names nothing
    List(SemNode) now = exported(dismiss_feed(["B", "C"], 0, ListBuf()));
    expect(shell_says_over(now, [A11yAction(6, act_activate(), t6)]).len()).toEqual(0);
    // nor does a node the core never sent
    expect(shell_says_over(now, [A11yAction(99, act_activate(), 0)]).len()).toEqual(0);
}

test "tokens tell apart texts a weak hash confused (R7-4)" {
    Widget aa = Column([Row([Text("Aa"), Button("Delete", Custom(0))])]);
    Widget bb = Column([Row([Text("BB"), Button("Delete", Custom(0))])]);
    expect(node_tokens(aa)[3] == node_tokens(bb)[3]).toEqual(false);
    A11y a1 = changed(reader_a11y(), exported(bb)).a;
    Str old = path_in(a1, 3);
    Served stale = serve(changed(a1, exported(aa)).a, reader_call(old, "org.a11y.atspi.Action", "DoAction", [DI32(0)]));
    expect(stale.events.len()).toEqual(0);
}
