// gui.resid — the application interface of resid-gui.
//
// A program declares an `App(M)` instance and calls `gui_run`. The library
// owns the display connection, the frame loop and the pixels; the program
// owns the model. Nothing here holds ambient authority: every function that
// reaches a display builtin says so with @requires.

import "x11/connect.resid";
import "x11/conn.resid";
import "x11/events.resid";
import "x11/requests.resid";
import "gfx/color.resid";
import "gfx/draw.resid";
import "gfx/raster.resid";
import "ui/paint.resid";
import "ui/damage.resid";
import "ui/buffers.resid";
import "ui/timer.resid";

// What the display sends up. Every field is data: the loop decodes bytes
// into one of these and folds it through `update`.
type Event = PointerMoved(Int, Int) | PointerDown(Int, Int, Int) | PointerUp(Int, Int, Int) | Wheel(Int, Int) | KeyDown(Int, Str) | KeyUp(Int) | Resized(Int, Int) | Focused | Blurred | Closed | FrameTick | AppMsg(Msg);

// A message a widget raises. Widgets carry these as values, never closures:
// a closure cannot be compared, and value equality is what damage tracking
// is built on.
type Msg = Clicked | Toggled | Changed(Str) | Submitted | Focused | Blurred;

// What the program wants on screen. A widget is a value, so two equal models
// give two equal display lists and therefore identical pixels.
type Widget = Text(Str) | Button(Str, Msg) | Checkbox(Str, Bool, Msg) | TextInput(Str, Int, Msg) | Row(List(Widget)) | Column(List(Widget)) | Stack(List(Widget)) | Padding(Int, Widget) | Align(Int, Int, Widget) | Scroll(Widget) | Bitmap(Int, Int, Str) | Slider(Int, Msg) | Spacer;

// A program's application: a model, a pure step over events, a pure view.
behavior App(M) {
    M init();
    M update(M m, Event e);
    Widget view(M m);
}

// How a window is opened. `width`/`height` are in device pixels.
type WindowOptions = {
    Str title; Int width; Int height; Bool resizable;
};

@requires(display)
pub Int gui_send_seq(Int fd, List(List(Int)) seq, Int handle, Int i) {
    if (i >= seq.len()) { return i; }
    Int pass = if (i == seq.len() - 1) { resid_disp_shm_fd(handle) } else { -1 };
    if (!resid_disp_send(fd, seq[i], pass)) { return i; }
    return gui_send_seq(fd, seq, handle, i + 1);
}

@requires(display)
pub Int gui_event_loop(Int fd) {
    List(Int) ready = resid_disp_poll([fd], [1], 1000);
    if (ready.len() > 0 && (ready[0] & 1) != 0) {
        List(Int) got = resid_disp_recv(fd, 65536);
        if (got.len() == 0) { return 0; }
    }
    if (ready.len() > 0 && (ready[0] & 4) != 0) { return 0; }
    if (ready.len() > 0 && (ready[0] & 8) != 0) { return 0; }
    return gui_event_loop(fd);
}

// Open a window and run the program's `App(M)` instance until it is closed.
// Blocks; returns the process exit status.
@needs(App(M))
@requires(display)
pub Int gui_run_x11(WindowOptions opts) { return gui_run(opts); }

@needs(App(M))
@requires(display)
pub Int gui_run(WindowOptions opts) {
    Session s = x11_open(auth_none());
    if (s.fd < 0) { return 1; }
    Conn c = conn_new(s.setup);
    Int width = if (opts.width < 1) { 1 } else { opts.width };
    Int height = if (opts.height < 1) { 1 } else { opts.height };
    Int bytes = width * height * 4;
    // Double buffering: two shm handles
    Int handle0 = resid_disp_shm_new(bytes);
    if (handle0 == 0) { _ = x11_close(s); return 1; }
    Int handle1 = resid_disp_shm_new(bytes);
    if (handle1 == 0) { _ = resid_disp_shm_free(handle0); _ = x11_close(s); return 1; }
    List(List(Int)) seq = conn_open_window(c, width, height);
    Int sent = gui_send_seq(s.fd, seq, handle0, 0);
    if (sent != seq.len()) { _ = x11_close(s); _ = resid_disp_shm_free(handle0); _ = resid_disp_shm_free(handle1); return 1; }
    // Initial frame for the program's initial model.
    M model0 = init();
    List(DrawOp) prev_ops = paint_widget(view(model0), Rect { .x = 0, .y = 0, .w = width, .h = height });
    _ = gui_render_frame(s.fd, handle0, c, model0, width, height, prev_ops);
    // Timer for caret blink (500ms)
    Timer blink_timer = timer_new(0, 500);
    M finalmodel = gui_run_loop(s, c, model0, width, height, handle0, handle1, 0, blink_timer, prev_ops, []);
    _ = resid_disp_shm_free(handle0);
    _ = resid_disp_shm_free(handle1);
    _ = x11_close(s);
    return 0;
}

@needs(App(M))
@requires(display)
Int gui_render_frame(Int fd, Int handle, Conn c, M model, Int width, Int height, List(DrawOp) ops) {
    List(Int) px = rasterize_ops(ops, width, height);
    _ = resid_disp_shm_put(handle, 0, px, width * height * 4);
    _ = resid_disp_send(fd, conn_present(c, width, height), -1);
    return 0;
}

@needs(App(M))
@requires(display)
M gui_run_loop(Session s, Conn c, M model, Int width, Int height, Int front_handle, Int back_handle, Int front_idx, Timer blink_timer, List(DrawOp) prev_ops, List(Int) buf) {
    // Check timers
    Int now = 0; // Simplified: would use clock capability in real impl
    // For now, just use poll timeout for timer approximation
    Int poll_timeout = timer_next_due([blink_timer], 0, 16);
    
    if (buf.len() >= 32) {
        Event e = decode_event(slice_bytes(buf, 0, 32, 0, []));
        M m2 = update(model, e);
        // Handle timer events
        Timer next_blink = if (timer_due(blink_timer, now)) { timer_reset(blink_timer, now) } else { blink_timer };
        M m3 = if (timer_due(blink_timer, now)) { update(m2, FrameTick) } else { m2 };
        Widget vw = view(m3);
        List(DrawOp) new_ops = paint_widget(vw, Rect { .x = 0, .y = 0, .w = width, .h = height });
        
        // Damage tracking: only redraw if display list changed
        if (!draw_lists_equal(prev_ops, new_ops)) {
            List(Int) changed = changed_ops(prev_ops, new_ops);
            // For simplicity, full frame redraw if any change
            _ = gui_render_frame(s.fd, front_handle, c, m3, width, height, new_ops);
            // Swap buffers
            Int next_front = if (front_idx == 0) { back_handle } else { front_handle };
            Int next_back = if (front_idx == 0) { front_handle } else { back_handle };
            Int next_idx = if (front_idx == 0) { 1 } else { 0 };
            // Note: In real impl, would present next_front and swap
        }
        
        Bool closed = match (e) { Closed => true, _ => false };
        List(Int) rest = slice_bytes(buf, 32, buf.len(), 0, []);
        if (closed) { return m3; }
        return gui_run_loop(s, c, m3, width, height, front_handle, back_handle, front_idx, next_blink, new_ops, rest);
    }
    List(Int) ready = resid_disp_poll([s.fd], [1], poll_timeout);
    if (ready.len() > 0 && (ready[0] & 1) != 0) {
        List(Int) got = resid_disp_recv(s.fd, 65536);
        if (got.len() == 0) { return model; }
        return gui_run_loop(s, c, model, width, height, front_handle, back_handle, front_idx, blink_timer, prev_ops, buf.concat(got));
    }
    if (ready.len() > 0 && (ready[0] & 8) != 0) { return model; }
    // Timer tick
    return gui_run_loop(s, c, model, width, height, front_handle, back_handle, front_idx, blink_timer, prev_ops, buf);
}

