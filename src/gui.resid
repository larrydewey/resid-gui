// gui.resid — the application interface of resid-gui.
//
// A program declares an `App(M)` instance and calls `gui_run`. The library
// owns the display connection, the frame loop and the pixels; the program
// owns the model. Nothing here holds ambient authority: every function that
// reaches a display builtin says so with @requires.
//
// Status: skeleton. This file does not compile until the `display` family
// lands in the Resid runtime (PLAN-gui.md, phase G1) — `@requires(display)`
// is E0213 today. See PLAN-gui.md for the phases.

// What the display sends up. Every field is data: the loop decodes bytes
// into one of these and folds it through `update`.
type Event = PointerMoved(Int, Int) | PointerDown(Int, Int, Int) | PointerUp(Int, Int, Int) | Wheel(Int, Int) | KeyDown(Int, Str) | KeyUp(Int) | Resized(Int, Int) | Focused | Blurred | Closed | FrameTick | AppMsg(Msg);

// A message a widget raises. Widgets carry these as values, never closures:
// a closure cannot be compared, and value equality is what damage tracking
// is built on.
type Msg = Clicked | Toggled | Changed(Str) | Submitted | Focused | Blurred;

// What the program wants on screen. A widget is a value, so two equal models
// give two equal display lists and therefore identical pixels.
type Widget = Text(Str) | Button(Str, Msg) | Checkbox(Str, Bool, Msg) | TextInput(Str, Int, Msg) | Row(List(Widget)) | Column(List(Widget)) | Padding(Int, Widget) | Spacer;

// A program's application: a model, a pure step over events, a pure view.
behavior App(M) {
    M init();
    M update(M m, Event e);
    Widget view(M m);
}

// How a window is opened. `width`/`height` are in device pixels.
type WindowOptions = {
    Str title; Int width; Int height; Bool resizable;
};

// Open a window and run the program's `App(M)` instance until it is closed.
// Blocks; returns the process exit status.
@needs(App(M))
@requires(display)
pub Int gui_run(WindowOptions opts) {
    return gui_run_x11(opts);
}
