// input.resid — what raw input means to the widgets on screen.
//
// The display reports pointers and keys; this module finds the widget
// under the pointer (with the same geometry painting used), tracks focus
// and presses in `UiState`, and turns them into the widget events a
// program handles: `AppMsg`, `TextEdited` and `SliderSet`. Every raw
// event is passed on too, first, so a program can still see it.

import "../app.resid";
import "../gfx/color.resid";
import "../backend/keymap.resid";
import "../gfx/font.resid";
import "layout.resid";
import "paint.resid";
import "state.resid";
import "semantics.resid";

/// A widget found in the tree: its number, itself and its box.
type Found = { Int id; Widget w; Rect r; };

Found not_found() { return Found { .id = -1, .w = Spacer, .r = rect_none() }; }

/// What one event did: the new widget state and the events for `update`.
type UiStep = { UiState ui; List(Event) out; };

/// What a key did to a text input: the events for `update`, and where the
/// selection's anchor is now (-1: no selection).
type Edited = { List(Event) out; Int anchor; };

/// Whether a widget reacts to the pointer or the keyboard.
pub Bool interactive(Widget w) {
    return match (w) {
        Button(s, m) => true,
        Checkbox(s, c, m) => true,
        TextInput(s, k, m) => true,
        PasswordInput(s, k, m) => true,
        Slider(v, m) => true,
        _ => false
    };
}

/// The topmost interactive widget under (`x`, `y`), or one with id -1.
pub Found hit(Widget w, Rect r, Int x, Int y) { return hit_in(w, r, x, y, font_builtin()); }

/// `hit` with text in font `f`.
pub Found hit_in(Widget w, Rect r, Int x, Int y, Font f) { return hit_node(w, r, x, y, 0, f); }

Found hit_node(Widget w, Rect r, Int x, Int y, Int id, Font f) {
    if (!rect_contains(r, x, y)) { return not_found(); }
    if (interactive(w)) { return Found { .id = id, .w = w, .r = r }; }
    Found row = match (w) { Rows(o, rh, xs) => hit_row(xs, r, o, rh, x, y, id, f), _ => Found { .id = -2, .w = Spacer, .r = r } };
    if (row.id != -2) { return row; }
    List(Widget) kids = children(w);
    return hit_kids(kids, child_rects_in(w, r, f), x, y, kids.len() - 1, kid_ids(kids, id + 1, 0, ListBuf()), f);
}

/// In a `Rows`, the row under the pointer is the only one asked.
Found hit_row(List(Widget) xs, Rect r, Int o, Int rh, Int x, Int y, Int id, Font f) {
    Int k = (y - r.y + o) / max_int(rh, 1);
    if (y - r.y + o < 0 || k >= xs.len()) { return not_found(); }
    return hit_node(xs[k], row_rect(r, o, rh, k), x, y, id + 1 + count_nodes(xs, 0, k, 0), f);
}

/// The number of each child, given the first child's.
List(Int) kid_ids(List(Widget) xs, Int id, Int i, ListBuf(Int) acc) {
    return if (i >= xs.len()) { acc.finish() } else { kid_ids(xs, id + node_count(xs[i]), i + 1, acc.push(id)) };
}

// Later children are drawn over earlier ones, so they are asked first.
Found hit_kids(List(Widget) xs, List(Rect) rs, Int x, Int y, Int i, List(Int) ids, Font f) {
    if (i < 0 || i >= rs.len()) { return not_found(); }
    Found h = hit_node(xs[i], rs[i], x, y, ids[i], f);
    if (h.id >= 0) { return h; }
    return hit_kids(xs, rs, x, y, i - 1, ids, f);
}

/// The widget numbered `target`, or one with id -1.
pub Found find(Widget w, Rect r, Int target) { return find_in(w, r, target, font_builtin()); }

/// `find` with text in font `f`.
pub Found find_in(Widget w, Rect r, Int target, Font f) { return find_node(w, r, target, 0, f); }

Found find_node(Widget w, Rect r, Int target, Int id, Font f) {
    if (target < id || target >= id + node_count(w)) { return not_found(); }
    if (target == id) { return Found { .id = id, .w = w, .r = r }; }
    Found row = match (w) { Rows(o, rh, xs) => find_row(xs, r, o, rh, target, 0, id + 1, f), _ => Found { .id = -2, .w = Spacer, .r = r } };
    if (row.id != -2) { return row; }
    List(Widget) kids = children(w);
    return find_kids(kids, child_rects_in(w, r, f), target, 0, id + 1, f);
}

Found find_row(List(Widget) xs, Rect r, Int o, Int rh, Int target, Int i, Int id, Font f) {
    if (i >= xs.len()) { return not_found(); }
    Int n = node_count(xs[i]);
    if (target < id + n) { return find_node(xs[i], row_rect(r, o, rh, i), target, id, f); }
    return find_row(xs, r, o, rh, target, i + 1, id + n, f);
}

Found find_kids(List(Widget) xs, List(Rect) rs, Int target, Int i, Int id, Font f) {
    if (i >= xs.len() || i >= rs.len()) { return not_found(); }
    Int n = node_count(xs[i]);
    if (target < id + n) { return find_node(xs[i], rs[i], target, id, f); }
    return find_kids(xs, rs, target, i + 1, id + n, f);
}

/// The numbers of every text input, in order.
pub List(Int) inputs(Widget w) { return inputs_node(w, 0, ListBuf()).finish(); }

ListBuf(Int) inputs_node(Widget w, Int id, ListBuf(Int) acc) {
    ListBuf(Int) here = match (w) { TextInput(s, k, m) => acc.push(id), _ => acc };
    return inputs_kids(children(w), 0, id + 1, here);
}

ListBuf(Int) inputs_kids(List(Widget) xs, Int i, Int id, ListBuf(Int) acc) {
    if (i >= xs.len()) { return acc; }
    return inputs_kids(xs, i + 1, id + node_count(xs[i]), inputs_node(xs[i], id, acc));
}

/// The input after `cur` in tab order, wrapping; -1 when there is none.
pub Int next_input(List(Int) ids, Int cur) {
    if (ids.len() == 0) { return -1; }
    return next_input_at(ids, cur, 0);
}

Int next_input_at(List(Int) ids, Int cur, Int i) {
    if (i >= ids.len()) { return ids[0]; }
    if (ids[i] > cur) { return ids[i]; }
    return next_input_at(ids, cur, i + 1);
}

/// Fold one raw event through the widgets on screen, in the built-in font.
/// It needs the `declassify` grant: editing a `PasswordInput` splices a
/// keystroke into its secret text (`pw_splice`), the one place the
/// library reads one.
@requires(declassify)
pub UiStep ui_event(UiState ui, Widget root, Rect area, Event e) { return ui_event_in(ui, root, area, e, font_builtin()); }

/// Fold one raw event through the widgets on screen, laid out in font `f`.
/// A key that types into a focused `PasswordInput`, and any key's
/// release there but Shift's and Ctrl's, is not passed on raw: its code
/// and text are the password (the edit itself arrives as
/// `PasswordEdited`).
@requires(declassify)
pub UiStep ui_event_in(UiState ui, Widget root, Rect area, Event e, Font f) {
    UiStep s = match (e) {
        PointerDown(x, y, b) => if (b == 1) { pointer_down(ui, root, area, x, y, f) } else { none(ui) },
        PointerMoved(x, y) => pointer_moved(ui, root, area, x, f),
        PointerUp(x, y, b) => if (b == 1) { pointer_up(ui, root, area, x, y, f) } else { none(ui) },
        KeyDown(code, text) => key_down(ui, root, area, code, text, f),
        KeyUp(code) => none(mods_after(ui, code, false)),
        Blurred => UiStep { .ui = ui_with_mods(ui_with_pressed(ui, -1), false, false), .out = [] },
        Assist(node, act) => assist(ui, root, area, node, act, f),
        _ => none(ui)
    };
    Bool withheld = match (e) {
        KeyDown(code, text) => str_len(text) > 0 && password_focused(ui, root, area, f),
        KeyUp(code) => !is_shift(code) && !is_ctrl(code) && password_focused(ui, root, area, f),
        _ => false
    };
    return UiStep { .ui = s.ui, .out = if (withheld) { s.out } else { [e].concat(s.out) } };
}

/// Whether the input with focus (followed through a renumbering, as keys
/// are) is a `PasswordInput`.
Bool password_focused(UiState ui, Widget root, Rect area, Font f) {
    if (ui.focus < 0) { return false; }
    UiState u = ui_refocus(ui, root, area, f);
    if (u.focus < 0) { return false; }
    return match (find_in(root, area, u.focus, f).w) { PasswordInput(s, k, m) => true, _ => false };
}

UiStep none(UiState ui) { return UiStep { .ui = ui, .out = [] }; }

/// An assistive action on widget `node`: activating a button or checkbox
/// raises its message as a click would; focusing a text input focuses it.
/// Anything else, or a node a click could not reach (outside the window,
/// scrolled out of view, under another layer of a `Stack`), does nothing:
/// a screen reader acts on what is shown, as the pointer does.
UiStep assist(UiState ui, Widget root, Rect area, Int node, Int act, Font fo) {
    if ((act & act_scroll()) != 0) { return scroll_to(ui, root, area, node, fo); }
    Found f = find_in(root, area, node, fo);
    if (f.id < 0) { return none(ui); }
    Rect v = rect_intersect(f.r, area);
    if (rect_is_empty(v) || hit_in(root, area, v.x + v.w / 2, v.y + v.h / 2, fo).id != node) { return none(ui); }
    return match (f.w) {
        Button(s, m) => if ((act & act_activate()) != 0) { UiStep { .ui = ui, .out = [AppMsg(m)] } } else { none(ui) },
        Checkbox(s, c, m) => if ((act & act_activate()) != 0) { UiStep { .ui = ui, .out = [AppMsg(m)] } } else { none(ui) },
        TextInput(s, k, m) => if ((act & act_focus()) != 0) { none(focus_on(ui, root, node, f.w)) } else { none(ui) },
        PasswordInput(s, k, m) => if ((act & act_focus()) != 0) { none(focus_on(ui, root, node, f.w)) } else { none(ui) },
        _ => none(ui)
    };
}

/// An assistive request to see widget `node`: its nearest `Scroll` moved
/// just enough that the node's box lies in the scroll's view (its top, when
/// it is taller than the view), as `ScrollTo(scroll, offset)` for the
/// program, which owns the offset as it does for `Wheel`. Nothing for a
/// node a reader is not given (under a layer, a row out of a `Rows`'s
/// view), one no `Scroll` holds, or one already in view.
UiStep scroll_to(UiState ui, Widget root, Rect area, Int node, Font fo) {
    List(SemNode) ns = semantics_in(root, area, ui, fo);
    Int k = sem_at(ns, node, 0);
    if (k < 0) { return none(ui); }
    Int s = scroll_above(ns, ns[k].parent, 0);
    if (s < 0) { return none(ui); }
    Found sc = find_in(root, area, ns[s].id, fo);
    Int o = match (sc.w) { Scroll(off, c) => off, _ => -1 };
    if (o < 0) { return none(ui); }
    Rect view = sc.r;
    Rect t = ns[k].bounds;
    Int want = if (t.y < view.y || t.h > view.h) { o - (view.y - t.y) }
               else { if (t.y + t.h > view.y + view.h) { o + (t.y + t.h - view.y - view.h) } else { o } };
    Int to = max_int(want, 0);
    return if (to == o) { none(ui) } else { UiStep { .ui = ui, .out = [ScrollTo(ns[s].id, to)] } };
}

/// The index of node `id` in `ns`, or -1.
Int sem_at(List(SemNode) ns, Int id, Int i) {
    if (i >= ns.len()) { return -1; }
    return if (ns[i].id == id) { i } else { sem_at(ns, id, i + 1) };
}

/// The index of the nearest scroll area at or above node `id`, or -1.
/// `depth` bounds the walk by the tree's size.
Int scroll_above(List(SemNode) ns, Int id, Int depth) {
    if (id < 0 || depth > ns.len()) { return -1; }
    Int j = sem_at(ns, id, 0);
    if (j < 0) { return -1; }
    return if (ns[j].role == role_scroll()) { j } else { scroll_above(ns, ns[j].parent, depth + 1) };
}

/// The text inputs Tab moves between: those a click could reach, in
/// order. An input scrolled out of view, laid out outside the window or
/// under a layer of a `Stack` is skipped, as the pointer cannot reach it.
pub List(Int) tab_inputs(Widget root, Rect area, UiState ui, Font fo) {
    return tab_at(semantics_in(root, area, ui, fo), 0, ListBuf());
}

List(Int) tab_at(List(SemNode) ns, Int i, ListBuf(Int) acc) {
    if (i >= ns.len()) { return acc.finish(); }
    SemNode n = ns[i];
    Bool ok = (n.role == role_textbox() || n.role == role_password()) && (n.flags & sem_offscreen()) == 0 && (n.actions & act_focus()) != 0;
    return tab_at(ns, i + 1, if (ok) { acc.push(n.id) } else { acc });
}

Bool is_shift(Int code) { return code == key_left_shift() || code == key_right_shift(); }
Bool is_ctrl(Int code) { return code == key_left_ctrl() || code == key_right_ctrl(); }

/// The held modifiers after `code` went down (`down`) or up.
UiState mods_after(UiState ui, Int code, Bool down) {
    return ui_with_mods(ui, if (is_shift(code)) { down } else { ui.shift }, if (is_ctrl(code)) { down } else { ui.ctrl });
}

UiStep pointer_down(UiState ui, Widget root, Rect area, Int x, Int y, Font fo) {
    Found f = hit_in(root, area, x, y, fo);
    UiState pressed = ui_with_press(ui, f.id, msg_of(f.w), label_of(f.w), f.r, if (f.id >= 0) { press_print(root, f.id) } else { 0 });
    return match (f.w) {
        TextInput(s, k, m) => press_input(pressed, root, f.id, f.w, s, k, m, caret_at_in(f.r, s, k, x, fo)),
        PasswordInput(s, k, m) => press_password(pressed, root, f.id, f.w, s, k, m, caret_at_in(f.r, password_bullets(s), k, x, fo)),
        Slider(v, m) => UiStep { .ui = ui_with_focus(pressed, -1), .out = [SliderSet(m, slider_value_at(f.r, x))] },
        _ => UiStep { .ui = ui_with_focus(pressed, -1), .out = [] }
    };
}

/// A press in an input puts the caret under the pointer and the anchor
/// there too, so a drag selects; with Shift held the press extends the
/// selection from where it was anchored, or from the old caret.
UiStep press_input(UiState ui, Widget root, Int id, Widget w, Str s, Int k, Msg m, Int c) {
    Int keep = if (ui.focus == id && ui.anchor >= 0) { ui.anchor } else { k };
    UiState u = ui_with_anchor(focus_on(ui, root, id, w), if (ui.shift) { keep } else { c });
    return UiStep { .ui = u, .out = [TextEdited(m, s, c)] };
}

/// `press_input` for a password: the caret placed among its bullets.
UiStep press_password(UiState ui, Widget root, Int id, Widget w, Secret(Str) s, Int k, Msg m, Int c) {
    Int keep = if (ui.focus == id && ui.anchor >= 0) { ui.anchor } else { k };
    UiState u = ui_with_anchor(focus_on(ui, root, id, w), if (ui.shift) { keep } else { c });
    return UiStep { .ui = u, .out = [PasswordEdited(m, s, c)] };
}

/// The caret position a click at `x` puts in an input showing `s`, in the
/// built-in font.
pub Int caret_at(Rect r, Str s, Int caret, Int x) { return caret_at_in(r, s, caret, x, font_builtin()); }

/// `caret_at` with the text in font `f`: the character boundary nearest
/// the click, allowing for how far the text is scrolled.
pub Int caret_at_in(Rect r, Str s, Int caret, Int x, Font f) {
    Int shift = input_scroll(caret_offset(s, caret, f), r.w - 2);
    return index_at_x(f, s, max_int(x - (r.x + 5) + shift, 0));
}

/// The message a widget raises, or `Clicked` for one that raises none.
Msg msg_of(Widget w) {
    return match (w) { Button(s, m) => m, Checkbox(s, c, m) => m, TextInput(s, k, m) => m, PasswordInput(s, k, m) => m, Slider(v, m) => m, _ => Clicked };
}

/// A widget's label, or "" for one without (an input's text is not its
/// label: it changes as the widget is used).
Str label_of(Widget w) {
    return match (w) { Button(s, m) => s, Checkbox(s, c, m) => s, _ => "" };
}

/// The pressed widget, if the one numbered so is still the one pressed
/// (same message, label and box, and the widgets numbered before it
/// unchanged); otherwise none. A message alone is not enough: rows keyed
/// by index (Custom(i)) renumber when one is removed, and the next row's
/// button arrives under the pointer with the message the pressed one had,
/// and with its label and box too when every row has the same button
/// (R4-5).
Found pressed_in(UiState ui, Widget root, Rect area, Font fo) {
    Found f = find_in(root, area, ui.pressed, fo);
    Bool same = f.id >= 0 && msg_eq(msg_of(f.w), ui.pmsg) && label_of(f.w) == ui.plabel && rect_eq(f.r, ui.prect)
                && press_print(root, ui.pressed) == ui.pprint;
    return if (same) { f } else { not_found() };
}

/// A fingerprint of the widgets numbered 0 to `upto`, in pre-order: their
/// structure only, each one's kind, its message and its shape (how many
/// children, padding, alignment). Not what using a widget changes (a
/// slider's value, a checkbox's mark, an input's text or caret, a scroll
/// offset), so a drag does not cancel itself, and not any text or label (a
/// clock or a count ticking above a button must not cancel its press,
/// R5-3); only the widget numbered `upto` adds its label.
/// Removing, adding or replacing a widget before the pressed one changes
/// it; a row whose text alone changed does not.
pub Int press_print(Widget root, Int upto) { return fp_node(root, 0, upto, Fp { .h = 17, .id = 0 }).h; }

/// A fingerprint so far, and the number of the next widget.
type Fp = { Int h; Int id; };

Int fp_mask() { return (1 << 40) - 1; }
Int fp_mix(Int h, Int x) { return (h * 31 + (x & fp_mask())) & fp_mask(); }

Int fp_str(Int h, Str s, Int i) {
    if (i >= str_len(s)) { return fp_mix(h, 0); }
    return fp_str(fp_mix(h, str_char_at(s, i)), s, i + 1);
}

/// A message's fingerprint; a `Changed` input's text is left out.
Int fp_msg(Int h, Msg m, Bool text) {
    return match (m) {
        Clicked => fp_mix(h, 1), Toggled => fp_mix(h, 2), Submitted => fp_mix(h, 4),
        Changed(x) => if (text) { fp_str(fp_mix(h, 3), x, 0) } else { fp_mix(h, 3) },
        Custom(n) => fp_mix(fp_mix(h, 5), n)
    };
}

Int fp_one(Int h, Widget w) {
    return match (w) {
        Text(s) => fp_mix(h, 101),
        Button(s, m) => fp_msg(fp_mix(h, 102), m, true),
        Checkbox(s, c, m) => fp_msg(fp_mix(h, 103), m, true),
        TextInput(s, k, m) => fp_msg(fp_mix(h, 104), m, false),
        Row(xs) => fp_mix(fp_mix(h, 105), xs.len()),
        Column(xs) => fp_mix(fp_mix(h, 106), xs.len()),
        Stack(xs) => fp_mix(fp_mix(h, 107), xs.len()),
        Padding(n, c) => fp_mix(fp_mix(h, 108), n),
        Align(ax, ay, c) => fp_mix(fp_mix(fp_mix(h, 109), ax), ay),
        Scroll(o, c) => fp_mix(h, 110),
        Rows(o, rh, xs) => fp_mix(fp_mix(fp_mix(h, 111), rh), xs.len()),
        Bitmap(bw, bh, px) => fp_mix(fp_mix(fp_mix(h, 112), bw), bh),
        Slider(v, m) => fp_msg(fp_mix(h, 113), m, true),
        Spacer => fp_mix(h, 114),
        Themed(t, c) => fp_mix(h, 115),
        PasswordInput(s, k, m) => fp_msg(fp_mix(h, 116), m, true)
    };
}

Fp fp_node(Widget w, Int id, Int upto, Fp acc) {
    if (id > upto) { return acc; }
    // the widget printed for is known by its label too
    Int h = if (id == upto) { fp_str(fp_one(acc.h, w), label_of(w), 0) } else { fp_one(acc.h, w) };
    return fp_kids(children(w), 0, upto, Fp { .h = h, .id = id + 1 });
}

Fp fp_kids(List(Widget) xs, Int i, Int upto, Fp acc) {
    if (i >= xs.len() || acc.id > upto) { return acc; }
    Fp next = fp_node(xs[i], acc.id, upto, acc);
    // a subtree passed over still takes its numbers
    return fp_kids(xs, i + 1, upto, Fp { .h = next.h, .id = acc.id + node_count(xs[i]) });
}

/// Whether message `m` echoes text `s`: `Changed(s)`.
Bool echoes(Msg m, Str s) { return match (m) { Changed(x) => x == s, _ => false }; }

/// Focus on widget `id`, `w` (in view `root`): its kind, its message,
/// whether that message echoes the input's text, and its place among the
/// inputs that match it, which is how it is found again (`ui_refocus`).
UiState focus_on(UiState ui, Widget root, Int id, Widget w) {
    UiState u = match (w) {
        TextInput(s, k, m) => ui_with_focus_input(ui, id, m, echoes(m, s), false, 0),
        // a password's message is compared whole: its text cannot be read
        PasswordInput(s, k, m) => ui_with_focus_input(ui, id, m, false, true, 0),
        _ => ui_with_focus_on(ui, id, msg_of(w))
    };
    if (id < 0) { return u; }
    return ui_with_focus_input(u, id, u.fmsg, u.fecho, u.fpw, matches_before(root, u, 0, id, 0));
}

/// Whether an input with message `m` and text `s` has the focused
/// input's message: equal to the one it had when focused, payload and
/// all, so that `Changed("name")` and `Changed("email")` are two inputs
/// (R4-6); an input whose message echoed its own text then
/// (`Changed(text)`, which typing changes) also matches by still echoing
/// its text.
pub Bool focus_matches(UiState ui, Msg m, Str s) {
    return msg_eq(m, ui.fmsg) || (ui.fecho && echoes(m, s));
}

/// Whether widget `w` matches the focused input: the same kind (a
/// password's keys never go to a text input, nor a text input's to a
/// password, R5-1) and message (`focus_matches`).
pub Bool focus_like(UiState ui, Widget w) {
    return match (w) {
        TextInput(s, k, m) => !ui.fpw && focus_matches(ui, m, s),
        PasswordInput(s, k, m) => ui.fpw && msg_eq(m, ui.fmsg),
        _ => false
    };
}

/// Keep focus on the input that was focused. The view can renumber widgets
/// between events (a line inserted above, a row removed), and the number
/// in `ui.focus` may then name another input: keys must not go to it. The
/// focused input is the one at its place (`ui.ford`) among the inputs
/// like it, in pre-order: a line inserted above moves its number, not its
/// place (R5-5). When there is no input at that place, focus is dropped.
pub UiState ui_refocus(UiState ui, Widget root, Rect area, Font fo) {
    if (ui.focus < 0) { return ui; }
    Int at = seek_like(root, ui, 0, Seek { .seen = 0, .at = -1 }).at;
    if (at == ui.focus) { return ui; }
    return if (at < 0) { ui_with_focus(ui, -1) } else { ui_with_focus_moved(ui, at) };
}

/// How many inputs like the focused one are numbered before `upto`.
Int matches_before(Widget w, UiState ui, Int id, Int upto, Int n) {
    if (id >= upto) { return n; }
    return matches_before_kids(children(w), ui, 0, id + 1, upto, if (focus_like(ui, w)) { n + 1 } else { n });
}

Int matches_before_kids(List(Widget) xs, UiState ui, Int i, Int id, Int upto, Int n) {
    if (i >= xs.len() || id >= upto) { return n; }
    return matches_before_kids(xs, ui, i + 1, id + node_count(xs[i]), upto, matches_before(xs[i], ui, id, upto, n));
}

/// A search for the input at place `ford`: how many like it were passed,
/// and its number once found (-1 until then).
type Seek = { Int seen; Int at; };

Seek seek_like(Widget w, UiState ui, Int id, Seek s) {
    if (s.at >= 0) { return s; }
    Seek here = if (focus_like(ui, w)) { Seek { .seen = s.seen + 1, .at = if (s.seen == ui.ford) { id } else { -1 } } } else { s };
    return seek_kids(children(w), ui, 0, id + 1, here);
}

Seek seek_kids(List(Widget) xs, UiState ui, Int i, Int id, Seek s) {
    if (i >= xs.len() || s.at >= 0) { return s; }
    return seek_kids(xs, ui, i + 1, id + node_count(xs[i]), seek_like(xs[i], ui, id, s));
}

UiStep pointer_moved(UiState ui, Widget root, Rect area, Int x, Font fo) {
    if (ui.pressed < 0) { return none(ui); }
    Found f = pressed_in(ui, root, area, fo);
    return match (f.w) {
        Slider(v, m) => UiStep { .ui = ui, .out = [SliderSet(m, slider_value_at(f.r, x))] },
        TextInput(s, k, m) => UiStep { .ui = ui, .out = [TextEdited(m, s, caret_at_in(f.r, s, k, x, fo))] },
        PasswordInput(s, k, m) => UiStep { .ui = ui, .out = [PasswordEdited(m, s, caret_at_in(f.r, password_bullets(s), k, x, fo))] },
        _ => none(ui)
    };
}

UiStep pointer_up(UiState ui, Widget root, Rect area, Int x, Int y, Font fo) {
    UiState released = ui_with_pressed(ui, -1);
    if (ui.pressed < 0) { return none(released); }
    Found f = pressed_in(ui, root, area, fo);
    Bool inside = hit_in(root, area, x, y, fo).id == ui.pressed;
    return match (f.w) {
        Button(s, m) => UiStep { .ui = released, .out = if (inside) { [AppMsg(m)] } else { [] } },
        Checkbox(s, c, m) => UiStep { .ui = released, .out = if (inside) { [AppMsg(m)] } else { [] } },
        _ => none(released)
    };
}

@requires(declassify)
UiStep key_down(UiState ui, Widget root, Rect area, Int code, Str text, Font fo) {
    // A key that types something types it, whatever its code.
    Bool typing = str_len(text) > 0;
    if ((is_shift(code) || is_ctrl(code)) && !typing) { return none(mods_after(ui, code, true)); }
    if (code == key_tab() && !typing) {
        List(Int) ids = tab_inputs(root, area, ui, fo);
        Int to = if (ui.shift) { prev_input(ids, ui.focus) } else { next_input(ids, ui.focus) };
        return none(focus_on(ui, root, to, find_in(root, area, to, fo).w));
    }
    if (ui.focus < 0) { return none(ui); }
    if (code == key_esc() && !typing) { return none(ui_with_focus(ui, -1)); }
    UiState u = ui_refocus(ui, root, area, fo);
    if (u.focus < 0) { return none(u); }
    Found f = find_in(root, area, u.focus, fo);
    return match (f.w) {
        TextInput(s, k, m) => key_in_input(u, s, clamp_int(k, 0, str_len(s)), m, code, text),
        PasswordInput(s, k, m) => key_in_password(u, s, clamp_int(k, 0, s.len()), m, code, text),
        _ => none(ui_with_focus(u, -1))
    };
}

UiStep key_in_input(UiState ui, Str s, Int k, Msg m, Int code, Str text) {
    Edited e = edit_sel(s, k, ui.anchor, m, code, text, ui.shift, ui.ctrl);
    return UiStep { .ui = ui_with_anchor(ui_with_caret(ui, true), e.anchor), .out = e.out };
}

@requires(declassify)
UiStep key_in_password(UiState ui, Secret(Str) s, Int k, Msg m, Int code, Str text) {
    Edited e = edit_password(s, k, ui.anchor, m, code, text, ui.shift, ui.ctrl);
    return UiStep { .ui = ui_with_anchor(ui_with_caret(ui, true), e.anchor), .out = e.out };
}

/// `edit_sel` for a password holding `s`: the same keys, worked out from
/// its length alone (public, spec §48); a change to the text is a splice
/// of the typed text (`pw_splice`) between two caret positions.
@requires(declassify)
pub Edited edit_password(Secret(Str) s, Int k, Int a0, Msg m, Int code, Str text, Bool shift, Bool ctrl) {
    Int n = s.len();
    Int a = if (a0 < 0 || a0 > n) { k } else { a0 };
    Int lo = min_int(a, k);
    Int hi = max_int(a, k);
    Bool sel = lo != hi;
    if (ctrl && code == key_a() && str_len(text) == 0) { return Edited { .out = [PasswordEdited(m, s, n)], .anchor = 0 }; }
    if (str_len(text) > 0) { return Edited { .out = [PasswordEdited(m, pw_splice(s, lo, hi, text), lo + str_len(text))], .anchor = -1 }; }
    if (code == key_enter() || code == key_kp_enter()) { return Edited { .out = [AppMsg(m)], .anchor = a0 }; }
    Bool erase = code == key_backspace() || code == key_delete();
    if (erase && sel) { return Edited { .out = [PasswordEdited(m, pw_splice(s, lo, hi, ""), lo)], .anchor = -1 }; }
    if (code == key_backspace()) { return Edited { .out = if (k > 0) { [PasswordEdited(m, pw_splice(s, k - 1, k, ""), k - 1)] } else { [] }, .anchor = -1 }; }
    if (code == key_delete()) { return Edited { .out = if (k < n) { [PasswordEdited(m, pw_splice(s, k, k + 1, ""), k)] } else { [] }, .anchor = -1 }; }
    Int t = if (code == key_left()) { if (sel && !shift) { lo } else { max_int(k - 1, 0) } }
            else { if (code == key_right()) { if (sel && !shift) { hi } else { min_int(k + 1, n) } }
            else { if (code == key_home()) { 0 } else { if (code == key_end()) { n } else { -1 } } } };
    if (t < 0) { return Edited { .out = [], .anchor = a0 }; }
    return Edited { .out = if (t != k) { [PasswordEdited(m, s, t)] } else { [] }, .anchor = if (shift) { a } else { -1 } };
}

/// Password text `s` with characters `lo` to `hi` replaced by `ins`. The
/// one place the library declassifies: the text is read here to splice
/// the keystroke in and wrapped again at once, and goes nowhere else.
/// (`classify`, not `secret`, for the result: E0250 would refuse a
/// secret the compiler can work out, as it can in a test's literal
/// view; at run time the text is the user's typing.)
@requires(declassify)
pub Secret(Str) pw_splice(Secret(Str) s, Int lo, Int hi, Str ins) {
    Str p = declassify(s, "a password input splices a keystroke into its own text");
    Int n = str_len(p);
    Int a = clamp_int(lo, 0, n);
    Int b = clamp_int(hi, a, n);
    return classify(str_slice(p, 0, a) + ins + str_slice(p, b, n));
}

/// The input before `cur` in tab order, wrapping; -1 when there is none.
pub Int prev_input(List(Int) ids, Int cur) {
    if (ids.len() == 0) { return -1; }
    return prev_input_at(ids, cur, ids.len() - 1);
}

Int prev_input_at(List(Int) ids, Int cur, Int i) {
    if (i < 0) { return ids[ids.len() - 1]; }
    if (ids[i] < cur || cur < 0) { return ids[i]; }
    return prev_input_at(ids, cur, i - 1);
}

/// What a key does to a text input holding `s` with the caret at `k` and
/// the selection anchored at `a` (-1 for none), with Shift or Ctrl held.
/// Typing, Backspace and Delete replace a selection; the arrows, Home and
/// End move the caret, extending the selection with Shift and collapsing
/// it without; Ctrl+A selects everything.
pub Edited edit_sel(Str s, Int k, Int a0, Msg m, Int code, Str text, Bool shift, Bool ctrl) {
    Int n = str_len(s);
    Int a = if (a0 < 0 || a0 > n) { k } else { a0 };
    Int lo = min_int(a, k);
    Int hi = max_int(a, k);
    Bool sel = lo != hi;
    if (ctrl && code == key_a() && str_len(text) == 0) { return Edited { .out = [TextEdited(m, s, n)], .anchor = 0 }; }
    if (str_len(text) > 0) { return Edited { .out = [TextEdited(m, str_slice(s, 0, lo) + text + str_slice(s, hi, n), lo + str_len(text))], .anchor = -1 }; }
    if (code == key_enter() || code == key_kp_enter()) { return Edited { .out = [AppMsg(m)], .anchor = a0 }; }
    Bool erase = code == key_backspace() || code == key_delete();
    if (erase && sel) { return Edited { .out = [TextEdited(m, str_slice(s, 0, lo) + str_slice(s, hi, n), lo)], .anchor = -1 }; }
    if (erase) { return Edited { .out = edit(s, k, m, code, text), .anchor = -1 }; }
    Int t = if (code == key_left()) { if (sel && !shift) { lo } else { max_int(k - 1, 0) } }
            else { if (code == key_right()) { if (sel && !shift) { hi } else { min_int(k + 1, n) } }
            else { if (code == key_home()) { 0 } else { if (code == key_end()) { n } else { -1 } } } };
    if (t < 0) { return Edited { .out = [], .anchor = a0 }; }
    return Edited { .out = if (t != k) { [TextEdited(m, s, t)] } else { [] }, .anchor = if (shift) { a } else { -1 } };
}

/// What a key does to a text input holding `s` with the caret at `k`,
/// with nothing selected.
pub List(Event) edit(Str s, Int k, Msg m, Int code, Str text) {
    Int n = str_len(s);
    if (str_len(text) > 0) { return [TextEdited(m, str_slice(s, 0, k) + text + str_slice(s, k, n), k + str_len(text))]; }
    if (code == key_enter() || code == key_kp_enter()) { return [AppMsg(m)]; }
    if (code == key_backspace()) {
        return if (k > 0) { [TextEdited(m, str_slice(s, 0, k - 1) + str_slice(s, k, n), k - 1)] } else { [] };
    }
    if (code == key_delete()) {
        return if (k < n) { [TextEdited(m, str_slice(s, 0, k) + str_slice(s, k + 1, n), k)] } else { [] };
    }
    if (code == key_left()) { return if (k > 0) { [TextEdited(m, s, k - 1)] } else { [] }; }
    if (code == key_right()) { return if (k < n) { [TextEdited(m, s, k + 1)] } else { [] }; }
    if (code == key_home()) { return [TextEdited(m, s, 0)]; }
    if (code == key_end()) { return [TextEdited(m, s, n)]; }
    return [];
}

// ─── Tests ──────────────────────────────────────────────────────────

Widget demo() { return Column([Text("t"), Button("go", Custom(1)), TextInput("ab", 2, Custom(2)), Slider(10, Custom(3)), TextInput("", 0, Custom(4))]); }
Rect demo_area() { return Rect { .x = 0, .y = 0, .w = 200, .h = 200 }; }

Bool is_msg(Event e, Msg want) { return match (e) { AppMsg(m) => msg_eq(m, want), _ => false }; }

test "hit finds the control under the pointer" {
    // Column children: Text 0-24, Button 28-60, TextInput 64-96, Slider 100-124.
    expect(hit(demo(), demo_area(), 5, 5).id).toEqual(-1);
    expect(hit(demo(), demo_area(), 5, 30).id).toEqual(2);
    expect(hit(demo(), demo_area(), 5, 70).id).toEqual(3);
    expect(hit(demo(), demo_area(), 5, 100).id).toEqual(4);
    expect(find(demo(), demo_area(), 3).r.y).toEqual(64);
    expect(inputs(demo()).len()).toEqual(2);
    expect(next_input(inputs(demo()), 3)).toEqual(5);
    expect(next_input(inputs(demo()), 5)).toEqual(3);
}

@requires(declassify)
test "a click is a press and a release on the same button" {
    UiStep a = ui_event(ui_new(), demo(), demo_area(), PointerDown(5, 30, 1));
    expect(a.ui.pressed).toEqual(2);
    expect(a.out.len()).toEqual(1);
    UiStep b = ui_event(a.ui, demo(), demo_area(), PointerUp(6, 31, 1));
    expect(b.ui.pressed).toEqual(-1);
    expect(b.out.len()).toEqual(2);
    expect(is_msg(b.out[1], Custom(1))).toEqual(true);
    // Released somewhere else: no click.
    UiStep c = ui_event(a.ui, demo(), demo_area(), PointerUp(5, 5, 1));
    expect(c.out.len()).toEqual(1);
}

@requires(declassify)
test "clicking an input focuses it and typing edits at the caret" {
    UiStep a = ui_event(ui_new(), demo(), demo_area(), PointerDown(100, 70, 1));
    expect(a.ui.focus).toEqual(3);
    UiStep b = ui_event(a.ui, demo(), demo_area(), KeyDown(30, "x"));
    expect(b.out.len()).toEqual(2);
    Bool ok = match (b.out[1]) { TextEdited(m, s, k) => s == "abx" && k == 3, _ => false };
    expect(ok).toEqual(true);
    List(Event) bs = edit("abc", 1, Clicked, key_backspace(), "");
    Bool ok2 = match (bs[0]) { TextEdited(m, s, k) => s == "bc" && k == 0, _ => false };
    expect(ok2).toEqual(true);
    expect(is_msg(edit("abc", 1, Submitted, key_enter(), "")[0], Submitted)).toEqual(true);
    expect(ui_event(a.ui, demo(), demo_area(), KeyDown(key_esc(), "")).ui.focus).toEqual(-1);
    expect(ui_event(a.ui, demo(), demo_area(), KeyDown(key_tab(), "")).ui.focus).toEqual(5);
}

@requires(declassify)
test "dragging a slider reports values" {
    UiStep a = ui_event(ui_new(), demo(), demo_area(), PointerDown(6, 100, 1));
    Bool zero = match (a.out[1]) { SliderSet(m, v) => v == 0, _ => false };
    expect(zero).toEqual(true);
    UiStep b = ui_event(a.ui, demo(), demo_area(), PointerMoved(500, 100));
    Bool full = match (b.out[1]) { SliderSet(m, v) => v == 100, _ => false };
    expect(full).toEqual(true);
}

test "a click in a long list reaches the row under it" {
    List(Widget) rows = [Button("a", Custom(0)), Button("b", Custom(1)), Button("c", Custom(2)), Button("d", Custom(3))];
    Widget root = Column([Text("title"), Rows(30, 20, rows)]);
    Rect area = Rect { .x = 0, .y = 0, .w = 100, .h = 100 };
    // the list starts at y 28 (24 + gap); scrolled 30, y 40 is 42 into it: row 2
    Found f = hit(root, area, 10, 40);
    Bool c = match (f.w) { Button(s, m) => s == "c", _ => false };
    expect(c).toEqual(true);
    expect(f.id).toEqual(5);
    expect(find(root, area, 5).r.y).toEqual(f.r.y);
}

Str edited_text(List(Event) es) { return match (es[es.len() - 1]) { TextEdited(m, s, k) => s, _ => "?" }; }
Int edited_caret(List(Event) es) { return match (es[es.len() - 1]) { TextEdited(m, s, k) => k, _ => -1 }; }

@requires(declassify)
test "Shift-Tab moves focus backwards" {
    UiState down = ui_event(ui_new(), demo(), demo_area(), KeyDown(key_left_shift(), "")).ui;
    expect(down.shift).toEqual(true);
    expect(ui_event(down, demo(), demo_area(), KeyDown(key_tab(), "")).ui.focus).toEqual(5);
    UiState at5 = ui_with_focus(down, 5);
    expect(ui_event(at5, demo(), demo_area(), KeyDown(key_tab(), "")).ui.focus).toEqual(3);
    UiState up = ui_event(at5, demo(), demo_area(), KeyUp(key_left_shift())).ui;
    expect(up.shift).toEqual(false);
    expect(ui_event(up, demo(), demo_area(), KeyDown(key_tab(), "")).ui.focus).toEqual(3);
    expect(prev_input([3, 5], 3)).toEqual(5);
}

test "Shift and the arrows select, and typing replaces the selection" {
    Edited a = edit_sel("hello", 5, -1, Clicked, key_left(), "", true, false);
    expect(a.anchor).toEqual(5);
    expect(edited_caret(a.out)).toEqual(4);
    Edited b = edit_sel("hello", 4, 5, Clicked, key_home(), "", true, false);
    expect(b.anchor).toEqual(5);
    expect(edited_caret(b.out)).toEqual(0);
    Edited c = edit_sel("hello", 0, 5, Clicked, 0, "J", false, false);
    expect(edited_text(c.out)).toEqual("J");
    expect(c.anchor).toEqual(-1);
    Edited d = edit_sel("hello", 1, 4, Clicked, key_backspace(), "", false, false);
    expect(edited_text(d.out)).toEqual("ho");
    expect(edited_caret(d.out)).toEqual(1);
    // an arrow without Shift collapses the selection to its edge
    Edited e = edit_sel("hello", 1, 4, Clicked, key_right(), "", false, false);
    expect(edited_caret(e.out)).toEqual(4);
    expect(e.anchor).toEqual(-1);
    Edited all = edit_sel("hello", 2, -1, Clicked, key_a(), "", false, true);
    expect(all.anchor).toEqual(0);
    expect(edited_caret(all.out)).toEqual(5);
}

@requires(declassify)
test "dragging across an input selects" {
    Widget w = Column([TextInput("abcdef", 0, Custom(1))]);
    Rect area = Rect { .x = 0, .y = 0, .w = 200, .h = 40 };
    // characters are 8 pixels wide from x 5
    UiStep a = ui_event(ui_new(), w, area, PointerDown(5 + 8, 10, 1));
    expect(a.ui.anchor).toEqual(1);
    UiStep b = ui_event(a.ui, w, area, PointerMoved(5 + 32, 10));
    expect(edited_caret(b.out)).toEqual(4);
    expect(b.ui.anchor).toEqual(1);
}

@requires(declassify)
test "an assistive activation clicks; an assistive focus focuses" {
    Widget v = Column([Button("ok", Clicked), TextInput("x", 1, Custom(1))]);
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    UiStep a = ui_event(ui_new(), v, r, Assist(1, act_activate()));
    Bool clicked = a.out.len() == 2 && match (a.out[1]) { AppMsg(m) => msg_eq(m, Clicked), _ => false };
    expect(clicked).toEqual(true);
    expect(ui_event(ui_new(), v, r, Assist(2, act_focus())).ui.focus).toEqual(2);
    expect(ui_event(ui_new(), v, r, Assist(9, act_activate())).out.len()).toEqual(1);
}

/// Whether the step raised `m`.
Bool raised(UiStep s, Msg m, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { AppMsg(x) => msg_eq(x, m), _ => false };
    return hit || raised(s, m, i + 1);
}

@requires(declassify)
test "a release raises nothing when the view changed the pressed widget" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    Widget before = Column([Button("a", Custom(1)), Button("keep", Custom(2))]);
    // the same place, numbered the same, now a different button
    Widget after = Column([Button("a", Custom(1)), Button("delete", Custom(3))]);
    Found b = find(before, r, 2);
    Int x = b.r.x + 2;
    Int y = b.r.y + 2;
    UiStep down = ui_event(ui_new(), before, r, PointerDown(x, y, 1));
    UiStep up = ui_event(down.ui, after, r, PointerUp(x, y, 1));
    expect(raised(up, Custom(3), 0)).toEqual(false);
    expect(up.ui.pressed).toEqual(-1);
    // an unchanged view still clicks
    expect(raised(ui_event(down.ui, before, r, PointerUp(x, y, 1)), Custom(2), 0)).toEqual(true);
}

@requires(declassify)
test "an assistive action reaches only what a click could" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Stack 0, Button "del" 1, Button "cover" 2: cover is drawn over del
    Widget stacked = Stack([Button("del", Custom(1)), Button("cover", Custom(2))]);
    expect(raised(ui_event(ui_new(), stacked, r, Assist(1, act_activate())), Custom(1), 0)).toEqual(false);
    expect(raised(ui_event(ui_new(), stacked, r, Assist(2, act_activate())), Custom(2), 0)).toEqual(true);
    // Scroll 0, Column 1, Button 2, scrolled 500 above a view 100 tall
    Widget scrolled = Scroll(500, Column([Button("gone", Custom(1)), Text("x")]));
    expect(raised(ui_event(ui_new(), scrolled, r, Assist(2, act_activate())), Custom(1), 0)).toEqual(false);
    // a text input laid out past the window's bottom cannot be focused
    Widget below = Column([Spacer, TextInput("x", 1, Custom(3))]);
    UiStep low = ui_event(ui_new(), below, Rect { .x = 0, .y = 0, .w = 200, .h = 0 }, Assist(2, act_focus()));
    expect(low.ui.focus).toEqual(-1);
}

/// Whether the step raised any message, or edited input `m`.
Bool raised_any(UiStep s, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { AppMsg(x) => true, _ => false };
    return hit || raised_any(s, i + 1);
}

Bool edited(UiStep s, Msg m, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { TextEdited(x, t, k) => msg_eq(x, m), _ => false };
    return hit || edited(s, m, i + 1);
}

@requires(declassify)
test "keys go to the input that was focused, not to the one now numbered so (R3-4)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    Widget before = Column([TextInput("a", 1, Custom(1)), TextInput("b", 1, Custom(2))]);
    UiState on2 = ui_event(ui_new(), before, r, Assist(2, act_focus())).ui;
    expect(on2.focus).toEqual(2);
    // a line of text appears at the top: number 2 is now the first input
    Widget after = Column([Text("new"), TextInput("a", 1, Custom(1)), TextInput("b", 1, Custom(2))]);
    UiStep typed = ui_event(on2, after, r, KeyDown(30, "x"));
    expect(edited(typed, Custom(1), 0)).toEqual(false);
    UiStep enter = ui_event(on2, after, r, KeyDown(key_enter(), ""));
    expect(raised(enter, Custom(1), 0)).toEqual(false);
    // the focused input is followed to its new number
    expect(edited(typed, Custom(2), 0)).toEqual(true);
    expect(typed.ui.focus).toEqual(3);
    expect(raised(enter, Custom(2), 0)).toEqual(true);
    // gone altogether: focus is dropped and the key does nothing
    Widget gone = Column([TextInput("a", 1, Custom(1)), Text("b")]);
    UiStep none2 = ui_event(on2, gone, r, KeyDown(30, "x"));
    expect(edited(none2, Custom(1), 0)).toEqual(false);
    expect(none2.ui.focus).toEqual(-1);
    // an input whose message carries its text is the same input as it types
    Widget ch = Column([TextInput("a", 1, Changed("a"))]);
    UiState onc = ui_event(ui_new(), ch, r, Assist(1, act_focus())).ui;
    expect(edited(ui_event(onc, Column([TextInput("ab", 2, Changed("ab"))]), r, KeyDown(30, "x")), Changed("ab"), 0)).toEqual(true);
}

@requires(declassify)
test "a release raises nothing when index-keyed rows renumber under it (R3-6)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    // a delete button per row, keyed by the row's index
    Widget abc = Column([Button("A", Custom(0)), Button("B", Custom(1)), Button("C", Custom(2))]);
    Found b = find(abc, r, 2);
    Int x = b.r.x + 2;
    Int y = b.r.y + 2;
    UiStep down = ui_event(ui_new(), abc, r, PointerDown(x, y, 1));
    expect(down.ui.pressed).toEqual(2);
    // before the release, an update removes A: C now sits where B was, as Custom(1)
    Widget bc = Column([Button("B", Custom(0)), Button("C", Custom(1))]);
    UiStep up = ui_event(down.ui, bc, r, PointerUp(x, y, 1));
    expect(raised_any(up, 0)).toEqual(false);
    // unchanged rows still click
    expect(raised(ui_event(down.ui, abc, r, PointerUp(x, y, 1)), Custom(1), 0)).toEqual(true);
}

Bool scrolled_to(UiStep s, Int node, Int off, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { ScrollTo(n, o) => n == node && o == off, _ => false };
    return hit || scrolled_to(s, node, off, i + 1);
}

@requires(declassify)
test "a reader can scroll to an off-screen node, but not act on it (R3-3)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Scroll 0, Column 1, Button "top" 2 (0..32), Padding 3, Spacer 4,
    // Button "far" 5 at y 436..468
    Widget w = Scroll(0, Column([Button("top", Custom(1)), Padding(200, Spacer), Button("far", Custom(2))]));
    Found far = find(w, r, 5);
    // activating it does nothing; asking to see it scrolls its bottom into view
    expect(raised(ui_event(ui_new(), w, r, Assist(5, act_activate())), Custom(2), 0)).toEqual(false);
    UiStep s = ui_event(ui_new(), w, r, Assist(5, act_scroll()));
    expect(scrolled_to(s, 0, far.r.y + far.r.h - 100, 0)).toEqual(true);
    // scrolled there, it shows and can be activated; scrolling to it again does nothing
    Widget there = Scroll(far.r.y + far.r.h - 100, Column([Button("top", Custom(1)), Padding(200, Spacer), Button("far", Custom(2))]));
    expect(raised(ui_event(ui_new(), there, r, Assist(5, act_activate())), Custom(2), 0)).toEqual(true);
    expect(ui_event(ui_new(), there, r, Assist(5, act_scroll())).out.len()).toEqual(1);
    // and back up to "top", which is now above the view: its top at the view's top
    expect(scrolled_to(ui_event(ui_new(), there, r, Assist(2, act_scroll())), 0, 0, 0)).toEqual(true);
    // no Scroll, nothing to do
    expect(ui_event(ui_new(), Column([Padding(200, Spacer), Button("below", Custom(3))]), r, Assist(3, act_scroll())).out.len()).toEqual(1);
}

@requires(declassify)
test "Tab skips inputs scrolled out of view or covered (R3-3)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Column 0, TextInput a 1, Scroll 2 (scrolled 500 past its content),
    // Column 3, Padding 4, Spacer 5, TextInput hidden 6, Stack 7, TextInput covered 8, Button cover 9,
    // TextInput b 10
    Widget w = Column([TextInput("a", 1, Custom(1)),
                       Scroll(500, Column([Padding(100, Spacer), TextInput("hidden", 1, Custom(2))])),
                       Stack([TextInput("covered", 1, Custom(3)), Button("cover", Custom(4))]),
                       TextInput("b", 1, Custom(5))]);
    Rect big = Rect { .x = 0, .y = 0, .w = 200, .h = 400 };
    UiState on1 = ui_event(ui_new(), w, big, Assist(1, act_focus())).ui;
    expect(on1.focus).toEqual(1);
    UiState next = ui_event(on1, w, big, KeyDown(key_tab(), "")).ui;
    expect(next.focus).toEqual(10);
    expect(ui_event(next, w, big, KeyDown(key_tab(), "")).ui.focus).toEqual(1);
    expect(tab_inputs(w, big, ui_new(), font_builtin())).toEqual([1, 10]);
}

@requires(declassify)
test "an off-screen field under a modal cannot be scrolled to (R4-1)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Stack 0, Scroll 1, Column 2, Padding 3, Spacer 4, TextInput 5, Button 6
    Widget w = Stack([Scroll(0, Column([Padding(200, Spacer), TextInput("secret", 0, Custom(1))])), Button("modal", Custom(2))]);
    UiStep s = ui_event(ui_new(), w, r, Assist(5, act_scroll()));
    expect(s.out.len()).toEqual(1);
    expect(ui_event(ui_new(), w, r, Assist(5, act_focus())).ui.focus).toEqual(-1);
}

@requires(declassify)
test "a field under an overlay that scrolls with it cannot be scrolled to (R5-2)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Scroll 0, Column 1, Padding 2, Spacer 3, Stack 4, TextInput 5, Button 6
    Widget w = Scroll(0, Column([Padding(200, Spacer), Stack([TextInput("secret", 0, Custom(1)), Button("modal", Custom(2))])]));
    UiStep s = ui_event(ui_new(), w, r, Assist(5, act_scroll()));
    expect(s.out.len()).toEqual(1);
    // the modal itself can be
    expect(ui_event(ui_new(), w, r, Assist(6, act_scroll())).out.len()).toEqual(2);
}

/// A row per name, each with a Dismiss button keyed by its index.
Widget dismiss_rows(List(Str) names, Int i, ListBuf(Widget) acc) {
    if (i >= names.len()) { return Column(acc.finish()); }
    return dismiss_rows(names, i + 1, acc.push(Row([Text(names[i]), Button("Dismiss", Custom(i))])));
}

@requires(declassify)
test "a release raises nothing when rows with the same label renumber under it (R4-5)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    // Column 0, Row 1, Text A 2, Dismiss 3, Row 4, Text B 5, Dismiss 6, ...
    Widget abc = dismiss_rows(["A", "B", "C"], 0, ListBuf());
    Found b = find(abc, r, 6);
    Int x = b.r.x + 2;
    Int y = b.r.y + 2;
    UiStep down = ui_event(ui_new(), abc, r, PointerDown(x, y, 1));
    expect(down.ui.pressed).toEqual(6);
    // a tick removes A: C's Dismiss, now Custom(1), is number 6, in B's place
    Widget bc = dismiss_rows(["B", "C"], 0, ListBuf());
    expect(find(bc, r, 6).r.y).toEqual(b.r.y);
    UiStep up = ui_event(down.ui, bc, r, PointerUp(x, y, 1));
    expect(raised_any(up, 0)).toEqual(false);
    expect(up.ui.pressed).toEqual(-1);
    // unchanged rows still click, and so does a change after the pressed one
    expect(raised(ui_event(down.ui, abc, r, PointerUp(x, y, 1)), Custom(1), 0)).toEqual(true);
    Widget abd = dismiss_rows(["A", "B", "D"], 0, ListBuf());
    expect(raised(ui_event(down.ui, abd, r, PointerUp(x, y, 1)), Custom(1), 0)).toEqual(true);
    // a slider dragged changes its own value, which does not cancel the drag
    Widget sl = Column([Text("vol"), Slider(10, Custom(7))]);
    Found s = find(sl, r, 2);
    UiStep sd = ui_event(ui_new(), sl, r, PointerDown(s.r.x + 5, s.r.y + 2, 1));
    UiStep sm = ui_event(sd.ui, Column([Text("vol"), Slider(60, Custom(7))]), r, PointerMoved(s.r.x + s.r.w - 5, s.r.y + 2));
    expect(sm.out.len()).toEqual(2);
}

@requires(declassify)
test "inputs told apart by Changed tags keep their own focus (R4-6)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    Widget before = Column([TextInput("ann", 3, Changed("name")), TextInput("a@b", 3, Changed("email"))]);
    UiState on2 = ui_event(ui_new(), before, r, Assist(2, act_focus())).ui;
    expect(on2.focus).toEqual(2);
    // a line appears at the top: number 2 is now the name input
    Widget after = Column([Text("new"), TextInput("ann", 3, Changed("name")), TextInput("a@b", 3, Changed("email"))]);
    UiStep typed = ui_event(on2, after, r, KeyDown(30, "x"));
    expect(edited(typed, Changed("name"), 0)).toEqual(false);
    expect(edited(typed, Changed("email"), 0)).toEqual(true);
    expect(typed.ui.focus).toEqual(3);
    // an input whose message echoes its text still follows itself as it types
    Widget echo = Column([TextInput("a", 1, Changed("a")), TextInput("z", 1, Custom(9))]);
    UiState one = ui_event(ui_new(), echo, r, Assist(1, act_focus())).ui;
    Widget moved = Column([Text("new"), TextInput("ab", 2, Changed("ab")), TextInput("z", 1, Custom(9))]);
    UiStep t2 = ui_event(one, moved, r, KeyDown(30, "x"));
    expect(edited(t2, Changed("ab"), 0)).toEqual(true);
    expect(t2.ui.focus).toEqual(2);
    // but a tag input is not taken for an echo of another's text
    Widget tag = Column([Text("new"), TextInput("q", 1, Changed("other")), TextInput("z", 1, Custom(9))]);
    expect(ui_event(one, tag, r, KeyDown(30, "x")).ui.focus).toEqual(-1);
}

@requires(declassify)
test "a release still clicks when only text before the button changed (R5-3)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    // a clock or a counter above a button ticks between press and release
    Widget before = Column([Text("12:00:01"), Checkbox("loud", false, Custom(2)), Button("Save", Custom(1))]);
    Widget after = Column([Text("12:00:02"), Checkbox("quiet", true, Custom(2)), Button("Save", Custom(1))]);
    Found b = find(before, r, 3);
    UiStep down = ui_event(ui_new(), before, r, PointerDown(b.r.x + 2, b.r.y + 2, 1));
    expect(down.ui.pressed).toEqual(3);
    expect(raised(ui_event(down.ui, after, r, PointerUp(b.r.x + 2, b.r.y + 2, 1)), Custom(1), 0)).toEqual(true);
    // a reader's action survives the same tick
    expect(press_print(before, 3)).toEqual(press_print(after, 3));
    // but not one whose own label changed
    expect(press_print(before, 3) == press_print(Column([Text("x"), Checkbox("loud", false, Custom(2)), Button("Delete", Custom(1))]), 3)).toEqual(false);
}

/// Whether the step passed a raw `KeyDown` on.
Bool raw_key(UiStep s, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { KeyDown(c, t) => true, _ => false };
    return hit || raw_key(s, i + 1);
}

Bool pw_edited(UiStep s, Int i) {
    if (i >= s.out.len()) { return false; }
    Bool hit = match (s.out[i]) { PasswordEdited(m, x, k) => true, _ => false };
    return hit || pw_edited(s, i + 1);
}

@requires(declassify)
test "a password's keys never go to a text input that takes its number (R5-1)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    // Column 0, TextInput 1, PasswordInput 2: both raise Submitted
    Widget before = Column([TextInput("ann", 3, Submitted), PasswordInput(password_empty(), 0, Submitted)]);
    UiState on2 = ui_event(ui_new(), before, r, Assist(2, act_focus())).ui;
    expect(on2.focus).toEqual(2);
    // Enter was wrong: a line appears at the top, and number 2 is the user name
    Widget after = Column([Text("Wrong password"), TextInput("ann", 3, Submitted), PasswordInput(password_empty(), 0, Submitted)]);
    UiStep typed = ui_event(on2, after, r, KeyDown(30, "x"));
    expect(edited(typed, Submitted, 0)).toEqual(false);
    expect(raw_key(typed, 0)).toEqual(false);
    expect(typed.ui.focus == -1 || typed.ui.focus == 3).toEqual(true);
    // and a text input's keys do not go to a password now numbered as it was
    UiState on1 = ui_event(ui_new(), before, r, Assist(1, act_focus())).ui;
    Widget swapped = Column([PasswordInput(password_empty(), 0, Submitted), TextInput("ann", 3, Submitted)]);
    UiStep t2 = ui_event(on1, swapped, r, KeyDown(30, "x"));
    expect(pw_edited(t2, 0)).toEqual(false);
    expect(t2.ui.focus == -1 || t2.ui.focus == 2).toEqual(true);
}

@requires(declassify)
test "inputs whose messages echo their text keep their own focus (R5-5)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 200 };
    Widget before = Column([TextInput("ann", 3, Changed("ann")), TextInput("a@b", 3, Changed("a@b"))]);
    UiState on2 = ui_event(ui_new(), before, r, Assist(2, act_focus())).ui;
    Widget after = Column([Text("new"), TextInput("ann", 3, Changed("ann")), TextInput("a@b", 3, Changed("a@b"))]);
    UiStep typed = ui_event(on2, after, r, KeyDown(30, "x"));
    expect(edited(typed, Changed("ann"), 0)).toEqual(false);
    expect(edited(typed, Changed("a@b"), 0)).toEqual(true);
    expect(typed.ui.focus).toEqual(3);
    // a fixed tag that happened to equal the text when focused keeps focus
    // as the text changes
    UiState on = ui_event(ui_new(), Column([TextInput("name", 4, Changed("name"))]), r, Assist(1, act_focus())).ui;
    UiStep k1 = ui_event(on, Column([TextInput("name", 4, Changed("name"))]), r, KeyDown(30, "x"));
    UiStep k2 = ui_event(k1.ui, Column([TextInput("namex", 5, Changed("name"))]), r, KeyDown(30, "y"));
    expect(edited(k2, Changed("name"), 0)).toEqual(true);
    expect(k2.ui.focus).toEqual(1);
}
