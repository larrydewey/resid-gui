// layout.resid — where every widget goes.
//
// One function decides geometry, and both painting and hit testing ask it,
// so what is drawn and what is clicked can never disagree. Layout is
// natural-size: each widget has a preferred size; a `Row` or `Column`
// gives each child its preferred extent along its axis, then shares what
// is left equally among the children that stretch (`Spacer`, `TextInput`,
// `Slider`, `Scroll`, `Rows`, `Align`, and containers holding one of those). Across the
// axis, a child gets the whole box.

import "../app.resid";
import "../gfx/color.resid";
import "../gfx/font.resid";

/// A width and a height in logical pixels.
pub type Size = { Int w; Int h; };

/// The space between the children of a `Row` or a `Column`.
pub Int gap() { return 4; }

/// The height of one line of controls in the built-in font: 16-pixel
/// text plus padding.
pub Int line_h() { return 24; }

/// The height of one line of controls in font `f`.
pub Int line_h_in(Font f) { return text_height_in(f) + 8; }

/// A widget's preferred size in the built-in font.
pub Size pref_size(Widget w) { return pref_size_in(w, font_builtin()); }

/// A widget's preferred size with its text in font `f`.
pub Size pref_size_in(Widget w, Font f) {
    Int lh = line_h_in(f);
    return match (w) {
        Text(s) => Size { .w = text_width_in(f, s) + 8, .h = lh },
        Button(s, m) => Size { .w = text_width_in(f, s) + 20, .h = lh + 4 },
        Checkbox(s, c, m) => Size { .w = text_width_in(f, s) + 30, .h = lh },
        TextInput(s, k, m) => Size { .w = max_int(text_width_in(f, s) + 12, 120), .h = lh + 4 },
        Row(xs) => Size { .w = sum_w(xs, 0, 0, f) + gaps(xs), .h = max_h(xs, 0, 0, f) },
        Column(xs) => Size { .w = max_w(xs, 0, 0, f), .h = sum_h(xs, 0, 0, f) + gaps(xs) },
        Stack(xs) => Size { .w = max_w(xs, 0, 0, f), .h = max_h(xs, 0, 0, f) },
        Padding(n, c) => pad_size(pref_size_in(c, f), n),
        Align(ax, ay, c) => pref_size_in(c, f),
        Scroll(o, c) => pref_size_in(c, f),
        Rows(o, rh, xs) => Size { .w = 0, .h = 0 },
        Bitmap(bw, bh, px) => Size { .w = max_int(bw, 0), .h = max_int(bh, 0) },
        Slider(v, m) => Size { .w = 120, .h = lh },
        Spacer => Size { .w = 0, .h = 0 }
    };
}

Size pad_size(Size s, Int n) { return Size { .w = s.w + 2 * n, .h = s.h + 2 * n }; }

pub Int max_int(Int a, Int b) { return if (a > b) { a } else { b }; }
pub Int min_int(Int a, Int b) { return if (a < b) { a } else { b }; }
pub Int clamp_int(Int v, Int lo, Int hi) { return if (v < lo) { lo } else { if (v > hi) { hi } else { v } }; }

Int gaps(List(Widget) xs) { return if (xs.len() > 1) { (xs.len() - 1) * gap() } else { 0 }; }
Int sum_w(List(Widget) xs, Int i, Int acc, Font f) { return if (i >= xs.len()) { acc } else { sum_w(xs, i + 1, acc + pref_size_in(xs[i], f).w, f) }; }
Int sum_h(List(Widget) xs, Int i, Int acc, Font f) { return if (i >= xs.len()) { acc } else { sum_h(xs, i + 1, acc + pref_size_in(xs[i], f).h, f) }; }
Int max_w(List(Widget) xs, Int i, Int acc, Font f) { return if (i >= xs.len()) { acc } else { max_w(xs, i + 1, max_int(acc, pref_size_in(xs[i], f).w), f) }; }
Int max_h(List(Widget) xs, Int i, Int acc, Font f) { return if (i >= xs.len()) { acc } else { max_h(xs, i + 1, max_int(acc, pref_size_in(xs[i], f).h), f) }; }

/// Whether a widget takes leftover width in a `Row`.
pub Bool stretches_x(Widget w) {
    return match (w) {
        Spacer => true,
        TextInput(s, k, m) => true,
        Slider(v, m) => true,
        Scroll(o, c) => true,
        Rows(o, rh, xs) => true,
        Align(ax, ay, c) => true,
        Row(xs) => any_x(xs, 0),
        Column(xs) => any_x_across(xs, 0),
        Stack(xs) => any_x_across(xs, 0),
        Padding(n, c) => stretches_x(c),
        _ => false
    };
}

/// Whether a widget takes leftover height in a `Column`.
pub Bool stretches_y(Widget w) {
    return match (w) {
        Spacer => true,
        Scroll(o, c) => true,
        Rows(o, rh, xs) => true,
        Align(ax, ay, c) => true,
        Row(xs) => any_y_across(xs, 0),
        Column(xs) => any_y(xs, 0),
        Stack(xs) => any_y_across(xs, 0),
        Padding(n, c) => stretches_y(c),
        _ => false
    };
}

Bool any_x(List(Widget) xs, Int i) { return if (i >= xs.len()) { false } else { stretches_x(xs[i]) || any_x(xs, i + 1) }; }
Bool any_y(List(Widget) xs, Int i) { return if (i >= xs.len()) { false } else { stretches_y(xs[i]) || any_y(xs, i + 1) }; }
// Across a container's axis a Spacer is only a gap, so it does not make
// the container stretch that way.
Bool is_spacer(Widget w) { return match (w) { Spacer => true, _ => false }; }
Bool any_x_across(List(Widget) xs, Int i) { return if (i >= xs.len()) { false } else { (!is_spacer(xs[i]) && stretches_x(xs[i])) || any_x_across(xs, i + 1) }; }
Bool any_y_across(List(Widget) xs, Int i) { return if (i >= xs.len()) { false } else { (!is_spacer(xs[i]) && stretches_y(xs[i])) || any_y_across(xs, i + 1) }; }
Int count_x(List(Widget) xs, Int i, Int acc) { return if (i >= xs.len()) { acc } else { count_x(xs, i + 1, if (stretches_x(xs[i])) { acc + 1 } else { acc }) }; }
Int count_y(List(Widget) xs, Int i, Int acc) { return if (i >= xs.len()) { acc } else { count_y(xs, i + 1, if (stretches_y(xs[i])) { acc + 1 } else { acc }) }; }

/// The children of a widget, in drawing order.
pub List(Widget) children(Widget w) {
    return match (w) {
        Row(xs) => xs,
        Column(xs) => xs,
        Stack(xs) => xs,
        Padding(n, c) => [c],
        Align(ax, ay, c) => [c],
        Scroll(o, c) => [c],
        Rows(o, rh, xs) => xs,
        _ => []
    };
}

/// The box of each child when `w` occupies `r`, in the order `children`
/// gives them, in the built-in font.
pub List(Rect) child_rects(Widget w, Rect r) { return child_rects_in(w, r, font_builtin()); }

/// `child_rects` with text in font `f`.
pub List(Rect) child_rects_in(Widget w, Rect r, Font f) {
    return match (w) {
        Row(xs) => row_rects(xs, r, share(r.w - sum_w(xs, 0, 0, f) - gaps(xs), count_x(xs, 0, 0)), 0, r.x, [], f),
        Column(xs) => col_rects(xs, r, share(r.h - sum_h(xs, 0, 0, f) - gaps(xs), count_y(xs, 0, 0)), 0, r.y, [], f),
        Stack(xs) => same_rects(xs.len(), r, 0, []),
        Padding(n, c) => [Rect { .x = r.x + n, .y = r.y + n, .w = max_int(r.w - 2 * n, 0), .h = max_int(r.h - 2 * n, 0) }],
        Align(ax, ay, c) => [align_rect(pref_size_in(c, f), r, ax, ay)],
        Scroll(o, c) => [Rect { .x = r.x, .y = r.y - o, .w = r.w, .h = max_int(pref_size_in(c, f).h, r.h) }],
        Rows(o, rh, xs) => all_row_rects(r, o, rh, xs.len(), 0, ListBuf()),
        _ => []
    };
}

/// Each stretching child's share of `free` pixels; none when nothing is free.
Int share(Int free, Int n) { return if (n <= 0 || free <= 0) { 0 } else { free / n }; }

List(Rect) row_rects(List(Widget) xs, Rect r, Int extra, Int i, Int x, List(Rect) acc, Font f) {
    if (i >= xs.len()) { return acc; }
    Int w = pref_size_in(xs[i], f).w + if (stretches_x(xs[i])) { extra } else { 0 };
    return row_rects(xs, r, extra, i + 1, x + w + gap(), acc.concat([Rect { .x = x, .y = r.y, .w = w, .h = r.h }]), f);
}

List(Rect) col_rects(List(Widget) xs, Rect r, Int extra, Int i, Int y, List(Rect) acc, Font f) {
    if (i >= xs.len()) { return acc; }
    Int h = pref_size_in(xs[i], f).h + if (stretches_y(xs[i])) { extra } else { 0 };
    return col_rects(xs, r, extra, i + 1, y + h + gap(), acc.concat([Rect { .x = r.x, .y = y, .w = r.w, .h = h }]), f);
}

List(Rect) same_rects(Int n, Rect r, Int i, List(Rect) acc) {
    return if (i >= n) { acc } else { same_rects(n, r, i + 1, acc.concat([r])) };
}

/// A box of size `s` (at most `r`) placed `ax`/`ay` percent into `r`'s
/// free space.
pub Rect align_rect(Size s, Rect r, Int ax, Int ay) {
    Int w = min_int(s.w, r.w);
    Int h = min_int(s.h, r.h);
    Int px = clamp_int(ax, 0, 100);
    Int py = clamp_int(ay, 0, 100);
    return Rect { .x = r.x + ((r.w - w) * px) / 100, .y = r.y + ((r.h - h) * py) / 100, .w = w, .h = h };
}

/// How many widgets the tree rooted at `w` holds, `w` included. Widgets
/// are numbered in pre-order, so a subtree's numbers are contiguous.
/// Row `i` of a `Rows(offset, row_h, _)` occupying `r`.
pub Rect row_rect(Rect r, Int offset, Int row_h, Int i) {
    return Rect { .x = r.x, .y = r.y - offset + i * max_int(row_h, 1), .w = r.w, .h = max_int(row_h, 1) };
}

/// The rows of a `Rows` in view in `r`: from `first` up to, not including,
/// `last`, never outside 0 to `n`.
pub type RowSpan = { Int first; Int last; };

pub RowSpan rows_in_view(Rect r, Int offset, Int row_h, Int n) {
    Int h = max_int(row_h, 1);
    Int first = clamp_int(offset / h, 0, n);
    Int last = clamp_int((offset + max_int(r.h, 0) + h - 1) / h, first, n);
    return RowSpan { .first = first, .last = last };
}

List(Rect) all_row_rects(Rect r, Int o, Int rh, Int n, Int i, ListBuf(Rect) acc) {
    if (i >= n) { return acc.finish(); }
    return all_row_rects(r, o, rh, n, i + 1, acc.push(row_rect(r, o, rh, i)));
}

pub Int node_count(Widget w) { return 1 + node_count_list(children(w), 0, 0); }

Int node_count_list(List(Widget) xs, Int i, Int acc) {
    return if (i >= xs.len()) { acc } else { node_count_list(xs, i + 1, acc + node_count(xs[i])) };
}

test "a column stacks natural heights and gives the rest to its spacer" {
    Widget w = Column([Text("a"), Spacer, Button("b", Clicked)]);
    List(Rect) rs = child_rects(w, Rect { .x = 0, .y = 0, .w = 100, .h = 100 });
    expect(rs.len()).toEqual(3);
    expect(rs[0].y).toEqual(0);
    expect(rs[0].h).toEqual(24);
    expect(rs[1].y).toEqual(28);
    expect(rs[2].h).toEqual(28);
    expect(rs[2].y + rs[2].h).toEqual(100);
    expect(rs[2].w).toEqual(100);
}

test "a row stretches its inputs" {
    Widget w = Row([Text("ab"), TextInput("", 0, Clicked)]);
    List(Rect) rs = child_rects(w, Rect { .x = 10, .y = 0, .w = 300, .h = 30 });
    expect(rs[0].x).toEqual(10);
    expect(rs[0].w).toEqual(24);
    expect(rs[1].x).toEqual(38);
    expect(rs[1].x + rs[1].w).toEqual(310);
}

test "align, padding and scroll place their child" {
    List(Rect) a = child_rects(Align(50, 100, Text("x")), Rect { .x = 0, .y = 0, .w = 100, .h = 100 });
    expect(a[0].x).toEqual(42);
    expect(a[0].y).toEqual(76);
    List(Rect) p = child_rects(Padding(5, Spacer), Rect { .x = 0, .y = 0, .w = 20, .h = 20 });
    expect(p[0].x).toEqual(5);
    expect(p[0].w).toEqual(10);
    List(Rect) s = child_rects(Scroll(30, Column([Text("a")])), Rect { .x = 0, .y = 0, .w = 50, .h = 10 });
    expect(s[0].y).toEqual(-30);
    expect(s[0].h).toEqual(24);
}

test "a spacer in a row does not make the row tall" {
    expect(stretches_y(Row([Text("a"), Spacer]))).toEqual(false);
    expect(stretches_x(Row([Text("a"), Spacer]))).toEqual(true);
    expect(stretches_x(Column([Text("a"), Spacer]))).toEqual(false);
    expect(stretches_y(Row([Scroll(0, Text("a"))]))).toEqual(true);
}

test "nodes count in pre-order" {
    expect(node_count(Column([Text("a"), Row([Spacer, Spacer])]))).toEqual(5);
    expect(node_count(Text("a"))).toEqual(1);
}
