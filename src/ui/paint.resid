// paint.resid — a widget tree to a display list.
//
// Painting walks the tree in pre-order, asks layout.resid for each child's
// box, and emits draw ops in logical pixels. The library's `UiState` says
// which text input has focus (it gets a highlighted border and a caret)
// and which control is held down.

import "../app.resid";
import "../gfx/color.resid";
import "../gfx/draw.resid";
import "../gfx/font.resid";
import "layout.resid";
import "state.resid";

pub Color ink() { return rgb(20, 20, 20); }
pub Color face() { return rgb(225, 225, 225); }
pub Color face_down() { return rgb(190, 190, 190); }
pub Color edge() { return rgb(150, 150, 150); }
pub Color accent() { return rgb(60, 120, 220); }
pub Color paper() { return rgb(255, 255, 255); }
pub Color selection() { return rgb(180, 205, 245); }

/// What painting a subtree produced, and the number of the next widget.
type Painted = { List(DrawOp) ops; Int next; };

/// The display list for `w` occupying `r`, in the built-in font.
pub List(DrawOp) paint(Widget w, Rect r, UiState ui) { return paint_in(w, r, ui, font_builtin()); }

/// The display list for `w` occupying `r`, with text in font `f`.
pub List(DrawOp) paint_in(Widget w, Rect r, UiState ui, Font f) { return paint_node(w, r, ui, 0, f).ops; }

/// `paint` with no focus and nothing pressed.
pub List(DrawOp) paint_widget(Widget w, Rect r) { return paint(w, r, ui_new()); }

Painted paint_node(Widget w, Rect r, UiState ui, Int id, Font f) {
    Painted rows = match (w) { Rows(o, rh, xs) => paint_rows(o, rh, xs, r, ui, id, f), _ => Painted { .ops = [], .next = -1 } };
    if (rows.next >= 0) { return rows; }
    List(DrawOp) own = paint_self(w, r, ui, id, f);
    List(Widget) kids = children(w);
    if (kids.len() == 0) { return Painted { .ops = own, .next = id + 1 }; }
    Painted inner = paint_kids(kids, child_rects_in(w, r, f), ui, 0, id + 1, [], f);
    List(DrawOp) body = match (w) {
        Scroll(o, c) => [OpClipPush(r)].concat(inner.ops).concat([OpClipPop]),
        _ => inner.ops
    };
    return Painted { .ops = own.concat(body), .next = inner.next };
}

/// A `Rows`: only the rows in view are painted; the others only count
/// towards the numbers of the widgets after them.
Painted paint_rows(Int o, Int rh, List(Widget) xs, Rect r, UiState ui, Int id, Font f) {
    RowSpan v = rows_in_view(r, o, rh, xs.len());
    Int first_id = id + 1 + count_nodes(xs, 0, v.first, 0);
    Painted inner = paint_row_range(xs, r, o, rh, v.first, v.last, ui, first_id, [], f);
    return Painted { .ops = [OpClipPush(r)].concat(inner.ops).concat([OpClipPop]), .next = inner.next + count_nodes(xs, v.last, xs.len(), 0) };
}

Painted paint_row_range(List(Widget) xs, Rect r, Int o, Int rh, Int i, Int end, UiState ui, Int id, List(DrawOp) acc, Font f) {
    if (i >= end) { return Painted { .ops = acc, .next = id }; }
    Painted p = paint_node(xs[i], row_rect(r, o, rh, i), ui, id, f);
    return paint_row_range(xs, r, o, rh, i + 1, end, ui, p.next, acc.concat(p.ops), f);
}

/// The widgets in `xs[i]` to `xs[end - 1]`, nested ones included.
pub Int count_nodes(List(Widget) xs, Int i, Int end, Int acc) {
    if (i >= end) { return acc; }
    return count_nodes(xs, i + 1, end, acc + node_count(xs[i]));
}

Painted paint_kids(List(Widget) xs, List(Rect) rs, UiState ui, Int i, Int id, List(DrawOp) acc, Font f) {
    if (i >= xs.len() || i >= rs.len()) { return Painted { .ops = acc, .next = id }; }
    Painted p = paint_node(xs[i], rs[i], ui, id, f);
    return paint_kids(xs, rs, ui, i + 1, p.next, acc.concat(p.ops), f);
}

/// Text centred vertically in `r`, `dx` pixels in from its left edge.
DrawOp label(Rect r, Int dx, Str s, Color c, Font f) { return OpText(r.x + dx, r.y + (r.h - text_height_in(f)) / 2, s, c); }

/// A one-pixel frame of colour `e` around a fill of colour `f`.
List(DrawOp) framed(Rect r, Color e, Color f) {
    return [OpFill(r, e), OpFill(Rect { .x = r.x + 1, .y = r.y + 1, .w = r.w - 2, .h = r.h - 2 }, f)];
}

List(DrawOp) paint_self(Widget w, Rect r, UiState ui, Int id, Font f) {
    return match (w) {
        Text(s) => [label(r, 4, s, ink(), f)],
        Button(s, m) => framed(r, edge(), if (ui.pressed == id) { face_down() } else { face() }).concat([label(r, (r.w - text_width_in(f, s)) / 2, s, ink(), f)]),
        Checkbox(s, on, m) => paint_check(r, s, on, ui.pressed == id, f),
        TextInput(s, caret, m) => paint_input(r, s, caret, ui.focus == id, ui.caret_on, if (ui.focus == id) { ui.anchor } else { -1 }, f),
        Slider(v, m) => paint_slider(r, v),
        Bitmap(bw, bh, px) => [OpImage(r.x, r.y, bw, bh, px)],
        _ => []
    };
}

List(DrawOp) paint_check(Rect r, Str s, Bool on, Bool down, Font f) {
    Rect b = Rect { .x = r.x + 4, .y = r.y + (r.h - 16) / 2, .w = 16, .h = 16 };
    List(DrawOp) box = framed(b, if (down) { accent() } else { edge() }, paper());
    List(DrawOp) mark = if (on) { [OpFill(Rect { .x = b.x + 4, .y = b.y + 4, .w = 8, .h = 8 }, accent())] } else { [] };
    return box.concat(mark).concat([label(r, 26, s, ink(), f)]);
}

/// How far an input's text is shifted left so the caret, `caret_x`
/// pixels into the text, stays inside a box `inner_w` pixels wide.
pub Int input_scroll(Int caret_x, Int inner_w) { Int room = max_int(inner_w - 8, 0); return if (caret_x > room) { caret_x - room } else { 0 }; }

/// The caret's offset into the text of an input, in logical pixels.
pub Int caret_offset(Str s, Int caret, Font f) { return text_width_in(f, str_slice(s, 0, clamp_int(caret, 0, str_len(s)))); }

List(DrawOp) paint_input(Rect r, Str s, Int caret0, Bool focused, Bool caret_on, Int anchor, Font f) {
    Rect inner = Rect { .x = r.x + 1, .y = r.y + 1, .w = r.w - 2, .h = r.h - 2 };
    Int cx = caret_offset(s, caret0, f);
    Int tx = inner.x + 4 - input_scroll(cx, inner.w);
    Int th = text_height_in(f);
    Int ty = r.y + (r.h - th) / 2;
    List(DrawOp) caret_op = if (focused && caret_on) { [OpFill(Rect { .x = tx + cx, .y = ty, .w = 1, .h = th }, ink())] } else { [] };
    // The selection, from the anchor to the caret, is shaded under the text.
    Int ax = if (anchor >= 0) { caret_offset(s, anchor, f) } else { cx };
    List(DrawOp) sel_op = if (ax != cx) { [OpFill(Rect { .x = tx + min_int(ax, cx), .y = ty, .w = max_int(ax, cx) - min_int(ax, cx), .h = th }, selection())] } else { [] };
    return framed(r, if (focused) { accent() } else { edge() }, paper())
        .concat([OpClipPush(inner)]).concat(sel_op).concat([OpText(tx, ty, s, ink())])
        .concat(caret_op)
        .concat([OpClipPop]);
}

/// The slider value (0 to 100) a pointer at `x` selects in `r`.
pub Int slider_value_at(Rect r, Int x) {
    Int track = r.w - 12;
    if (track <= 0) { return 0; }
    return clamp_int(((x - r.x - 6) * 100) / track, 0, 100);
}

List(DrawOp) paint_slider(Rect r, Int v0) {
    Int v = clamp_int(v0, 0, 100);
    Int track = max_int(r.w - 12, 0);
    Int cy = r.y + r.h / 2;
    Int kx = r.x + (track * v) / 100;
    return [
        OpFill(Rect { .x = r.x + 6, .y = cy - 2, .w = track, .h = 4 }, edge()),
        OpFill(Rect { .x = r.x + 6, .y = cy - 2, .w = (track * v) / 100, .h = 4 }, accent())
    ].concat(framed(Rect { .x = kx, .y = cy - 8, .w = 12, .h = 16 }, edge(), face()));
}

test "a button paints a frame and a centred label" {
    List(DrawOp) ops = paint_widget(Button("ok", Clicked), Rect { .x = 0, .y = 0, .w = 40, .h = 28 });
    expect(ops.len()).toEqual(3);
    expect(draw_op_eq(ops[2], OpText(12, 6, "ok", ink()))).toEqual(true);
}

test "a pressed button and a focused input look different" {
    Rect r = Rect { .x = 0, .y = 0, .w = 40, .h = 28 };
    List(DrawOp) up = paint(Button("ok", Clicked), r, ui_new());
    List(DrawOp) down = paint(Button("ok", Clicked), r, ui_with_pressed(ui_new(), 0));
    expect(draw_op_eq(up[1], down[1])).toEqual(false);
    List(DrawOp) blurred = paint(TextInput("hi", 2, Clicked), r, ui_new());
    List(DrawOp) focused = paint(TextInput("hi", 2, Clicked), r, ui_with_focus(ui_new(), 0));
    expect(focused.len()).toEqual(blurred.len() + 1);
}

test "children get their layout boxes and scroll clips" {
    List(DrawOp) ops = paint_widget(Column([Text("a"), Text("b")]), Rect { .x = 0, .y = 0, .w = 50, .h = 60 });
    expect(ops.len()).toEqual(2);
    expect(draw_op_eq(ops[1], OpText(4, 32, "b", ink()))).toEqual(true);
    List(DrawOp) sc = paint_widget(Scroll(4, Text("a")), Rect { .x = 0, .y = 0, .w = 50, .h = 10 });
    expect(sc.len()).toEqual(3);
    expect(draw_op_eq(sc[0], OpClipPush(Rect { .x = 0, .y = 0, .w = 50, .h = 10 }))).toEqual(true);
}

test "the slider maps pointer to value" {
    Rect r = Rect { .x = 0, .y = 0, .w = 112, .h = 24 };
    expect(slider_value_at(r, 0)).toEqual(0);
    expect(slider_value_at(r, 56)).toEqual(50);
    expect(slider_value_at(r, 500)).toEqual(100);
}

test "a long list paints only the rows in view" {
    List(Widget) many = rows_of(0, 10000, ListBuf());
    Rect r = Rect { .x = 0, .y = 0, .w = 100, .h = 50 };
    List(DrawOp) ops = paint_widget(Rows(240, 24, many), r);
    // rows 10, 11 and 12 overlap a 50-pixel box from 240 down; one text op
    // each, inside the clip
    expect(ops.len()).toEqual(5);
    expect(draw_op_eq(ops[1], OpText(4, 4, "row 10", ink()))).toEqual(true);
    expect(node_count(Rows(0, 24, many))).toEqual(10001);
}

List(Widget) rows_of(Int i, Int n, ListBuf(Widget) b) {
    if (i >= n) { return b.finish(); }
    return rows_of(i + 1, n, b.push(Text(f"row {i}")));
}

test "a selection is shaded under the text" {
    Rect r = Rect { .x = 0, .y = 0, .w = 100, .h = 28 };
    UiState u = ui_with_anchor(ui_with_focus(ui_new(), 0), 1);
    List(DrawOp) ops = paint(TextInput("abcd", 3, Clicked), r, u);
    // frame, fill, clip, selection, text, caret, pop
    expect(ops.len()).toEqual(7);
    expect(draw_op_eq(ops[3], OpFill(Rect { .x = 5 + 8, .y = 6, .w = 16, .h = 16 }, selection()))).toEqual(true);
}
