// semantics.resid — what each widget *means*, for screen readers, tests
// and the inspector.
//
// `paint` turns a widget tree into what it looks like; `semantics` turns
// the same tree into what it is: a flat list of nodes, each with a role,
// a label, a value, a state and the actions it accepts, in reading order.
// It is pure and is a value, so like the display list it can be diffed:
// only the nodes that changed travel to the platform (`sem_diff`).
//
// Node ids are the widget numbers `input.resid` and `UiState` already use
// (pre-order), so an action a screen reader takes on node 7 is an action on
// widget 7. Layout-only widgets (Row, Column, Stack, Padding, Align,
// Spacer) have no node; their children hang off the nearest ancestor that
// has one. A `Rows` list carries only the rows in view, as it paints only
// those. A widget scrolled out of its `Scroll`, or laid out outside the
// window, is a node flagged `sem_offscreen`, as GTK and Qt export
// scrolled-out children: a reader can read it and ask to scroll to it
// (`act_scroll`), but not act on it until it is shown.

import "../app.resid";
import "../gfx/color.resid";
import "../gfx/font.resid";
import "layout.resid";
import "state.resid";

/// One node. `parent` is -1 for a node at the top. `bounds` are logical
/// pixels. `flags` holds `sem_*` bits, `actions` holds `act_*` bits.
pub type SemNode = { Int id; Int parent; Int role; Int flags; Rect bounds; Int actions; Str label; Str value; };

pub Int role_text() { return 1; }
pub Int role_button() { return 2; }
pub Int role_checkbox() { return 3; }
pub Int role_textbox() { return 4; }
pub Int role_slider() { return 5; }
pub Int role_image() { return 6; }
pub Int role_scroll() { return 7; }
pub Int role_list() { return 8; }

pub Int sem_checked() { return 1; }
pub Int sem_focused() { return 2; }
pub Int sem_editable() { return 4; }
pub Int sem_disabled() { return 8; }
/// Scrolled out of view or laid out outside the window: in the tree, not
/// on screen (AT-SPI: not SHOWING).
pub Int sem_offscreen() { return 16; }

pub Int act_activate() { return 1; }
pub Int act_focus() { return 2; }
pub Int act_set_value() { return 4; }
/// On a scroll area or list: it scrolls. As an `Assist` on any node:
/// scroll its `Scroll` so that it shows (a `ScrollTo` event). An off-screen
/// node inside a `Scroll` offers this action and no other.
pub Int act_scroll() { return 8; }

/// The semantics of `w` laid out in `r`, in the built-in font.
pub List(SemNode) semantics(Widget w, Rect r, UiState ui) { return semantics_in(w, r, ui, font_builtin()); }

/// `semantics` with text in font `f`. A widget under a later layer of a
/// `Stack` that would take a click at its centre is left out, and so are
/// the rows of a `Rows` out of view (they are not laid out). A widget
/// scrolled out of its `Scroll` or laid out outside `r` is a node flagged
/// `sem_offscreen`, whose only action is `act_scroll` (inside a `Scroll`)
/// or none: a screen reader can read it and scroll to it, but acts only
/// on what the pointer could reach (`assist` in input.resid checks the
/// same).
pub List(SemNode) semantics_in(Widget w, Rect r, UiState ui, Font f) {
    return sem_node(ListBuf(), w, r, ui, f, 0, -1, r, [], false).finish();
}

/// A later layer of a `Stack`: what is drawn over the earlier ones.
type Layer = { Widget w; Rect r; };

/// Whether a widget takes the pointer (`interactive` in input.resid).
Bool takes_input(Widget w) {
    Int role = role_of(w);
    return role == role_button() || role == role_checkbox() || role == role_textbox() || role == role_slider();
}

/// Whether a click at (`x`, `y`) would land on something in `w` laid out
/// in `r`.
Bool hit_any(Widget w, Rect r, Int x, Int y, Font f) {
    if (!rect_contains(r, x, y)) { return false; }
    if (takes_input(w)) { return true; }
    return hit_any_kids(children(w), child_rects_in(w, r, f), x, y, 0, f);
}

Bool hit_any_kids(List(Widget) xs, List(Rect) rs, Int x, Int y, Int i, Font f) {
    if (i >= xs.len() || i >= rs.len()) { return false; }
    return hit_any(xs[i], rs[i], x, y, f) || hit_any_kids(xs, rs, x, y, i + 1, f);
}

/// Whether the centre of `v` is under a layer that takes clicks.
Bool covered(List(Layer) over, Rect v, Font f, Int i) {
    if (i >= over.len()) { return false; }
    return hit_any(over[i].w, over[i].r, v.x + v.w / 2, v.y + v.h / 2, f) || covered(over, v, f, i + 1);
}

/// The role of a widget, or 0 for one with no node of its own.
pub Int role_of(Widget w) {
    return match (w) {
        Text(s) => role_text(),
        Button(s, m) => role_button(),
        Checkbox(s, c, m) => role_checkbox(),
        TextInput(s, k, m) => role_textbox(),
        Slider(v, m) => role_slider(),
        Bitmap(bw, bh, px) => role_image(),
        Scroll(o, c) => role_scroll(),
        Rows(o, rh, xs) => role_list(),
        _ => 0
    };
}

SemNode node_of(Widget w, Rect r, UiState ui, Int id, Int parent) {
    Int focused = if (ui.focus == id) { sem_focused() } else { 0 };
    return match (w) {
        Text(s) => mk(id, parent, role_text(), 0, r, 0, s, ""),
        Button(s, m) => mk(id, parent, role_button(), 0, r, act_activate(), s, ""),
        Checkbox(s, c, m) => mk(id, parent, role_checkbox(), if (c) { sem_checked() } else { 0 }, r, act_activate(), s, ""),
        TextInput(s, k, m) => mk(id, parent, role_textbox(), sem_editable() | focused, r, act_focus() | act_set_value(), "", s),
        Slider(v, m) => mk(id, parent, role_slider(), 0, r, act_set_value(), "", f"{v}"),
        Bitmap(bw, bh, px) => mk(id, parent, role_image(), 0, r, 0, "", ""),
        Scroll(o, c) => mk(id, parent, role_scroll(), 0, r, act_scroll(), "", f"{o}"),
        Rows(o, rh, xs) => mk(id, parent, role_list(), 0, r, act_scroll(), "", f"{xs.len()}"),
        _ => mk(id, parent, 0, 0, r, 0, "", "")
    };
}

SemNode mk(Int id, Int parent, Int role, Int flags, Rect r, Int actions, Str label, Str value) {
    return SemNode { .id = id, .parent = parent, .role = role, .flags = flags, .bounds = r, .actions = actions, .label = label, .value = value };
}

/// `w`'s nodes, unless a layer in `over` covers it: flagged off screen
/// when no part of `r` lies inside `clip`. Its children's either way (a
/// child can lie outside its parent), hanging from the nearest node.
/// `scrolled` says a `Scroll` encloses `w`, which could bring it into view.
ListBuf(SemNode) sem_node(ListBuf(SemNode) acc, Widget w, Rect r, UiState ui, Font f, Int id, Int parent, Rect clip, List(Layer) over, Bool scrolled) {
    Rect v = rect_intersect(r, clip);
    Bool shown = !rect_is_empty(v);
    Bool own = role_of(w) != 0 && !covered(over, if (shown) { v } else { r }, f, 0);
    ListBuf(SemNode) here = if (own) { acc.push(if (shown) { node_of(w, r, ui, id, parent) } else { offscreen(node_of(w, r, ui, id, parent), scrolled) }) } else { acc };
    Int up = if (own) { id } else { parent };
    return match (w) {
        Rows(o, rh, xs) => sem_rows(here, xs, r, o, rh, ui, f, rows_in_view(r, o, rh, xs.len()), 0, id + 1, up, v, over, scrolled),
        Scroll(o, c) => sem_kids(here, children(w), child_rects_in(w, r, f), ui, f, 0, id + 1, up, v, over, false, true),
        Stack(xs) => sem_kids(here, xs, child_rects_in(w, r, f), ui, f, 0, id + 1, up, clip, over, true, scrolled),
        _ => sem_kids(here, children(w), child_rects_in(w, r, f), ui, f, 0, id + 1, up, clip, over, false, scrolled)
    };
}

/// Node `n` off screen: flagged so, and its only action scrolling to it,
/// when a `Scroll` could.
SemNode offscreen(SemNode n, Bool scrolled) {
    return SemNode { .id = n.id, .parent = n.parent, .role = n.role, .flags = n.flags | sem_offscreen(), .bounds = n.bounds,
                     .actions = if (scrolled) { act_scroll() } else { 0 }, .label = n.label, .value = n.value };
}

/// The children; in a `Stack` (`layered`) each under the ones after it.
ListBuf(SemNode) sem_kids(ListBuf(SemNode) acc, List(Widget) xs, List(Rect) rs, UiState ui, Font f, Int i, Int id, Int parent, Rect clip, List(Layer) over, Bool layered, Bool scrolled) {
    if (i >= xs.len() || i >= rs.len()) { return acc; }
    List(Layer) above = if (layered) { over.concat(layers(xs, rs, i + 1, ListBuf())) } else { over };
    return sem_kids(sem_node(acc, xs[i], rs[i], ui, f, id, parent, clip, above, scrolled), xs, rs, ui, f, i + 1, id + node_count(xs[i]), parent, clip, over, layered, scrolled);
}

List(Layer) layers(List(Widget) xs, List(Rect) rs, Int i, ListBuf(Layer) acc) {
    if (i >= xs.len() || i >= rs.len()) { return acc.finish(); }
    return layers(xs, rs, i + 1, acc.push(Layer { .w = xs[i], .r = rs[i] }));
}

ListBuf(SemNode) sem_rows(ListBuf(SemNode) acc, List(Widget) xs, Rect r, Int o, Int rh, UiState ui, Font f, RowSpan span, Int i, Int id, Int parent, Rect clip, List(Layer) over, Bool scrolled) {
    if (i >= xs.len() || i >= span.last) { return acc; }
    ListBuf(SemNode) next = if (i >= span.first) { sem_node(acc, xs[i], row_rect(r, o, rh, i), ui, f, id, parent, clip, over, scrolled) } else { acc };
    return sem_rows(next, xs, r, o, rh, ui, f, span, i + 1, id + node_count(xs[i]), parent, clip, over, scrolled);
}

/// Whether two nodes say the same thing.
pub Bool sem_eq(SemNode a, SemNode b) {
    return a.id == b.id && a.parent == b.parent && a.role == b.role && a.flags == b.flags && a.actions == b.actions
        && a.bounds.x == b.bounds.x && a.bounds.y == b.bounds.y && a.bounds.w == b.bounds.w && a.bounds.h == b.bounds.h
        && a.label == b.label && a.value == b.value;
}

/// What changed between two semantics lists: nodes that are new or
/// different, and the ids of nodes that are gone. Both lists are in
/// increasing id order, as `semantics` makes them.
pub type SemDiff = { List(SemNode) put; List(Int) removed; };

pub SemDiff sem_diff(List(SemNode) old, List(SemNode) now) { return diff_at(old, now, 0, 0, ListBuf(), ListBuf()); }

SemDiff diff_at(List(SemNode) a, List(SemNode) b, Int i, Int j, ListBuf(SemNode) put, ListBuf(Int) gone) {
    if (i >= a.len() && j >= b.len()) { return SemDiff { .put = put.finish(), .removed = gone.finish() }; }
    if (i >= a.len()) { return diff_at(a, b, i, j + 1, put.push(b[j]), gone); }
    if (j >= b.len()) { return diff_at(a, b, i + 1, j, put, gone.push(a[i].id)); }
    if (a[i].id < b[j].id) { return diff_at(a, b, i + 1, j, put, gone.push(a[i].id)); }
    if (a[i].id > b[j].id) { return diff_at(a, b, i, j + 1, put.push(b[j]), gone); }
    return diff_at(a, b, i + 1, j + 1, if (sem_eq(a[i], b[j])) { put } else { put.push(b[j]) }, gone);
}

/// The text a screen reader would speak for the whole list, one node per
/// line: role, label, value, state. For tests and the inspector.
pub Str sem_speech(List(SemNode) ns) { return speech_at(ns, 0, StrBuf()); }

Str speech_at(List(SemNode) ns, Int i, StrBuf b) {
    if (i >= ns.len()) { return b.finish(); }
    SemNode n = ns[i];
    List(Str) names = ["group", "text", "button", "checkbox", "text field", "slider", "image", "scroll area", "list"];
    Str role = if (n.role >= 0 && n.role < names.len()) { names[n.role] } else { "group" };
    Str checked = if (n.role == role_checkbox()) { if ((n.flags & sem_checked()) != 0) { ", checked" } else { ", not checked" } } else { "" };
    Str focused = if ((n.flags & sem_focused()) != 0) { ", focused" } else { "" };
    Str off = if ((n.flags & sem_offscreen()) != 0) { ", off screen" } else { "" };
    Str label = if (str_len(n.label) > 0) { f" \"{n.label}\"" } else { "" };
    Str value = if (str_len(n.value) > 0) { f" = {n.value}" } else { "" };
    return speech_at(ns, i + 1, b.push(f"{role}{label}{value}{checked}{focused}{off}\n"));
}

// ─── Tests ─────────────────────────────────────────────────────────

Widget form() {
    return Column([
        Text("Tasks"),
        Row([TextInput("milk", 4, Custom(1)), Button("Add", Clicked)]),
        Padding(4, Checkbox("Done", true, Toggled)),
        Slider(40, Custom(2))
    ]);
}

test "every meaningful widget is a node; layout-only ones are not" {
    List(SemNode) ns = semantics(form(), Rect { .x = 0, .y = 0, .w = 300, .h = 200 }, ui_new());
    expect(ns.len()).toEqual(5);
    expect(sem_speech(ns)).toEqual("text \"Tasks\"\ntext field = milk\nbutton \"Add\"\ncheckbox \"Done\", checked\nslider = 40\n");
}

test "ids are the widget numbers input uses, and parents skip layout" {
    List(SemNode) ns = semantics(form(), Rect { .x = 0, .y = 0, .w = 300, .h = 200 }, ui_with_focus(ui_new(), 3));
    // Column 0, Text 1, Row 2, TextInput 3, Button 4, Padding 5, Checkbox 6, Slider 7
    expect(ns[1].id).toEqual(3);
    expect(ns[1].parent).toEqual(-1);
    expect((ns[1].flags & sem_focused()) != 0).toEqual(true);
    expect(ns[3].id).toEqual(6);
    expect(ns[4].id).toEqual(7);
}

test "a list carries only the rows in view, under the list node" {
    List(Widget) rows = [Text("a"), Text("b"), Text("c"), Text("d"), Text("e")];
    List(SemNode) ns = semantics(Rows(24, 24, rows), Rect { .x = 0, .y = 0, .w = 100, .h = 48 }, ui_new());
    expect(ns[0].role).toEqual(role_list());
    expect(ns[0].value).toEqual("5");
    expect(ns.len()).toEqual(3);
    expect(ns[1].label).toEqual("b");
    expect(ns[1].parent).toEqual(0);
    expect(ns[1].id).toEqual(2);
}

test "a diff carries what changed and what went away" {
    Rect r = Rect { .x = 0, .y = 0, .w = 300, .h = 200 };
    List(SemNode) a = semantics(form(), r, ui_new());
    List(SemNode) b = semantics(Column([Text("Tasks"), Row([TextInput("milk", 4, Custom(1)), Button("Add", Clicked)]), Padding(4, Checkbox("Done", false, Toggled))]), r, ui_new());
    SemDiff d = sem_diff(a, b);
    expect(d.removed.len()).toEqual(1);
    expect(d.removed[0]).toEqual(7);
    expect(d.put.len()).toEqual(1);
    expect(d.put[0].id).toEqual(6);
    expect(sem_diff(a, a).put.len()).toEqual(0);
}

test "a node scrolled out of view is read as off screen; one under a layer that takes clicks is not read" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // a button scrolled 500 pixels above a view 100 tall
    Widget scrolled = Scroll(500, Column([Button("gone", Custom(1)), Text("x")]));
    Str said = sem_speech(semantics(scrolled, r, ui_new()));
    expect(said).toEqual("scroll area = 500\nbutton \"gone\", off screen\ntext \"x\", off screen\n");
    // a button drawn over another in a Stack: only the top one is there
    Str stack = sem_speech(semantics(Stack([Button("del", Custom(1)), Button("cover", Custom(2))]), r, ui_new()));
    expect(stack).toEqual("button \"cover\"\n");
    // a layer that takes no clicks hides nothing
    Str text = sem_speech(semantics(Stack([Button("under", Custom(1)), Text("over")]), r, ui_new()));
    expect(text).toEqual("button \"under\"\ntext \"over\"\n");
}

test "off-screen nodes are flagged, offer only scrolling, and visible ones are not flagged (R3-3)" {
    Rect r = Rect { .x = 0, .y = 0, .w = 200, .h = 100 };
    // Scroll 0, Column 1, Button "top" 2, Spacer 3, Button "far" 4: "far"
    // lies 400 pixels down a view 100 tall
    Widget w = Scroll(0, Column([Button("top", Custom(1)), Padding(200, Spacer), Button("far", Custom(2))]));
    List(SemNode) ns = semantics(w, r, ui_new());
    SemNode top = ns[1];
    SemNode far = ns[2];
    expect(top.label).toEqual("top");
    expect(top.flags & sem_offscreen()).toEqual(0);
    expect(top.actions).toEqual(act_activate());
    expect(far.label).toEqual("far");
    expect(far.id).toEqual(5);
    expect(far.parent).toEqual(0);
    expect((far.flags & sem_offscreen()) != 0).toEqual(true);
    expect(far.actions).toEqual(act_scroll());
    // laid out past the window with no Scroll to bring it in: no actions
    List(SemNode) low = semantics(Column([Padding(200, Spacer), Button("below", Custom(3))]), r, ui_new());
    expect(low.len()).toEqual(1);
    expect((low[0].flags & sem_offscreen()) != 0).toEqual(true);
    expect(low[0].actions).toEqual(0);
}
