// state.resid — what the library remembers between frames about the
// widgets themselves, as opposed to the program's model.
//
// Widgets are numbered in pre-order (`node_count` in layout.resid); the
// numbers name the focused text input and the widget a pointer button went
// down on. The caret's blink phase lives here too, and so do the selection
// anchor and the Shift and Ctrl keys held: the program owns the text and
// the caret (`TextInput(text, caret, m)`), the library owns the rest of
// editing.

import "../app.resid";
import "../gfx/color.resid";

/// The library's own widget state.
pub type UiState = {
    Int focus;      // the focused TextInput's number, or -1
    Msg fmsg;       // that input's message: keys go to it only if the
                    // input numbered `focus` still has it (input.resid's
                    // ui_refocus follows it when the view renumbers)
    Bool fecho;     // that message was Changed(the input's own text) when
                    // focused: it echoes the text, which typing changes,
                    // so its payload is not compared, only that it still
                    // echoes; any other message is compared whole
    Int pressed;    // the widget the primary button went down on, or -1
    Msg pmsg;       // that widget's message: a release raises it only if
                    // the widget there still has it (the view may change
                    // between press and release, and numbers with it)
    Str plabel;     // and its label and box, for messages that are not
    Rect prect;     // unique (index-keyed rows renumber under a press)
    Int pprint;     // a fingerprint of the widgets numbered up to it: a
                    // row removed above it renumbers rows whose message,
                    // label and box can all repeat (input.resid's
                    // press_print)
    Bool caret_on;  // the caret's blink phase
    Int anchor;     // where the focused input's selection starts, or -1;
                    // it runs from here to the caret
    Bool shift;     // a Shift key is held
    Bool ctrl;      // a Ctrl key is held
};

/// Nothing focused, nothing pressed, caret visible.
pub UiState ui_new() {
    return UiState { .focus = -1, .fmsg = Clicked, .fecho = false, .pressed = -1, .pmsg = Clicked, .plabel = "", .prect = rect_none(), .pprint = 0,
                     .caret_on = true, .anchor = -1, .shift = false, .ctrl = false };
}

/// A new focus drops the selection; the focused input's message is kept.
pub UiState ui_with_focus(UiState u, Int f) { return ui_with_focus_on(u, f, u.fmsg); }
/// Focus on input `f`, whose message is `m`.
pub UiState ui_with_focus_on(UiState u, Int f, Msg m) { return ui_with_focus_msg(u, f, m, false); }
/// Focus on input `f`, whose message is `m`; `echo` when `m` is
/// `Changed` of the input's own text.
pub UiState ui_with_focus_msg(UiState u, Int f, Msg m, Bool echo) {
    return UiState { .focus = f, .fmsg = m, .fecho = echo, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .caret_on = true,
                     .anchor = if (f == u.focus) { u.anchor } else { -1 }, .shift = u.shift, .ctrl = u.ctrl };
}
/// The focused input renumbered to `f` (the view moved it): the same
/// input, so the selection and caret phase stay.
pub UiState ui_with_focus_moved(UiState u, Int f) {
    return UiState { .focus = f, .fmsg = u.fmsg, .fecho = u.fecho, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .caret_on = u.caret_on,
                     .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl };
}
pub UiState ui_with_pressed(UiState u, Int p) { return ui_with_press(u, p, u.pmsg, u.plabel, u.prect, u.pprint); }
/// Widget `p`, whose message is `m`, label `l` and box `r`, pressed, the
/// widgets up to it fingerprinted `fp`.
pub UiState ui_with_press(UiState u, Int p, Msg m, Str l, Rect r, Int fp) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .pressed = p, .pmsg = m, .plabel = l, .prect = r, .pprint = fp, .caret_on = u.caret_on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl };
}
pub UiState ui_with_caret(UiState u, Bool on) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .caret_on = on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl };
}
pub UiState ui_with_anchor(UiState u, Int a) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .caret_on = u.caret_on, .anchor = a, .shift = u.shift, .ctrl = u.ctrl };
}
pub UiState ui_with_mods(UiState u, Bool shift, Bool ctrl) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .caret_on = u.caret_on, .anchor = u.anchor, .shift = shift, .ctrl = ctrl };
}

test "state updates one field at a time" {
    UiState u = ui_with_pressed(ui_with_focus(ui_new(), 3), 5);
    expect(u.focus).toEqual(3);
    expect(u.pressed).toEqual(5);
    expect(ui_with_caret(u, false).caret_on).toEqual(false);
    UiState s = ui_with_anchor(u, 2);
    expect(ui_with_focus(s, 3).anchor).toEqual(2);
    expect(ui_with_focus(s, 4).anchor).toEqual(-1);
}
