// state.resid — what the library remembers between frames about the
// widgets themselves, as opposed to the program's model.
//
// Widgets are numbered in pre-order (`node_count` in layout.resid); the
// numbers name the focused text input and the widget a pointer button went
// down on. The caret's blink phase lives here too, and so do the selection
// anchor and the Shift and Ctrl keys held: the program owns the text and
// the caret (`TextInput(text, caret, m)`), the library owns the rest of
// editing.

import "../app.resid";
import "../gfx/color.resid";

/// The library's own widget state.
pub type UiState = {
    Int focus;      // the focused TextInput's number, or -1
    Msg fmsg;       // that input's message: keys go to it only if the
                    // input numbered `focus` still has it (input.resid's
                    // ui_refocus follows it when the view renumbers)
    Bool fecho;     // that message was Changed(the input's own text) when
                    // focused: it echoes the text, which typing changes,
                    // so its payload is not compared, only that it still
                    // echoes; any other message is compared whole
    Bool fpw;       // that input is a PasswordInput: keys follow it only
                    // to a PasswordInput, and a TextInput's only to a
                    // TextInput (R5-1)
    Int ford;       // its place among the inputs that match it (same kind,
                    // and message as above), counted in pre-order: when
                    // the view renumbers, focus follows the input at the
                    // same place (R5-5)
    Int fcount;     // how many inputs matched it then: when more than one
                    // matches, focus follows its place only while their
                    // number is unchanged (R6-5)
    Int pressed;    // the widget the primary button went down on, or -1
    Msg pmsg;       // that widget's message: a release raises it only if
                    // the widget there still has it (the view may change
                    // between press and release, and numbers with it)
    Str plabel;     // and its label and box, for messages that are not
    Rect prect;     // unique (index-keyed rows renumber under a press)
    Int pprint;     // a fingerprint of the widgets numbered up to it: a
                    // row removed above it renumbers rows whose message,
                    // label and box can all repeat (input.resid's
                    // shape_print)
    Int pctx;       // the text around it then (context_print, which for a
                    // slider or input leaves out the value echoed after
                    // it): a release and a drag must find it unchanged
                    // (R7-1, L8-3)
    Bool caret_on;  // the caret's blink phase
    Int anchor;     // where the focused input's selection starts, or -1;
                    // it runs from here to the caret
    Bool shift;     // a Shift key is held
    Bool ctrl;      // a Ctrl key is held
    List(Int) pwkeys; // keys that went down while a PasswordInput had
                    // focus and have not come up: their release is
                    // withheld wherever focus is then (R5-6); at most 16;
                    // forgotten when the window loses focus (R6-6)
    List(Int) mods; // modifiers the program was told went down and has
                    // not been told came up (L8-2)
};

/// Nothing focused, nothing pressed, caret visible.
pub UiState ui_new() {
    return UiState { .focus = -1, .fmsg = Clicked, .fecho = false, .fpw = false, .ford = 0, .fcount = 1, .pressed = -1, .pmsg = Clicked, .plabel = "", .prect = rect_none(), .pprint = 0, .pctx = 0,
                     .caret_on = true, .anchor = -1, .shift = false, .ctrl = false, .pwkeys = [], .mods = [] };
}

/// A new focus drops the selection; the focused input's message is kept.
pub UiState ui_with_focus(UiState u, Int f) { return ui_with_focus_on(u, f, u.fmsg); }
/// Focus on input `f`, whose message is `m`.
pub UiState ui_with_focus_on(UiState u, Int f, Msg m) { return ui_with_focus_msg(u, f, m, false); }
/// Focus on input `f`, whose message is `m`; `echo` when `m` is
/// `Changed` of the input's own text.
pub UiState ui_with_focus_msg(UiState u, Int f, Msg m, Bool echo) { return ui_with_focus_input(u, f, m, echo, false, 0, 1); }
/// Focus on input `f`, whose message is `m` (`echo` as above), a
/// `PasswordInput` when `pw`, at place `ord` among the `count` inputs
/// that match it.
pub UiState ui_with_focus_input(UiState u, Int f, Msg m, Bool echo, Bool pw, Int ord, Int count) {
    return UiState { .focus = f, .fmsg = m, .fecho = echo, .fpw = pw, .ford = ord, .fcount = count, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = true,
                     .anchor = if (f == u.focus) { u.anchor } else { -1 }, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
/// The focused input renumbered to `f` (the view moved it), with `count`
/// inputs like it now: the same input, so the selection and caret phase
/// stay.
pub UiState ui_with_focus_moved(UiState u, Int f, Int count) {
    return UiState { .focus = f, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = count, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = u.caret_on,
                     .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
pub UiState ui_with_pressed(UiState u, Int p) { return ui_with_press(u, p, u.pmsg, u.plabel, u.prect, u.pprint, u.pctx); }
/// Widget `p`, whose message is `m`, label `l` and box `r`, pressed, the
/// widgets up to it fingerprinted `fp`, the text around it `ctx`.
pub UiState ui_with_press(UiState u, Int p, Msg m, Str l, Rect r, Int fp, Int ctx) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = p, .pmsg = m, .plabel = l, .prect = r, .pprint = fp, .pctx = ctx, .caret_on = u.caret_on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
pub UiState ui_with_caret(UiState u, Bool on) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
pub UiState ui_with_anchor(UiState u, Int a) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = u.caret_on, .anchor = a, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
pub UiState ui_with_mods(UiState u, Bool shift, Bool ctrl) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = u.caret_on, .anchor = u.anchor, .shift = shift, .ctrl = ctrl, .pwkeys = u.pwkeys, .mods = u.mods };
}
/// `u` with the held password keys `ks` and the modifiers down `ms`.
pub UiState ui_with_keys(UiState u, List(Int) ks, List(Int) ms) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = u.caret_on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = ks, .mods = ms };
}

/// `u` with the held password keys `ks`.
pub UiState ui_with_pwkeys(UiState u, List(Int) ks) {
    return UiState { .focus = u.focus, .fmsg = u.fmsg, .fecho = u.fecho, .fpw = u.fpw, .ford = u.ford, .fcount = u.fcount, .pressed = u.pressed, .pmsg = u.pmsg, .plabel = u.plabel, .prect = u.prect, .pprint = u.pprint, .pctx = u.pctx, .caret_on = u.caret_on, .anchor = u.anchor, .shift = u.shift, .ctrl = u.ctrl, .pwkeys = ks, .mods = u.mods };
}

test "state updates one field at a time" {
    UiState u = ui_with_pressed(ui_with_focus(ui_new(), 3), 5);
    expect(u.focus).toEqual(3);
    expect(u.pressed).toEqual(5);
    expect(ui_with_caret(u, false).caret_on).toEqual(false);
    UiState s = ui_with_anchor(u, 2);
    expect(ui_with_focus(s, 3).anchor).toEqual(2);
    expect(ui_with_focus(s, 4).anchor).toEqual(-1);
}
