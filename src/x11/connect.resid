// connect.resid — opening the connection and talking to the server in
// round trips.
//
// This is the first thing that touches the outside world, so it is the
// first thing that needs the `display` capability (PLAN-gui.md §3.1). The
// handshake is fixed: send the setup request, read the reply whole (its
// own length field says how long it is) and parse it. After that, a round
// trip sends one request and reads until its reply or error arrives;
// events that come first are dropped, which only happens before the
// window exists. Every failure is a value.

import "wire.resid";
import "setup.resid";
import "events.resid";

/// An opened connection: the socket, what the server said about itself,
/// bytes received but not yet framed, and why it failed, if it did.
type Session = { Int fd; Setup setup; List(Int) buf; Str err; };

Session session_failed(Int fd, Str why) { return Session { .fd = fd, .setup = setup_empty(), .buf = [], .err = why }; }

/// Connect to the X server DISPLAY names and complete the handshake, with
/// the MIT-MAGIC-COOKIE-1 the session's authority file holds for it, or
/// with none when there is no cookie (a server started without `-auth`).
@requires(display)
pub Session x11_open() {
    Int fd = resid_disp_connect_x11();
    if (fd < 0) { return session_failed(-1, "x11: no display to connect to"); }
    return x11_handshake_auth(fd, resid_disp_x11_auth());
}

/// The handshake over an already connected socket, without authorization.
@requires(display)
pub Session x11_handshake(Int fd) { return x11_handshake_auth(fd, []); }

/// The handshake with a cookie, or without one when `cookie` is empty.
@requires(display)
pub Session x11_handshake_auth(Int fd, List(Int) cookie) {
    Str name = if (cookie.len() > 0) { "MIT-MAGIC-COOKIE-1" } else { "" };
    if (!resid_disp_send(fd, setup_request(name, cookie), -1)) { return session_failed(fd, "x11: could not send the setup request"); }
    List(Int) head = recv_until(fd, 8, []);
    if (head.len() < 8) { return session_failed(fd, "x11: the server closed the connection during setup"); }
    Int need = 8 + (half_at(head, 6) & 65535) * 4;
    List(Int) all = recv_until(fd, need, head);
    if (all.len() < need) { return session_failed(fd, "x11: setup reply cut short"); }
    return match (setup_parse(all[0..need])) {
        Ok(s) => Session { .fd = fd, .setup = s, .buf = all[need..all.len()], .err = "" },
        Err(e) => session_failed(fd, e)
    };
}

/// Receive until `buf` holds at least `want` bytes, or the peer closes.
@requires(display)
pub List(Int) recv_until(Int fd, Int want, List(Int) buf) {
    if (buf.len() >= want) { return buf; }
    List(Int) got = resid_disp_recv(fd, 65536);
    if (got.len() == 0) { return buf; }
    return recv_until(fd, want, buf.concat(got));
}

/// What a round trip produced: the reply (empty on failure), the bytes
/// left in the buffer after it, and the error text when there was one.
type Reply = { List(Int) msg; List(Int) buf; Str err; };

/// Send `r` and read until its reply or error.
@requires(display)
pub Reply x11_call(Int fd, List(Int) r, List(Int) buf) {
    if (!resid_disp_send(fd, r, -1)) { return Reply { .msg = [], .buf = buf, .err = "x11: send failed" }; }
    return x11_await(fd, buf);
}

/// Read until a reply or an error arrives.
@requires(display)
pub Reply x11_await(Int fd, List(Int) buf) {
    XIn m = x_take(buf);
    if (m.kind == 1) { return Reply { .msg = m.msg, .buf = m.rest, .err = "" }; }
    if (m.kind == 2) { return Reply { .msg = [], .buf = m.rest, .err = x_error_text(m.msg) }; }
    if (m.kind == 3) { return x11_await(fd, m.rest); }
    if (m.kind < 0) { return Reply { .msg = [], .buf = [], .err = "x11: corrupt reply" }; }
    List(Int) got = resid_disp_recv(fd, 65536);
    if (got.len() == 0) { return Reply { .msg = [], .buf = buf, .err = "x11: the server closed the connection" }; }
    return x11_await(fd, buf.concat(got));
}

/// The 32-bit word at `at` of a reply, or 0.
pub Int reply_word(Reply r, Int at) { return word_at(r.msg, at) else { 0 }; }

/// The byte at `at` of a reply, or 0.
pub Int reply_byte(Reply r, Int at) { return if (at >= 0 && at < r.msg.len()) { r.msg[at] } else { 0 }; }

/// Close the session's socket.
@requires(display)
pub Bool x11_close_fd(Int fd) {
    if (fd < 0) { return false; }
    return resid_disp_close(fd);
}

test "a session that never connected carries no fd" {
    Session s = session_failed(-1, "none");
    expect(s.fd < 0).toEqual(true);
    expect(s.setup.vendor).toEqual("");
    expect(s.err).toEqual("none");
}
