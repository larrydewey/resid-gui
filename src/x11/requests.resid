// requests.resid — the X11 requests a self-rendering client sends, one
// hand-written encoder each (PLAN-gui.md §3.2), laid out as the X Window
// System Protocol and the MIT-SHM extension specify them.
//
// Every request is `[opcode:1][data:1][length:2]` followed by its fields,
// and the length counts 4-byte units including the header: a server that
// reads a different number of words than were sent loses sync for the rest
// of the connection. Every encoder builds the fields first and lets `req`
// pad them and prepend the header with the real length.

import "wire.resid";

// ─── Opcodes ────────────────────────────────────────────────────────

pub Int op_create_window() { return 1; }
pub Int op_destroy_window() { return 4; }
pub Int op_map_window() { return 8; }
pub Int op_intern_atom() { return 16; }
pub Int op_change_property() { return 18; }
pub Int op_create_gc() { return 55; }
pub Int op_free_gc() { return 60; }
pub Int op_put_image() { return 72; }
pub Int op_query_extension() { return 98; }
pub Int op_no_operation() { return 127; }

// MIT-SHM's minor opcodes. Its major opcode is whatever `QueryExtension`
// says: an extension has no fixed number.
pub Int shm_query_version() { return 0; }
pub Int shm_detach() { return 2; }
pub Int shm_put_image() { return 3; }
pub Int shm_attach_fd() { return 6; }

// Predefined atoms (protocol appendix B).
pub Int atom_atom() { return 4; }
pub Int atom_string() { return 31; }
pub Int atom_wm_name() { return 39; }
pub Int atom_wm_normal_hints() { return 40; }
pub Int atom_wm_size_hints() { return 41; }
pub Int atom_wm_class() { return 67; }

// Window classes and the image format a canvas is sent in.
pub Int class_input_output() { return 1; }
pub Int format_zpix() { return 2; }

// `CreateWindow` attribute bits, in the order their values follow.
pub Int cw_back_pixmap() { return 1; }
pub Int cw_event_mask() { return 2048; }

/// The events the client selects: keys, buttons, motion, exposure,
/// structure (resize, destroy) and focus.
pub Int event_mask_all() { return 1 | 2 | 4 | 8 | 64 | 32768 | 131072 | 2097152; }

// `CreateGC` attribute bit for graphics exposures: off, so no
// `NoExpose` event follows every image.
pub Int gc_graphics_exposures() { return 65536; }

// ─── The header ────────────────────────────────────────────────────

/// A request: `opcode`, its data byte, and its fields, padded to a word,
/// behind a header whose length counts the whole thing.
pub List(Int) req(Int opcode, Int data, List(Int) fields) {
    List(Int) a = pad4(fields);
    ListBuf(Int) b = enc_bytes_list(enc_word16(enc_byte(enc_byte(enc_new(), opcode), data), (4 + a.len()) / 4), a, 0);
    return enc_finish(b);
}

/// The fields of a request with only a 32-bit id in them.
List(Int) one_id(Int v) { return enc_finish(enc_word32(enc_new(), v)); }

/// `NoOperation`, one word.
pub List(Int) req_none() { return req(op_no_operation(), 0, []); }

// ─── Windows ────────────────────────────────────────────────────────

/// `CreateWindow`: `wid` as a child of `parent`, `w` x `h` with no border,
/// at `depth` and `visual` (0 copies the parent's), with the attribute
/// `mask` and its `values` in bit order.
pub List(Int) req_create_window(Int wid, Int parent, Int w, Int h, Int depth, Int visual, Int mask, List(Int) values) {
    ListBuf(Int) b = enc_words(enc_new(), [wid, parent]);
    ListBuf(Int) c = enc_words16(b, [0, 0, w, h, 0, class_input_output()]);
    return req(op_create_window(), depth, enc_finish(enc_words(enc_words(c, [visual, mask]), values)));
}

/// `MapWindow`.
pub List(Int) req_map_window(Int wid) { return req(op_map_window(), 0, one_id(wid)); }

/// `DestroyWindow`.
pub List(Int) req_destroy_window(Int wid) { return req(op_destroy_window(), 0, one_id(wid)); }

// ─── Graphics contexts ──────────────────────────────────────────────

/// `CreateGC` on `drawable` with the attribute `mask` and its `values`.
pub List(Int) req_create_gc(Int cid, Int drawable, Int mask, List(Int) values) {
    return req(op_create_gc(), 0, enc_finish(enc_words(enc_words(enc_new(), [cid, drawable, mask]), values)));
}

/// `FreeGC`.
pub List(Int) req_free_gc(Int cid) { return req(op_free_gc(), 0, one_id(cid)); }

// ─── Atoms, properties and extensions ───────────────────────────────

/// `InternAtom` for an ASCII name; the reply's word at byte 8 is the atom.
pub List(Int) req_intern_atom(Str name, Bool only_if_exists) {
    ListBuf(Int) b = enc_words16(enc_new(), [str_len(name), 0]);
    return req(op_intern_atom(), if (only_if_exists) { 1 } else { 0 }, enc_finish(enc_str_at(b, name, 0)));
}

/// `ChangeProperty` in Replace mode with 8-bit data.
pub List(Int) req_change_property8(Int wid, Int prop, Int type, List(Int) data) {
    ListBuf(Int) b = enc_bytes(enc_byte(enc_words(enc_new(), [wid, prop, type]), 8), 3, 0);
    return req(op_change_property(), 0, enc_finish(enc_bytes_list(enc_word32(b, data.len()), data, 0)));
}

/// `ChangeProperty` in Replace mode with 32-bit data.
pub List(Int) req_change_property32(Int wid, Int prop, Int type, List(Int) words) {
    ListBuf(Int) b = enc_bytes(enc_byte(enc_words(enc_new(), [wid, prop, type]), 32), 3, 0);
    return req(op_change_property(), 0, enc_finish(enc_words(enc_word32(b, words.len()), words)));
}

/// `WM_NORMAL_HINTS` pinning the window to `w` x `h`: minimum and maximum
/// size flags (16 and 32) and the eighteen-word `WM_SIZE_HINTS` layout.
pub List(Int) size_hints_fixed(Int w, Int h) {
    return [48, 0, 0, 0, 0, w, h, w, h, 0, 0, 0, 0, 0, 0, 0, 0, 0];
}

/// `QueryExtension`; the reply says whether the extension is present
/// (byte 8), its major opcode (9) and its first event code (10).
pub List(Int) req_query_extension(Str name) {
    ListBuf(Int) b = enc_words16(enc_new(), [str_len(name), 0]);
    return req(op_query_extension(), 0, enc_finish(enc_str_at(b, name, 0)));
}

// ─── Images ─────────────────────────────────────────────────────────

/// `PutImage` of `h` rows of `w` 32-bit pixels at (`x`, `y`), sent over
/// the socket: the fallback when MIT-SHM is missing. The rows are whole
/// words already, so there is no row padding.
pub List(Int) req_put_image(Int drawable, Int gc, Int w, Int h, Int x, Int y, Int depth, List(Int) px) {
    ListBuf(Int) b = enc_words16(enc_words(enc_new(), [drawable, gc]), [w, h, x, y]);
    ListBuf(Int) c = enc_bytes(enc_byte(enc_byte(b, 0), depth), 2, 0);
    return req(op_put_image(), format_zpix(), enc_finish(enc_bytes_list(c, px, 0)));
}

// ─── MIT-SHM ────────────────────────────────────────────────────────

/// `ShmQueryVersion`; the reply carries the major and minor version at
/// bytes 8 and 10.
pub List(Int) req_shm_query_version(Int major) { return req(major, shm_query_version(), []); }

/// `ShmAttachFd`: the segment's descriptor travels beside the request
/// (`resid_disp_send`'s `pass_fd`), never in it.
pub List(Int) req_shm_attach_fd(Int major, Int seg) {
    return req(major, shm_attach_fd(), enc_finish(enc_bytes(enc_word32(enc_new(), seg), 4, 0)));
}

/// `ShmDetach`.
pub List(Int) req_shm_detach(Int major, Int seg) { return req(major, shm_detach(), one_id(seg)); }

/// `ShmPutImage`: the rectangle (`sx`, `sy`, `sw`, `sh`) of a `tw` x `th`
/// image in segment `seg` drawn at (`dx`, `dy`), no pixels on the wire.
/// With `notify` the server sends a completion event once it has read
/// the segment, which is when the client may write it again.
pub List(Int) req_shm_put_image(Int major, Int drawable, Int gc, Int tw, Int th, Int sx, Int sy, Int sw, Int sh, Int dx, Int dy, Int depth, Int seg, Bool notify) {
    ListBuf(Int) b = enc_words16(enc_words(enc_new(), [drawable, gc]), [tw, th, sx, sy, sw, sh, dx, dy]);
    ListBuf(Int) c = enc_bytes_list(b, [depth, format_zpix(), if (notify) { 1 } else { 0 }, 0], 0);
    return req(major, shm_put_image(), enc_finish(enc_words(c, [seg, 0])));
}

/// The request's length field, in bytes.
pub Int req_len_bytes(List(Int) r) { return (half_at(r, 2) & 65535) * 4; }

// ─── Tests ──────────────────────────────────────────────────────────

test "the header counts the header" {
    List(Int) n = req_none();
    expect(n.len()).toEqual(4);
    expect(n[2]).toEqual(1);
    List(Int) m = req_map_window(7);
    expect(m.len()).toEqual(8);
    expect(m[0]).toEqual(8);
    expect(m[2]).toEqual(2);
    expect(m[4]).toEqual(7);
}

test "CreateWindow lays out its fields as the protocol does" {
    List(Int) r = req_create_window(100, 1, 640, 480, 0, 0, cw_back_pixmap() | cw_event_mask(), [0, event_mask_all()]);
    expect(r[0]).toEqual(1);
    expect(r.len()).toEqual(40);
    expect(req_len_bytes(r)).toEqual(40);
    expect(word_at(r, 4) else { -1 }).toEqual(100);   // wid
    expect(word_at(r, 8) else { -1 }).toEqual(1);     // parent
    expect(half_at(r, 12)).toEqual(0);                // x
    expect(half_at(r, 16)).toEqual(640);              // width
    expect(half_at(r, 18)).toEqual(480);              // height
    expect(half_at(r, 20)).toEqual(0);                // border
    expect(half_at(r, 22)).toEqual(1);                // class
    expect(word_at(r, 28) else { -1 }).toEqual(2049); // value mask
    expect(word_at(r, 36) else { -1 }).toEqual(event_mask_all());
}

test "ChangeProperty carries format, length and padded data" {
    List(Int) r = req_change_property8(5, atom_wm_name(), atom_string(), [104, 105, 33]);
    expect(r[0]).toEqual(18);
    expect(r.len()).toEqual(28);
    expect(req_len_bytes(r)).toEqual(28);
    expect(r[16]).toEqual(8);                          // format
    expect(word_at(r, 20) else { -1 }).toEqual(3);     // data length
    expect(r[24]).toEqual(104);
    List(Int) p = req_change_property32(5, 1, atom_atom(), [9]);
    expect(p[16]).toEqual(32);
    expect(word_at(p, 24) else { -1 }).toEqual(9);
    expect(req_len_bytes(p)).toEqual(p.len());
}

test "names are counted and padded" {
    List(Int) a = req_intern_atom("WM_PROTOCOLS", false);
    expect(half_at(a, 4)).toEqual(12);
    expect(a.len()).toEqual(20);
    expect(req_len_bytes(a)).toEqual(20);
    List(Int) q = req_query_extension("MIT-SHM");
    expect(q[0]).toEqual(98);
    expect(half_at(q, 4)).toEqual(7);
    expect(q.len()).toEqual(16);
}

test "MIT-SHM requests use the extension's opcode and minor numbers" {
    List(Int) a = req_shm_attach_fd(130, 300);
    expect(a[0]).toEqual(130);
    expect(a[1]).toEqual(6);
    expect(a.len()).toEqual(12);
    expect(word_at(a, 4) else { -1 }).toEqual(300);
    List(Int) p = req_shm_put_image(130, 5, 6, 64, 48, 1, 2, 3, 4, 1, 2, 24, 300, true);
    expect(p[1]).toEqual(3);
    expect(p.len()).toEqual(40);
    expect(req_len_bytes(p)).toEqual(40);
    expect(word_at(p, 4) else { -1 }).toEqual(5);      // drawable
    expect(half_at(p, 12)).toEqual(64);                // total width
    expect(half_at(p, 20)).toEqual(3);                 // source width
    expect(p[28]).toEqual(24);                         // depth
    expect(p[29]).toEqual(2);                          // ZPixmap
    expect(p[30]).toEqual(1);                          // send event
    expect(word_at(p, 32) else { -1 }).toEqual(300);   // segment
}

test "PutImage sends whole rows" {
    List(Int) r = req_put_image(1, 2, 2, 1, 0, 0, 24, [1, 2, 3, 4, 5, 6, 7, 8]);
    expect(r[1]).toEqual(2);
    expect(r.len()).toEqual(32);
    expect(req_len_bytes(r)).toEqual(32);
    expect(r[21]).toEqual(24);
}
