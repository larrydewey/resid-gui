// stream.resid — framing: turning a byte stream into whole requests.
//
// X11 is a byte stream, not a message stream: a client sends a request and
// the server must know where it ends before it can read the next one. The
// length field says, so framing is pure arithmetic over the buffer — which
// means it can be tested without a socket, and it is where an untrusted
// server can lie. A length that runs past what has arrived is not an
// error, just "wait for more"; a length that is zero or absurd is an
// error, because no server sends one.

import "wire.resid";
import "setup.resid";
import "requests.resid";

/// One request taken off the buffer, and what is left of it.
type Taken = {
    List(Int) req;   // the request bytes, header included
    List(Int) rest;  // everything after it
    Bool ok;         // false when more bytes are needed
    Bool bad;        // true when the length can never be satisfied
    Str err;
};

/// Take the next request off `buf`. `buf` may hold several, or part of
/// one; `ok` false means wait for more, `bad` true means the stream is
/// unrecoverable.
pub Taken take_request(List(Int) buf) {
    return take_request_at(buf, 2);
}

/// `take_request` for a request whose length field is not at bytes 2-3.
pub Taken take_request_at(List(Int) buf, Int len_at) {
    if (buf.len() < len_at + 2) { return taken_wait(buf); }
    Int units = half_at(buf, len_at) & 65535;
    if (units == 0) { return taken_bad(buf, "x11: zero-length request"); }
    Int n = units * 4;
    if (buf.len() < n) { return taken_wait(buf); }
    return Taken { .req = bytes_slice(buf, 0, n), .rest = bytes_slice(buf, n, buf.len()),
                   .ok = true, .bad = false, .err = "" };
}

/// The setup request, which has no length field: its size is the 12-byte
/// header plus the authorization name and data, each padded to a word. The
/// two lengths are at bytes 6-7 and 8-9, and both are checked against what
/// has arrived.
pub Taken take_setup(List(Int) buf) {
    if (buf.len() < 12) { return taken_wait(buf); }
    Int n = half_at(buf, 6) & 65535;
    Int d = half_at(buf, 8) & 65535;
    Int total = 12 + pad_len(n) + pad_len(d);
    if (buf.len() < total) { return taken_wait(buf); }
    return Taken { .req = bytes_slice(buf, 0, total), .rest = bytes_slice(buf, total, buf.len()),
                   .ok = true, .bad = false, .err = "" };
}

/// A length padded out to a 4-byte boundary.
pub Int pad_len(Int n) { return n + ((4 - (n & 3)) & 3); }

/// Nothing yet: the caller keeps the buffer and tries again.
Taken taken_wait(List(Int) buf) {
    return Taken { .req = [], .rest = buf, .ok = false, .bad = false, .err = "" };
}

/// Unrecoverable: the length can never be satisfied.
Taken taken_bad(List(Int) buf, Str why) {
    return Taken { .req = [], .rest = buf, .ok = false, .bad = true, .err = why };
}

/// `bs[a..b)`, bounds-checked: a decoder that could index past the end is
/// not a decoder.
pub List(Int) bytes_slice(List(Int) bs, Int a, Int b) {
    Int lo = if (a < 0) { 0 } else { a };
    if (lo >= b || lo >= bs.len()) { return []; }
    Int stop = if (b > bs.len()) { bs.len() } else { b };
    return bs[lo..stop];
}

/// Everything from the buffer, for a caller that wants to wait rather than
/// frame.
pub List(Int) take_all(List(Int) buf) { return buf; }

test "a request is framed by its length field" {
    List(Int) r = [8, 0, 2, 0, 7, 0, 0, 0];
    Taken t = take_request(r);
    expect(t.ok).toEqual(true);
    expect(f"{t.req}").toEqual(f"{r}");
    expect(t.rest.len()).toEqual(0);
}

test "two requests in one buffer come off one at a time" {
    List(Int) a = [8, 0, 2, 0, 7, 0, 0, 0];
    List(Int) b = [127, 0, 1, 0];
    Taken t1 = take_request(a.concat(b));
    expect(f"{t1.req}").toEqual(f"{a}");
    expect(f"{t1.rest}").toEqual(f"{b}");
    Taken t2 = take_request(t1.rest);
    expect(f"{t2.req}").toEqual(f"{b}");
    expect(t2.rest.len()).toEqual(0);
}

test "a partial request waits for more bytes" {
    expect(take_request([8, 0, 2, 0, 7]).ok).toEqual(false);
    expect(take_request([8, 0, 2]).ok).toEqual(false);
    expect(take_request([8, 0]).ok).toEqual(false);
    expect(take_request([]).ok).toEqual(false);
    // Nothing is lost while waiting.
    expect(f"{take_request([8, 0, 2]).rest}").toEqual("[8, 0, 2]");
}

test "a length that can never be satisfied is bad, not merely incomplete" {
    Taken t = take_request([8, 0, 0, 0]);
    expect(t.bad).toEqual(true);
    expect(t.err).toEqual("x11: zero-length request");
    // A length field past the end of what can arrive is bounded by the
    // largest number of bytes a client would send.
    expect(take_request([8, 0, 255, 255]).bad).toEqual(false);
}

test "the setup request is framed by its own two lengths" {
    // 108, 11.0, no cookie: the header alone.
    List(Int) s = [108, 0, 11, 0, 0, 0, 0, 0, 0, 0, 0, 0];
    Taken t = take_setup(s);
    expect(t.ok).toEqual(true);
    expect(t.req.len()).toEqual(12);
    expect(take_setup([108, 0, 11, 0]).ok).toEqual(false);

    // A one-character name and two data bytes, each padded to a word.
    List(Int) with_cookie = setup_request_v(11, 0, "X", [1, 2]);
    Taken t2 = take_setup(with_cookie);
    expect(t2.ok).toEqual(true);
    expect(t2.req.len()).toEqual(with_cookie.len());
    expect(with_cookie.len()).toEqual(20);
    expect(pad_len(3)).toEqual(4);
    expect(pad_len(4)).toEqual(4);
}

test "a ChangeProperty is framed like any other request" {
    List(Int) cp = req_change_property8(100, 39, 31, [104, 105]);
    List(Int) mixed = req_map_window(7).concat(cp);
    Taken a = take_request(mixed);
    expect(a.ok).toEqual(true);
    expect(a.req[0]).toEqual(op_map_window());
    Taken b = take_request(a.rest);
    expect(b.ok).toEqual(true);
    expect(b.req[0]).toEqual(op_change_property());
    expect(b.req.len()).toEqual(cp.len());
    expect(b.rest.len()).toEqual(0);
}

test "slicing is bounds-checked" {
    expect(bytes_slice([1, 2, 3, 4], 1, 3).len()).toEqual(2);
    expect(bytes_slice([1, 2, 3, 4], 1, 3)[0]).toEqual(2);
    expect(bytes_slice([1, 2], 0, 9).len()).toEqual(2);
    expect(bytes_slice([1, 2], 5, 9).len()).toEqual(0);
    expect(bytes_slice([1, 2], 3, 2).len()).toEqual(0);
}