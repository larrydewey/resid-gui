// clip_cost.resid — drawing costs what the clip shows.
//
// A frame redraws its damaged rectangles, often a strip a pixel wide (a
// caret) or a few rows. Each case here draws a shape far larger than such
// a strip into it. The pixels must be the ones the whole shape gives
// there, and the time must be the strip's, not the shape's: each case
// takes seconds when every pixel of the shape is visited, and
// milliseconds when only the clipped ones are.

import "../src/gfx/canvas.resid";
import "../src/gfx/color.resid";
import "../src/gfx/font.resid";
import "../src/gfx/text.resid";
import "../src/gfx/image.resid";
import "../src/gfx/shapes.resid";

@requires(clock(readonly))
Int now_ms() { return clock.monotonic_ns() / 1000000; }

/// What the slow path takes is far above this on any machine; what the
/// clipped one takes is far below.
Int budget_ms() { return 2000; }

// ─── UI-2: rounded corners ─────────────────────────────────────────

/// The colour pixel (`px`, `py`) gets from a corner of radius `rad`
/// centred on (`cx`, `cy`), drawn over `bg`.
Color corner_pixel(Int px, Int py, Int cx, Int cy, Int rad, Color ink, Color bg) {
    Int a = coverage(px, py, cx, cy, rad);
    Canvas one = canvas_filled(1, 1, bg);
    return pixel_at(if (a == 0) { one } else { blend_pixel_clip(one, 0, 0, ink, a, canvas_bounds(one)) }, 0, 0);
}

Bool column_matches(Canvas c, Int x, Int y, Int n, Int rad, Color ink, Color bg) {
    if (n <= 0) { return true; }
    return color_eq(pixel_at(c, x, y), corner_pixel(x, y, rad, rad, rad, ink, bg)) && column_matches(c, x, y + 1, n - 1, rad, ink, bg);
}

@requires(clock(readonly))
test "a huge rounded rectangle drawn into a thin strip costs the strip" {
    Color bg = rgb(255, 255, 255);
    Color ink = rgb(10, 20, 30);
    Canvas c = canvas_filled(600, 600, bg);
    // the top-left corner's edge passes x = 586 near y = 586 for radius
    // 2000; the canvas shows only that corner of the 16000-pixel shape
    Rect strip = Rect { .x = 586, .y = 580, .w = 1, .h = 16 };
    Canvas small = fill_round_clip(c, Rect { .x = 0, .y = 0, .w = 4000, .h = 4000 }, 2000, ink, strip);
    expect(column_matches(small, 586, 580, 16, 2000, ink, bg)).toEqual(true);
    Int t0 = now_ms();
    Canvas d = fill_round_clip(c, Rect { .x = 0, .y = 0, .w = 16000, .h = 16000 }, 8000, ink, strip);
    Int took = now_ms() - t0;
    expect(column_matches(d, 586, 580, 16, 8000, ink, bg)).toEqual(true);
    expect(color_eq(pixel_at(d, 585, 590), bg)).toEqual(true);
    expect(took < budget_ms()).toEqual(true);
}

// ─── GP-4: a glyph far larger than the clip ────────────────────────

ListBuf(Int) put_le(ListBuf(Int) b, Int v) { return b.push(v & 255).push((v >> 8) & 255).push((v >> 16) & 255).push((v >> 24) & 255); }

ListBuf(Int) put_n(ListBuf(Int) b, Int v, Int n) {
    if (n <= 0) { return b; }
    return put_n(b.push(v), v, n - 1);
}

ListBuf(Int) records(ListBuf(Int) b, Int i, Int gw, Int gh) {
    if (i >= 95) { return b; }
    // "A" (65) is a gw x gh block at the atlas's corner; the rest are empty
    Bool big = i + 32 == 65;
    ListBuf(Int) r = put_le(put_le(put_le(put_le(put_le(put_le(put_le(b, 10), 0), 0), if (big) { gw } else { 0 }), if (big) { gh } else { 0 }), 0), 0);
    return records(r, i + 1, gw, gh);
}

/// A font answer whose "A" is a fully covered `gw` x `gh` block, on a
/// line `line` pixels tall.
List(Int) block_font(Int gw, Int gh, Int line) {
    ListBuf(Int) h = put_le(put_le(put_le(put_le(put_le(put_le(put_le(put_le(ListBuf(), 826689362), 0), line / 2), line), gw), gh), 95), 0);
    return put_n(put_n(records(h, 0, gw, gh), 0, 1024 * 4), 255, gw * gh).finish();
}

Font parsed(List(Int) a, Int scale) { return font_parse(a, scale) else { font_builtin() }; }

@requires(clock(readonly))
test "a glyph of half a million pixels drawn into one pixel costs the pixel" {
    // 1024 x 512 on a 256-pixel line: four lines wide, two tall
    Font f = parsed(block_font(1024, 512, 256), 1);
    expect(font_is_builtin(f)).toEqual(false);
    Color bg = rgb(255, 255, 255);
    Canvas c = canvas_filled(64, 64, bg);
    Rect one = Rect { .x = 40, .y = 40, .w = 1, .h = 1 };
    Int t0 = now_ms();
    // drawn at device scale 32 over an atlas made for 1: each glyph pixel
    // a 32 x 32 block, half a billion blends for the whole glyph
    Canvas d = render_text_font(c, 0, 0, "A", rgb(0, 0, 0), one, 32, f);
    Int took = now_ms() - t0;
    expect(pixel_at(d, 40, 40).r).toEqual(0);
    expect(pixel_at(d, 41, 40).r).toEqual(255);
    expect(pixel_at(d, 39, 40).r).toEqual(255);
    expect(took < budget_ms()).toEqual(true);
}

test "a glyph taller than two lines is refused" {
    Bool refused = match (font_parse(block_font(4, 2000, 20), 1)) { Ok(f) => false, Err(e) => e == "font: a glyph is too large for its line" };
    expect(refused).toEqual(true);
    Bool wide = match (font_parse(block_font(100, 10, 20), 1)) { Ok(f) => false, Err(e) => true };
    expect(wide).toEqual(true);
    Bool fits = match (font_parse(block_font(80, 40, 20), 1)) { Ok(f) => true, Err(e) => false };
    expect(fits).toEqual(true);
}

// ─── GP-6: an image far larger than the clip ───────────────────────

@requires(clock(readonly))
test "a scaled image of a million pixels drawn into one pixel costs the pixel" {
    Int n = 1000;
    Image im = Image { .w = n, .h = n, .px = canvas_fill(0, n * n * 4, ListBuf()) };
    Color bg = rgb(255, 255, 255);
    Canvas c = canvas_filled(64, 64, bg);
    Rect one = Rect { .x = 10, .y = 10, .w = 1, .h = 1 };
    Int t0 = now_ms();
    // scale 32 and fully transparent: every pixel a 32 x 32 blend of
    // nothing, a billion for the whole image
    Canvas d = blit_scaled(c, im, 0, 0, one, 32);
    Int took = now_ms() - t0;
    expect(color_eq(pixel_at(d, 10, 10), bg)).toEqual(true);
    expect(took < budget_ms()).toEqual(true);
}

test "a scaled image lands where it did, clipped" {
    // a 2 x 2 image, red / green / blue / white, at scale 2, from (1, 1)
    Image im = Image { .w = 2, .h = 2, .px = [0, 0, 255, 255, 0, 255, 0, 255, 255, 0, 0, 255, 255, 255, 255, 255] };
    Canvas c = canvas_filled(6, 6, rgb(0, 0, 0));
    Canvas d = blit_scaled(c, im, 1, 1, Rect { .x = 2, .y = 2, .w = 3, .h = 3 }, 2);
    expect(pixel_at(d, 1, 1).r).toEqual(0);
    expect(pixel_at(d, 2, 2).r).toEqual(255);
    expect(pixel_at(d, 3, 2).g).toEqual(255);
    expect(pixel_at(d, 2, 3).b).toEqual(255);
    expect(pixel_at(d, 4, 4).r).toEqual(255);
    expect(pixel_at(d, 4, 4).b).toEqual(255);
    expect(pixel_at(d, 5, 5).r).toEqual(0);
}
