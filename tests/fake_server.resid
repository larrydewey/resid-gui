// fake_server.resid — the X11 backend against a fake server over a socket
// pair.
//
// The client is the library's own code: `x11_handshake`, `x11_start_on`
// (atoms, MIT-SHM, the window, two attached segments) and `x11_present`.
// It runs in a spawned region; the server runs here and is the referee. It
// answers the setup and every request that has a reply, checks that each
// request's length field matches its bytes, and records what it saw: the
// requests by opcode, how many descriptors arrived with `ShmAttachFd`, and
// the rectangle of the first `ShmPutImage`.

import "../src/app.resid";
import "../src/gfx/color.resid";
import "../src/gfx/draw.resid";
import "../src/gfx/font.resid";
import "../src/gfx/raster.resid";
import "../src/x11/wire.resid";
import "../src/x11/setup.resid";
import "../src/x11/requests.resid";
import "../src/x11/events.resid";
import "../src/x11/stream.resid";
import "../src/x11/connect.resid";
import "../src/x11/x11.resid";
import "../src/backend/keymap.resid";

/// The extension opcode and first event the fake server gives MIT-SHM.
Int fake_shm() { return 130; }
Int fake_shm_event() { return 90; }

/// A 32-byte reply with the given words from byte 8 on.
List(Int) reply_words(Int seq, List(Int) words) {
    ListBuf(Int) b = enc_words(enc_word16(enc_byte(enc_byte(enc_new(), 1), 0), seq), [0]);
    List(Int) r = enc_finish(enc_words(b, words));
    return r.concat(enc_finish(enc_bytes(enc_new(), 32 - r.len(), 0)));
}

/// The reply to a request that has one, or an empty list.
List(Int) answer(List(Int) r, Int seq) {
    Int op = r[0];
    if (op == op_intern_atom()) { return reply_words(seq, [500 + seq]); }
    if (op == op_query_extension()) {
        // present, major opcode, first event, first error
        return reply_words(seq, [1 | (fake_shm() << 8) | (fake_shm_event() << 16)]);
    }
    if (op == fake_shm() && r[1] == shm_query_version()) { return reply_words(seq, [1 | (2 << 16)]); }
    if (op == op_get_keyboard_mapping()) { return mapping_reply(seq, r[4], r[5]); }
    return [];
}

/// A keyboard mapping of two keysyms per key code, all empty but key code
/// 38 (evdev 30, US `a`), which types q and Q as on a French layout.
List(Int) mapping_reply(Int seq, Int first, Int count) {
    ListBuf(Int) h = enc_words(enc_word16(enc_byte(enc_byte(enc_new(), 1), 2), seq), [count * 2]);
    ListBuf(Int) b = enc_bytes(h, 24, 0);
    return enc_finish(mapping_syms(b, first, 0, count));
}

ListBuf(Int) mapping_syms(ListBuf(Int) b, Int first, Int i, Int count) {
    if (i >= count) { return b; }
    List(Int) two = if (first + i == 38) { [113, 81] } else { [0, 0] };
    return mapping_syms(enc_words(b, two), first, i + 1, count);
}

/// What the server saw.
type Seen = { List(Int) ops; Int fds; Rect put; Bool bad; Str why; };

Seen seen_bad(Seen s, Str why) { return Seen { .ops = s.ops, .fds = s.fds, .put = s.put, .bad = true, .why = why }; }

@requires(display)
Seen serve(Int fd) {
    List(Int) buf = recv_until(fd, 12, []);
    Taken s0 = take_setup(buf);
    Seen none = Seen { .ops = [], .fds = 0, .put = rect_none(), .bad = false, .why = "" };
    if (!s0.ok || s0.req[0] != 108) { return seen_bad(none, "no setup request"); }
    if (!resid_disp_send(fd, setup_reply_bytes(0x00400000, 0x001fffff, "fake", 0x100, 33, 1920, 1080), -1)) { return seen_bad(none, "reply failed"); }
    return serve_requests(fd, s0.rest, 1, none);
}

@requires(display)
Seen serve_requests(Int fd, List(Int) buf, Int seq, Seen seen) {
    Taken t = take_request(buf);
    if (t.bad) { return seen_bad(seen, t.err); }
    if (!t.ok) {
        List(Int) got = resid_disp_recv(fd, 65536);
        if (got.len() == 0) { return seen; }
        return serve_requests(fd, t.rest.concat(got), seq, seen);
    }
    List(Int) r = t.req;
    if (req_len_bytes(r) != r.len()) { return seen_bad(seen, "length field disagrees with the bytes"); }
    Bool attach = r[0] == fake_shm() && r[1] == shm_attach_fd();
    Int fd_in = if (attach) { resid_disp_recv_fd() } else { -1 };
    _ = if (fd_in >= 0) { resid_disp_close(fd_in) } else { false };
    List(Int) back = answer(r, seq);
    if (back.len() > 0 && !resid_disp_send(fd, back, -1)) { return seen_bad(seen, "answer failed"); }
    Bool put = r[0] == fake_shm() && r[1] == shm_put_image();
    Rect pr = if (put) { Rect { .x = half_at(r, 16), .y = half_at(r, 18), .w = half_at(r, 20), .h = half_at(r, 22) } } else { seen.put };
    Seen next = Seen { .ops = seen.ops.concat([r[0]]), .fds = seen.fds + if (fd_in >= 0) { 1 } else { 0 }, .put = pr, .bad = false, .why = "" };
    if (put) { return next; }
    return serve_requests(fd, t.rest, seq + 1, next);
}

/// The client: open a 64x48 window and present one frame with a red
/// square in it.
@requires(display, clock(readonly))
Int client(Int fd) {
    Session s = x11_handshake(fd);
    if (str_len(s.err) > 0) { return 1; }
    X11 x = x11_start_on(s, WindowOptions { .title = "fake", .width = 64, .height = 48, .resizable = false });
    if (!x.alive) { return 2; }
    if (x.shm != fake_shm() || x.shm_event != fake_shm_event()) { return 3; }
    if (x.w != 64 || x.h != 48 || x.wid != 0x00400001) { return 4; }
    if (key_text_in(x.keys.map, 30, mods_none()) != "q" || key_text_in(x.keys.map, 30, mods_from_mask(1, 0)) != "Q") { return 6; }
    List(DrawOp) ops = [OpFill(Rect { .x = 8, .y = 8, .w = 16, .h = 16 }, rgb(255, 0, 0))];
    X11 y = x11_present(x, Frame { .ops = ops, .scale = 1, .font = font_builtin() }, [Rect { .x = 0, .y = 0, .w = 64, .h = 48 }]);
    return if (y.s0.busy) { 0 } else { 5 };
}

Bool has(List(Int) xs, Int v, Int i) { return if (i >= xs.len()) { false } else { xs[i] == v || has(xs, v, i + 1) }; }

@requires(display, clock(readonly))
test "the X11 backend opens a window and presents through MIT-SHM" {
    List(Int) pair = resid_disp_pair();
    expect(pair.len()).toEqual(2);
    Int sfd = pair[0];
    Int cfd = pair[1];
    Result(Int, RegionError) r = spawn (display, clock(readonly)) {
        return client(cfd);
    };
    Seen seen = serve(sfd);
    expect(seen.why).toEqual("");
    expect(seen.bad).toEqual(false);
    expect(r else { -1 }).toEqual(0);
    expect(has(seen.ops, op_intern_atom(), 0)).toEqual(true);
    expect(has(seen.ops, op_get_keyboard_mapping(), 0)).toEqual(true);
    expect(has(seen.ops, op_create_window(), 0)).toEqual(true);
    expect(has(seen.ops, op_change_property(), 0)).toEqual(true);
    expect(has(seen.ops, op_create_gc(), 0)).toEqual(true);
    expect(has(seen.ops, op_map_window(), 0)).toEqual(true);
    expect(seen.fds).toEqual(2);
    expect(seen.put.w).toEqual(64);
    expect(seen.put.h).toEqual(48);
}

test "replies frame as the client expects" {
    List(Int) r = reply_words(3, [7]);
    expect(r.len()).toEqual(32);
    expect(x_take(r).kind).toEqual(1);
    expect(word_at(r, 8) else { 0 }).toEqual(7);
}
