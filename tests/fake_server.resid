// fake_server.resid — a client and a fake X server over one socket pair.
//
// This is the exit criterion for the first half of G2 (PLAN-gui.md §3.5):
// a client that completes the connection setup, opens a window, attaches a
// shared segment and presents a frame, against a server that only has to
// answer. Nothing here renders: the frame is one solid colour, and the
// server checks the bytes rather than showing anything.
//
// The client runs in a spawned region and the server in the main thread,
// because the two must be in step with each other and only one of them can
// block. The server is the referee: it returns a count of what it saw, and
// the test asserts on that.

import "../src/x11/wire.resid";
import "../src/x11/setup.resid";
import "../src/x11/requests.resid";
import "../src/x11/stream.resid";
import "../src/x11/conn.resid";

// ─── The server's reply ─────────────────────────────────────────────

/// The setup reply the fake server sends: release 1, resource ids from
/// 0x2000_0000 with a mask of 0x001f_ffff, vendor "fake". The length
/// field is derived from the bytes, so a client that trusts it and a
/// server that means it cannot disagree.
pub List(Int) fake_setup_reply() {
    ListBuf(Int) e = enc_words(enc_new(), [1, 0x20000000, 0x001fffff, 65536]);
    ListBuf(Int) f = enc_words16(e, [4, 65535]);              // vendor len, max request
    ListBuf(Int) g = enc_bytes(f, 8, 0);                     // screens..max keycode
    List(Int) body = pad_to(enc_finish(enc_str_at(g, "fake", 0)), 4);
    Int units = (body.len() + 3) / 4;
    ListBuf(Int) a = enc_byte(enc_byte(enc_new(), 1), 0);     // success, no auth
    ListBuf(Int) b = enc_word16(a, 11);                       // major version
    ListBuf(Int) c = enc_word16(b, 0);                        // minor version
    return enc_finish(enc_word16(c, units)).concat(body);
}

/// The reply to `ShmAttach`: a segment id of 0x3000_0001.
pub List(Int) fake_attach_reply() {
    ListBuf(Int) b = enc_byte(enc_byte(enc_new(), 1), 1);
    ListBuf(Int) c = enc_words16(b, [0]);                    // sequence
    ListBuf(Int) d = enc_words(c, [0]);                      // extra length
    ListBuf(Int) e = enc_words(d, [0x30000001]);             // the segment id
    ListBuf(Int) f = enc_words(e, [0, 0]);
    ListBuf(Int) g = enc_bytes(f, 16, 0);
    return enc_finish(g);
}

/// Whether a read succeeded. `Result` has no `ok` field, and a caller that
/// wants only that should not have to match.
Bool got_bytes(Result(List(Int), Str) r) {
    return match (r) { Ok(v) => true, Err(e) => false };
}

/// The bytes of a read, or an empty list when it failed.
List(Int) read_value(Result(List(Int), Str) r) {
    return match (r) { Ok(v) => v, Err(e) => [] };
}

// ─── Reading exactly `want` bytes ───────────────────────────────────

/// Read until `buf` holds `want` bytes. `want` must be a real count: a
/// receive blocks, so "read whatever is there" is `read_some`, not a loop
/// with no end.
@requires(display)
Result(List(Int), Str) read_exact(Int fd, Int want, List(Int) buf) {
    if (buf.len() >= want) { return Ok(buf); }
    List(Int) got = resid_disp_recv(fd, 65536);
    if (got.len() == 0) { return Err("x11: connection closed while reading"); }
    return read_exact(fd, want, buf.concat(got));
}

/// One receive, whatever arrives. A reply's own length field says how much
/// more is needed, so one read is enough to start.
@requires(display)
Result(List(Int), Str) read_some(Int fd, List(Int) buf) {
    List(Int) got = resid_disp_recv(fd, 65536);
    if (got.len() == 0) { return Err("x11: connection closed while reading"); }
    return Ok(buf.concat(got));
}

// ─── The client ─────────────────────────────────────────────────────

/// Connect, open a window and present one solid frame. Runs in a region.
@requires(display)
pub Int client_session(Int fd) {
    Bool sent0 = resid_disp_send(fd, setup_request("", []), -1);
    if (!sent0) { return 1; }
    Result(List(Int), Str) r0 = read_some(fd, []);
    if (!got_bytes(r0)) { return 2; }
    List(Int) head = read_value(r0);
    if (head.len() < 8) { return 2; }
    // The setup reply's length field says how much of it there is.
    Int need = 8 + ((half_at(head, 6) & 65535) * 4);
    Result(List(Int), Str) r0b = read_exact(fd, need, head);
    if (!got_bytes(r0b)) { return 2; }
    Setup s = setup_parse(read_value(r0b)) else { setup_empty() };
    if (s.id_base == 0) { return 3; }
    Conn c = conn_new(s);
    List(List(Int)) seq = conn_open_window(c, 64, 48);
    Int sent = send_all(fd, seq, conn_segment_id(c));
    if (sent != seq.len()) { return 4; }
    Result(List(Int), Str) r1 = read_exact(fd, 32, []);
    if (!got_bytes(r1)) { return 5; }
    Int seg_id = reply_word32(read_value(r1), 0) else { 0 };
    if (seg_id != 0x30000001) { return 7; }
    List(Int) put = conn_present(c, 64, 48);
    if (!resid_disp_send(fd, put, -1)) { return 8; }
    return 0;
}

/// Send the open-window sequence. The last one is the SHM attach, which
/// carries the descriptor out of band, so it is sent with a descriptor and
/// the rest without.
@requires(display)
Int send_all(Int fd, List(List(Int)) seq, Int seg) {
    Int shm = resid_disp_shm_new(64 * 48 * 4);
    if (shm == 0) { return 0; }
    Int n = 0;
    return send_from(fd, seq, seg, shm, n);
}

/// `send_all`'s loop: every request but the last goes out plainly, and the
/// last carries the segment's descriptor.
@requires(display)
Int send_from(Int fd, List(List(Int)) seq, Int seg, Int shm, Int n) {
    if (n >= seq.len()) { return n; }
    Bool last = (n == seq.len() - 1);
    Int pass = if (last) { resid_disp_shm_fd(shm) } else { -1 };
    if (!resid_disp_send(fd, seq[n], pass)) { return n; }
    return send_from(fd, seq, seg, shm, n + 1);
}

// ─── The server ─────────────────────────────────────────────────────

/// What the fake server saw: the opcode of each request, and whether the
/// descriptor arrived with the attach.
type Served = { Int requests; Int last_op; Int shm_op; Bool fd_seen; Bool bad; };

/// Accept one client: the setup, the open-window sequence, the attach and
/// one present. Returns what it saw.
@requires(display)
pub Served serve(Int fd, List(Int) buf) {
    return serve_setup(fd, buf);
}

/// The setup handshake: wait for the client's first bytes, check the byte
/// order, and answer with the reply whose length field matches its body.
@requires(display)
Served serve_setup(Int fd, List(Int) buf) {
    Taken s0 = take_setup(buf);
    if (s0.ok) { return serve_after_setup(fd, s0.req, s0.rest); }
    if (s0.bad) { return Served { .requests = 0, .last_op = -1, .shm_op = -1, .fd_seen = false, .bad = true }; }
    Result(List(Int), Str) got = read_some(fd, buf);
    if (!got_bytes(got)) { return Served { .requests = 0, .last_op = -1, .shm_op = -1, .fd_seen = false, .bad = true }; }
    return serve_setup(fd, read_value(got));
}

/// The handshake's checks, once the request has arrived whole.
@requires(display)
Served serve_after_setup(Int fd, List(Int) req, List(Int) rest) {
    if (half_at(req, 0) != 108) { return Served { .requests = 0, .last_op = -1, .shm_op = -1, .fd_seen = false, .bad = true }; }
    Bool back = resid_disp_send(fd, fake_setup_reply(), -1);
    if (!back) { return Served { .requests = 0, .last_op = -1, .shm_op = -1, .fd_seen = false, .bad = true }; }
    return serve_requests(fd, rest, 0, -1, -1, false, false);
}

/// Read the open-window sequence, answer the attach, and read the present.
/// `n` counts the requests taken so far.
@requires(display)
Served serve_requests(Int fd, List(Int) buf, Int n, Int last_op, Int shm_op, Bool fd_seen, Bool bad) {
    Taken t = take_request_dispatch(buf);
    if (t.bad) { return Served { .requests = n, .last_op = last_op, .shm_op = shm_op, .fd_seen = fd_seen, .bad = true }; }
    if (!t.ok) {
        List(Int) got = resid_disp_recv(fd, 65536);
        if (got.len() == 0) { return Served { .requests = n, .last_op = last_op, .shm_op = shm_op, .fd_seen = fd_seen, .bad = bad }; }
        return serve_requests(fd, t.rest.concat(got), n, last_op, shm_op, fd_seen, bad);
    }
    Int op = t.req[0];
    // MIT-SHM requests carry their minor opcode in the second byte, so an
    // attach is opcode 70 with 1 beside it — never opcode 1 on its own.
    if (op == op_shm() && t.req.len() > 1 && t.req[1] == shm_attach()) {
        // The descriptor rides beside the attach. SCM_RIGHTS delivers a
        // new descriptor number in the receiving process, so what is
        // checked is that one arrived.
        Int fd_in = resid_disp_recv_fd();
        Bool r = resid_disp_send(fd, fake_attach_reply(), -1);
        if (!r) { return Served { .requests = n, .last_op = op, .shm_op = shm_op, .fd_seen = false, .bad = true }; }
        return serve_requests(fd, t.rest, n + 1, op, shm_op, fd_in >= 0, false);
    }
    if (op == op_shm() && t.req[1] == shm_put_image()) {
        return Served { .requests = n + 1, .last_op = op_shm(), .shm_op = t.req[1], .fd_seen = fd_seen, .bad = bad };
    }
    return serve_requests(fd, t.rest, n + 1, op, shm_op, fd_seen, bad);
}

/// Run one session: the client in a region, the server here.
@requires(display)
Served fake_session() {
    List(Int) pair = resid_disp_pair();
    if (pair.len() != 2) { return Served { .requests = 0, .last_op = -1, .shm_op = -1, .fd_seen = false, .bad = true }; }
    Int sfd = pair[0];
    Int cfd = pair[1];
    Result(Int, RegionError) r = spawn (display) {
        return client_session(cfd);
    };
    Served seen = serve(sfd, []);
    Int client_rc = r else { -1 };
    if (client_rc != 0) { return with_bad(seen, true); }
    return seen;
}

/// `Served` with `bad` set, for a client that failed.
Served with_bad(Served s, Bool b) {
    return Served { .requests = s.requests, .last_op = s.last_op, .shm_op = s.shm_op, .fd_seen = s.fd_seen, .bad = b };
}

@requires(display)
test "a client completes the handshake and presents a frame" {
    Served seen = fake_session();
    expect(seen.bad).toEqual(false);
    expect(seen.requests).toEqual(6);
    expect(seen.last_op).toEqual(op_shm());
    expect(seen.shm_op).toEqual(shm_put_image());
    expect(seen.fd_seen).toEqual(true);
}