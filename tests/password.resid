// password.resid — a PasswordInput's text goes nowhere but the program
// (R4-2).
//
// A login form is typed into through the widgets, as the loop does it,
// and the program keeps what `PasswordEdited` gives it. Then every way
// the library has to tell anyone about the window is asked for the text:
// the semantics tree, AT-SPI (GetText, the value and its change
// signals, on the wire), the RSP shell's tree (on a socket), the display
// list, and the timeline's log of the events `update` saw. None holds
// it; the screen reader is given one bullet per character; the program
// has the text, and reads it with `declassify`.

import "../src/gui.resid";
import "../src/dev/timeline.resid";

Str pw() { return "hunter2"; }

Widget login(Secret(Str) s, Int k) {
    // Column 0, Text 1, PasswordInput 2, Button 3
    return Column([Text("Login"), PasswordInput(s, k, Custom(1)), Button("Go", Custom(2))]);
}

/// The program's side: the text and caret `PasswordEdited` gave it.
type Model = { Secret(Str) text; Int caret; };

Model take(Model m, List(Event) es, Int i) {
    if (i >= es.len()) { return m; }
    Model n = match (es[i]) { PasswordEdited(x, s, k) => Model { .text = s, .caret = k }, _ => m };
    return take(n, es, i + 1);
}

/// A session after the typing: the model, the UI state and every event
/// `update` would have seen.
type Typed = { Model m; UiState ui; List(Event) seen; };

Typed type_text(Typed t, Str s, Int i, Rect r) {
    if (i >= str_len(s)) { return t; }
    UiStep u = ui_event(t.ui, login(t.m.text, t.m.caret), r, KeyDown(30, str_slice(s, i, i + 1)));
    UiStep up = ui_event(u.ui, login(take(t.m, u.out, 0).text, take(t.m, u.out, 0).caret), r, KeyUp(30));
    return type_text(Typed { .m = take(t.m, u.out, 0), .ui = up.ui, .seen = t.seen.concat(u.out).concat(up.out) }, s, i + 1, r);
}

Typed session(Rect r) {
    Model m0 = Model { .text = password_empty(), .caret = 0 };
    UiStep f = ui_event(ui_new(), login(m0.text, 0), r, Assist(2, act_focus()));
    return type_text(Typed { .m = m0, .ui = f.ui, .seen = f.out }, pw(), 0, r);
}

Bool has_bytes(List(Int) hay, List(Int) needle, Int i) {
    if (i + needle.len() > hay.len()) { return false; }
    return same_at(hay, needle, i, 0) || has_bytes(hay, needle, i + 1);
}

Bool same_at(List(Int) hay, List(Int) needle, Int i, Int j) {
    if (j >= needle.len()) { return true; }
    return hay[i + j] == needle[j] && same_at(hay, needle, i, j + 1);
}

List(Int) utf8_of(Str s) { return utf8_bytes(s); }

List(Int) all_bytes(List(DMsg) ms, Int i, List(Int) acc) {
    if (i >= ms.len()) { return acc; }
    return all_bytes(ms, i + 1, acc.concat(dmsg_bytes(ms[i])));
}

Bool texts_hold(List(DrawOp) ops, Str s, Int i) {
    if (i >= ops.len()) { return false; }
    Bool here = match (ops[i]) { OpText(x, y, t, c) => str_contains(t, s), _ => false };
    return here || texts_hold(ops, s, i + 1);
}

Rect area() { return Rect { .x = 0, .y = 0, .w = 100 * str_len(rt "xx"), .h = 120 }; }

@requires(declassify)
test "the program receives the password, and only through declassify" {
    Typed t = session(area());
    expect(t.m.caret).toEqual(7);
    expect(t.m.text.len()).toEqual(7);
    expect(declassify(t.m.text, "the test checks what the program received")).toEqual(pw());
    // Backspace and a selection replace work on the secret too
    UiStep b = ui_event(t.ui, login(t.m.text, t.m.caret), area(), KeyDown(key_backspace(), ""));
    Model m2 = take(t.m, b.out, 0);
    expect(declassify(m2.text, "the test checks the edit")).toEqual("hunter");
    UiStep all = ui_event(b.ui, login(m2.text, m2.caret), area(), KeyDown(key_a(), ""));
    UiStep ctrl = ui_event(ui_with_mods(b.ui, false, true), login(m2.text, m2.caret), area(), KeyDown(key_a(), ""));
    Model m3 = take(m2, ctrl.out, 0);
    UiStep typed = ui_event(ui_with_mods(ctrl.ui, false, false), login(m3.text, m3.caret), area(), KeyDown(31, "s"));
    expect(declassify(take(m3, typed.out, 0).text, "the test checks the edit")).toEqual("s");
    // a key that types nothing and is not on the allow-list is not passed
    // on either: a shell sends every key's code that way (R6-1)
    expect(all.out.len()).toEqual(0);
}

test "the keys that typed a password, and their text, are not passed on" {
    Typed t = session(area());
    Str log = log_text(t.seen);
    expect(str_contains(log, "hunter")).toEqual(false);
    expect(str_contains(log, "\"h\"")).toEqual(false);
    expect(str_contains(log, "KeyDown")).toEqual(false);
    expect(str_contains(log, "KeyUp")).toEqual(false);
    expect(str_contains(log, "PasswordEdited(Custom(1))")).toEqual(true);
    // a replayed log gives the program an empty password, not the text
    Event back = event_parse("PasswordEdited(Custom(1))") else { FrameTick };
    Int n = match (back) { PasswordEdited(m, s, k) => s.len(), _ => -1 };
    expect(n).toEqual(0);
    // keys elsewhere are passed on as before
    UiStep away = ui_event(ui_new(), login(t.m.text, t.m.caret), area(), KeyDown(30, "a"));
    expect(str_contains(log_text(away.out), "KeyDown(30, \"a\")")).toEqual(true);
}

test "a screen reader is told one bullet per character, as a password field" {
    Typed t = session(area());
    List(SemNode) sem = semantics(login(t.m.text, t.m.caret), area(), t.ui);
    Str said = sem_speech(sem);
    expect(str_contains(said, "hunter")).toEqual(false);
    expect(str_contains(said, "password field = •••••••, focused")).toEqual(true);
    expect(sem[1].role).toEqual(role_password());
    expect(str_len(sem[1].value)).toEqual(7);
    // AT-SPI: PASSWORD_TEXT, and GetText gives the bullets
    A11y a = A11y { .fd = -1, .alive = true, .err = "", .buf = [], .serial = 10, .name = ":1.7", .title = "Login", .tree = sem, .skip = 0 };
    expect(atspi_role(a, 2)).toEqual(40);
    DMsg get = dcall(99, ":1.7", path_in(a, 2), "org.a11y.atspi.Text", "GetText", [DI32(0), DI32(-1)]);
    Served s = serve(a, DMsg { .kind = get.kind, .flags = 0, .serial = 99, .reply_serial = 0, .path = get.path, .iface = get.iface,
                               .member = get.member, .error = "", .dest = ":1.7", .sender = ":1.42", .body = get.body });
    List(Int) reply = all_bytes(s.out, 0, []);
    expect(has_bytes(reply, utf8_of("•••••••"), 0)).toEqual(true);
    expect(has_bytes(reply, utf8_of("hunter"), 0)).toEqual(false);
    // the value's change signals, from empty to typed, carry bullets only
    A11y empty = A11y { .fd = -1, .alive = true, .err = "", .buf = [], .serial = 10, .name = ":1.7", .title = "Login",
                        .tree = semantics(login(password_empty(), 0), area(), t.ui), .skip = 0 };
    Served ch = changed(empty, sem);
    List(Int) sig = all_bytes(ch.out, 0, []);
    expect(ch.out.len() >= 1).toEqual(true);
    expect(has_bytes(sig, utf8_of("•••••••"), 0)).toEqual(true);
    expect(has_bytes(sig, utf8_of("hunter"), 0)).toEqual(false);
}

test "the display list draws bullets" {
    Typed t = session(area());
    List(DrawOp) ops = paint(login(t.m.text, t.m.caret), area(), t.ui);
    expect(texts_hold(ops, "•••••••", 0)).toEqual(true);
    expect(texts_hold(ops, "hunter", 0)).toEqual(false);
}

@requires(display)
test "the RSP shell is sent bullets, never the text" {
    Typed t = session(area());
    List(Int) pair = resid_disp_pair();
    Rsp f = rsp_failed("");
    Rsp r0 = Rsp { .fd = pair[1], .alive = true, .err = "", .buf = [], .win = f.win, .bufs = f.bufs, .frame_ok = true, .sem = [], .sent = 0 };
    Rsp r1 = rsp_semantics(r0, semantics(login(t.m.text, t.m.caret), area(), t.ui));
    expect(r1.alive).toEqual(true);
    List(Int) got = resid_disp_recv(pair[0], 65536);
    expect(has_bytes(got, utf8_of("•••••••"), 0)).toEqual(true);
    expect(has_bytes(got, utf8_of("hunter"), 0)).toEqual(false);
    _ = resid_disp_close(pair[0]);
    _ = resid_disp_close(pair[1]);
}
