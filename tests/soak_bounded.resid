// soak_bounded.resid — a short soak of the whole loop, held to fixed
// memory bounds (bench/soak_counter.resid is the long one, which prints).
//
// The counter runs as a real program over the Wayland backend against
// bench/soak_lib.resid's compositor: 120000 events, batches of pointer
// moves and a click, some 6000 frames. The resident set is read at 10k,
// 20k, 40k, 80k events and at the end. With this Resid compiler it sits
// at about 13.4 MB from the first checkpoint on (17.3 MB with the one
// bench/soak_counter.resid was first measured with).
//
// The bounds: the client exits 0 having drawn at least one frame per 100
// events; the resident set read while the client still runs grows by
// less than 1 MB from the 10k-event checkpoint (after warm-up) to the 80k
// one, and by less than 512 kB from 40k to 80k: a leak per turn grows
// at least as much over the second span (40k events) as over the first
// (30k), while warm-up growth is done by 10k (R4-8). A leak of 300 bytes
// a turn (about 1.2 MB from 10k to 80k events here) fails both. The
// peak stays under 64 MB. The reading after the client has exited is
// printed, not judged: its memory is gone by then. tests/run.sh runs it
// with no accessibility bus.

import "../bench/soak_lib.resid";

@requires(display, accessibility, clock(readonly), filesystem(readonly), declassify)
Int main() {
    Int total = 120000;
    Soaked s = soak(total);
    Int peak = status_kb("VmHWM:");
    // marks: 10k, 20k, 40k, 80k events (the client running), then the end
    Bool have = s.marks.len() >= 5;
    Int m10 = if (have) { s.marks[0] } else { -1 };
    Int m40 = if (have) { s.marks[2] } else { -1 };
    Int m80 = if (have) { s.marks[3] } else { -1 };
    Int end = if (have) { s.marks[s.marks.len() - 1] } else { -1 };
    println(f"soak_bounded: {s.events} events, {s.frames} frames; rss {m10} kB at 10k, {m40} kB at 40k, {m80} kB at 80k, {end} kB at the end, peak {peak} kB");
    Bool ok = s.code == 0 && s.events >= total && s.frames >= total / 100 && have
              && m10 > 0 && m80 - m10 < 1024 && m80 - m40 < 512 && peak > 0 && peak < 65536;
    if (!ok) { println("soak_bounded: FAILED"); }
    return if (ok) { 0 } else { 1 };
}
